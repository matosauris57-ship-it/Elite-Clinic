{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },

  "constr": "Server=(localdb)\\mssqllocaldb;Database=ClinicSystem;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True",

  "Redis": {
    "ConnectionString": "",
    "TTLInMinutes": 60
  },

  "AllowedHosts": "*",

  "JWT": {
    "SecritKey": "dev-local-secret-key-minimum-32-characters-long-for-jwt",
    "AudienceIP": "https://localhost:7179",
    "IssuerIP": "https://localhost:7179",
    "TokenExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 30
  },

  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    //"FromEmail": "your-email@gmail.com",
    //"Password": "your-app-password",
    "SenderName": "Elite Clinic"
  },

  "ClinicSettings": {
    "DayStartTime": "12:00:00",
    "DayEndTime": "22:00:00",
    "SlotDurationInMinutes": 15
  },

  "GoogleAuthSettings": {
    "ClientId": "553294958514-rcfh4ggk7ghd5flopgjs0c56u47v5b5u.apps.googleusercontent.com"
  }

  //"RabbitMQ": {
  //  "Url": "amqps://USERNAME:PASSWORD@HOST/VHOST"
  //}
}
