<header class="topbar">
    <div class="topbar-left">
        <button type="button"
                class="icon-btn topbar-menu-btn"
                aria-label="Abrir menú"
                aria-expanded="false"
                onclick="window.dentalCareNav.toggle()">
            <Icon Name="menu" Class="icon-svg topbar-menu-icon-open" />
            <Icon Name="x" Class="icon-svg topbar-menu-icon-close" />
        </button>
    </div>
    <div class="topbar-right">
        <ThemeToggle />
    </div>
</header>
