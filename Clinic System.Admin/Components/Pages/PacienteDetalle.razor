    private async Task CreateTreatmentAsync()
    {
        var procedure = SelectedTreatmentProcedure;
        if (procedure == null)
        {
            ShowNotice(error: "Seleccione un procedimiento activo.");
            return;
        }

        var teeth = _selectedTeeth.Distinct().Where(FdiToothNumber.IsValid).ToList();
        if (procedure.Target != ProcedureTarget.WholeMouth)
        {
            var previewTooth = teeth.ElementAtOrDefault(0);
            int? previewNumber = teeth.Count > 0 ? previewTooth : null;
            Clinic_System.Core.Enums.ToothSurface? previewSurface = procedure.Target == ProcedureTarget.PerSurface
                ? ToCoreSurface(_selectedSurface)
                : (teeth.Count > 0 ? ToCoreSurface(_selectedSurface) : null);
            var scopeError = TreatmentProcedureRules.ValidateAssignment(
                procedure.Target,
                procedure.ToothKindFilter,
                previewNumber,
                previewSurface);
            if (scopeError != null)
            {
                ShowNotice(error: scopeError);
                return;
            }

            foreach (var tooth in teeth)
            {
                var kindError = TreatmentProcedureRules.ValidateKind(procedure.ToothKindFilter, tooth);
                if (kindError != null)
                {
                    ShowNotice(error: $"Pieza {tooth}: {kindError}");
                    return;
                }
            }
        }

        _savingTreatment = true;
        ClearNotice();
        var result = await TreatmentService.CreateTreatmentAsync(new CreateDentalTreatmentRequest
        {
            PatientId = PatientId,
            ProcedureName = procedure.Name,
            TreatmentProcedureId = procedure.Id,
            Cost = _treatmentCost,
            ToothNumber = procedure.Target == ProcedureTarget.WholeMouth ? null : teeth.ElementAtOrDefault(0),
            ToothNumbers = procedure.Target == ProcedureTarget.WholeMouth ? [] : teeth,
            ToothSurface = procedure.Target == ProcedureTarget.WholeMouth
                ? null
                : (teeth.Count > 0 ? _selectedSurface : null),
            ProcedureDetails = _treatmentDetails,
            MedicalNotes = _treatmentMedicalNotes
        });
        _savingTreatment = false;
        if (!result.Success)
        {
            ShowNotice(error: result.Error);
            return;
        }

        ShowNotice(success: procedure.Target == ProcedureTarget.WholeMouth || teeth.Count <= 1
            ? "Tratamiento registrado."
            : $"Tratamiento registrado en {teeth.Count} piezas.");
        _treatmentProcedureId = 0;
        _treatmentCost = 0;
        _treatmentDetails = null;
        _treatmentMedicalNotes = null;
        await RefreshClinicalDataAsync(includeChart: false);
    }

