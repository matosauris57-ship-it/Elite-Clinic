    private async Task VoidToothEntryAsync(DentalClinicalEvent item)
    {
        if (!_canEditOdontogram)
            return;

        var entryId = item.ToothChartEntryId
            ?? (long.TryParse(item.ReferenceId, out var parsed) ? parsed : (long?)null);
        if (entryId is null or <= 0)
        {
            ShowNotice(error: "Este evento no se puede anular porque no está vinculado a un hallazgo del odontograma.");
            return;
        }

        if (_editingEntryId == entryId)
            CancelEditToothEntry();

        ClearNotice();
        var result = await AuthService.WithTokenRetryAsync(
            () => ToothChartService.VoidEntryAsync(entryId.Value),
            AuthService.IsTokenError);
        if (!result.Data || result.Error != null)
        {
            ShowNotice(error: result.Error ?? "No se pudo anular el hallazgo.");
            return;
        }

        ShowNotice(success: "Registro del odontograma anulado.");
        await LoadToothChartAsync();
        await LoadFullTimelineAsync();
    }

