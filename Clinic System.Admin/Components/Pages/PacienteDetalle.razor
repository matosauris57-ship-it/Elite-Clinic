    private async Task CancelTreatmentAsync(int id)
    {
        _savingTreatment = true;
        var result = await TreatmentService.CancelTreatmentAsync(id, _treatmentCancellationReason);
        _savingTreatment = false;
        _treatmentCancellationReason = null;
