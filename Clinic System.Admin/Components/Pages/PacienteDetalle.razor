    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        var isDoctor = user.IsInRole("Doctor");
        _canEditPatient = PermissionService.HasPermission(user, "pacientes.edit");
        _canViewOdontogram = PermissionService.HasPermission(user, "odontograma.view") || isDoctor || _canEditPatient;
        _canEditOdontogram = PermissionService.HasPermission(user, "odontograma.edit") || isDoctor || _canEditPatient;
        _canEditPeriodontogram = PermissionService.HasPermission(user, "periodontograma.edit") || _canEditOdontogram;
        _canCreateTreatments = PermissionService.HasPermission(user, "tratamientos.create") || isDoctor;
        _canEditTreatments = PermissionService.HasPermission(user, "tratamientos.edit") || isDoctor;
        _canViewRecetas = PermissionService.HasPermission(user, "recetas.view")
            || PermissionService.HasPermission(user, "historial.view")
            || isDoctor;
        _canEditRecetas = PermissionService.HasPermission(user, "recetas.create")
            || PermissionService.HasPermission(user, "recetas.edit")
            || PermissionService.HasPermission(user, "historial.create")
            || PermissionService.HasPermission(user, "historial.edit")
            || isDoctor;
        _canViewCertificados = PermissionService.HasPermission(user, "certificados.view")
            || PermissionService.HasPermission(user, "historial.view")
            || isDoctor;
        _canEditCertificados = PermissionService.HasPermission(user, "certificados.create")
            || PermissionService.HasPermission(user, "certificados.edit")
            || PermissionService.HasPermission(user, "historial.create")
            || PermissionService.HasPermission(user, "historial.edit")
            || isDoctor;
        _canViewConsentimientos = PermissionService.HasPermission(user, "consentimientos.view")
            || PermissionService.HasPermission(user, "pacientes.view")
            || PermissionService.HasPermission(user, "historial.view")
            || isDoctor;
        _canEditConsentimientos = PermissionService.HasPermission(user, "consentimientos.create")
            || PermissionService.HasPermission(user, "consentimientos.edit")
            || PermissionService.HasPermission(user, "pacientes.edit")
            || PermissionService.HasPermission(user, "historial.create")
            || PermissionService.HasPermission(user, "historial.edit")
            || isDoctor;
        _canViewFacturas = PermissionService.HasPermission(user, "facturacion.view");
        _canViewPlans = PermissionService.HasPermission(user, "planes-tratamiento.view")
            || PermissionService.HasPermission(user, "planes-tratamiento.create")
            || isDoctor;
        _canEditAttachments = _canEditPatient
            || PermissionService.HasPermission(user, "historial.create")
            || PermissionService.HasPermission(user, "historial.edit")
            || isDoctor;

        if (_tab == "odontograma" && !_canViewOdontogram)
            _tab = "datos";
        if (_tab == "facturas" && !_canViewFacturas)
            _tab = "datos";
        if (_tab == "certificados" && !_canViewCertificados)
            _tab = "datos";
        if (_tab == "consentimientos" && !_canViewConsentimientos)
            _tab = "datos";
        if (_tab == "planes" && !_canViewPlans)
            _tab = "datos";

        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(QueryTab))
        {
            ApplyCareQuery();
            return;
        }

        var tab = QueryTab.ToLowerInvariant();
        if (tab == "tratamientos")
            tab = _canViewPlans ? "planes" : "datos";
        if (!Tabs.Any(x => x.Key == tab))
        {
            ApplyCareQuery();
            return;
        }

        if (tab == "odontograma" && !_canViewOdontogram)
            return;
        if (tab == "recetas" && !_canViewRecetas)
            return;
        if (tab == "certificados" && !_canViewCertificados)
            return;
        if (tab == "consentimientos" && !_canViewConsentimientos)
            return;
        if (tab == "facturas" && !_canViewFacturas)
            return;
        if (tab == "planes" && !_canViewPlans)
            return;
        _tab = tab;
        ApplyCareQuery();
    }

    private void ApplyCareQuery()
    {
        if (QueryAppointmentId is > 0)
        {
            _careAppointmentId = QueryAppointmentId;
            _careMotive = QueryMotive;
        }
    }

    private void OpenCompleteVisitModal()
    {
        if (_careAppointmentId is not > 0)
            return;

        var motive = string.IsNullOrWhiteSpace(_careMotive) ? "Consulta" : _careMotive.Trim();
        _completeVisitForm = new CompleteAppointmentRequest
        {
            AppointmentId = _careAppointmentId.Value,
            Diagnosis = motive,
            Description = $"Consulta de {motive} completada en odontograma."
        };
        _completeVisitError = null;
        _showCompleteVisitModal = true;
    }

    private void CloseCompleteVisitModal()
    {
        _showCompleteVisitModal = false;
        _completeVisitError = null;
    }

    private async Task CompleteVisitAndBillAsync()
    {
        if (_careAppointmentId is not > 0)
            return;

        if (string.IsNullOrWhiteSpace(_completeVisitForm.Diagnosis) || string.IsNullOrWhiteSpace(_completeVisitForm.Description))
        {
            _completeVisitError = "Diagnóstico y descripción son obligatorios.";
            return;
        }

        _saving = true;
        _completeVisitError = null;
        _completeVisitForm.AppointmentId = _careAppointmentId.Value;
        var (success, error, paymentId) = await AgendaService.CompleteAsync(_completeVisitForm);
        _saving = false;
        if (!success)
        {
            _completeVisitError = error;
            return;
        }

        CloseCompleteVisitModal();
        if (paymentId > 0 && _canViewFacturas)
        {
            Navigation.NavigateTo($"/facturacion?pago={paymentId}&paciente={PatientId}");
            return;
        }

        if (paymentId > 0)
            ShowNotice(success: "Cita completada y factura creada. Un usuario con acceso a facturación puede cobrarla.");
        else if (_canViewFacturas)
            Navigation.NavigateTo(BillingHref);
        else
            ShowNotice(success: "Cita completada. Pida a recepción que abra la factura para cobrar.");
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        var (profile, error) = await PatientService.GetClinicalProfileAsync(PatientId);
        if (error != null)
        {
            _loadError = error;
            _loading = false;
            return;
        }

        _profile = profile;
        _history = profile?.DentalHistory ?? new DentalHistoryForm { PatientId = PatientId };

        var (conditions, _) = await ConditionService.GetConditionsAsync(activeOnly: true);
        _conditions = conditions;
        var (procedures, _) = await ProcedureService.GetActiveProceduresAsync();
        _activeProcedures = procedures;

        if (_canViewOdontogram)
        {
            await LoadToothChartAsync();
            await LoadFullTimelineAsync();
        }

        _pendingInvoiceCount = 0;
        _pendingBalance = 0;

        var extraLoads = new List<Task> { LoadTreatmentsAsync() };
        if (_canViewFacturas)
            extraLoads.Add(LoadOutstandingDebtAsync());
        await Task.WhenAll(extraLoads);
        _loading = false;
    }

    private async Task OpenFacturasTabAsync() => await SetTab("facturas");

    private async Task LoadOutstandingDebtAsync()
    {
        var result = await AuthService.WithTokenRetryAsync(
            async () =>
            {
                var response = await BillingService.GetPaymentsAsync(new BillingPaymentFilters
                {
                    PatientId = PatientId,
                    PageNumber = 1,
                    PageSize = 100
                });
                return (response.Page, response.Error);
            },
            AuthService.IsTokenError);

        var invoices = result.Data?.Items ?? [];
        var outstanding = invoices.Where(IsOutstandingInvoice).ToList();
        _pendingInvoiceCount = outstanding.Count;
        _pendingBalance = outstanding.Sum(x => x.Balance);
    }

    private static bool IsOutstandingInvoice(PaymentListItem invoice) =>
        invoice.PaymentStatus is "Pending" or "PartiallyPaid" or "Failed";

