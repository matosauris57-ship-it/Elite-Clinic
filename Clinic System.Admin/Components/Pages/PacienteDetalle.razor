    private void AddPlanItem()
    {
        var procedure = _activeProcedures.FirstOrDefault(x => x.Id == _planProcedureId);
        if (procedure == null)
        {
            ShowNotice(error: "Seleccione un procedimiento activo.");
            return;
        }

        if (_planItemPrice < 0)
        {
            ShowNotice(error: "Indique el precio unitario del procedimiento.");
            return;
        }

        _planForm.Items.Add(new CreateTreatmentPlanItemRequest
        {
            ProcedureName = procedure.Name,
            TreatmentProcedureId = procedure.Id,
            ToothNumber = _selectedTooth,
            ToothSurface = _selectedTooth.HasValue ? _selectedSurface : null,
            Quantity = Math.Max(1, _planItemQuantity),
            UnitPrice = _planItemPrice,
            Notes = _planItemNotes
        });
        _planProcedureId = 0;
        _planItemQuantity = 1;
        _planItemPrice = 0;
        _planItemNotes = null;
        ClearNotice();
    }

    private void RemovePlanItem(CreateTreatmentPlanItemRequest item) => _planForm.Items.Remove(item);

    private async Task CreatePlanAsync()
    {
        _savingPlan = true;
        ClearNotice();
        _planForm.PatientId = PatientId;
        var result = await PlanService.CreateAsync(_planForm);
        _savingPlan = false;
        if (!result.Success)
        {
            ShowNotice(error: result.Error);
            return;
        }

        ShowNotice(success: "Plan de tratamiento creado.");
        _planForm = new CreateTreatmentPlanRequest { PatientId = PatientId };
        await RefreshClinicalDataAsync(includeChart: false);
