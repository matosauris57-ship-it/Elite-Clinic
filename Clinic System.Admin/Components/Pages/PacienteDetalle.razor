        await Task.WhenAll(LoadPlansAsync(), LoadTreatmentsAsync(), LoadFullTimelineAsync());
        if (_selectedTooth.HasValue)
            await SelectToothAsync(_selectedTooth.Value);
        if (includeChart)
            await LoadToothChartAsync();
