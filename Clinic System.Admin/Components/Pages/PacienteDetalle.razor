    private async Task OpenCompleteTreatment(DentalTreatmentListItem treatment)
    {
        _treatmentToComplete = treatment;
        _completionResult = new DentalTreatmentClinicalResultRequest
        {
            Surface = treatment.ToothSurface ?? _selectedSurface,
            Condition = ToothCondition.Healthy
        };
        _consumeLines = [];
        _consumeLoading = true;
        var (proposal, _) = await InventoryService.ProposeConsumptionAsync(treatment.Id);
        _consumeLines = proposal?.AlreadyConsumed == true ? [] : (proposal?.Lines ?? []);
        _consumeLoading = false;
    }

    private void CloseCompleteTreatment()
    {
        _treatmentToComplete = null;
        _consumeLines = [];
    }

    private async Task CompleteTreatmentAsync()
    {
        if (_treatmentToComplete == null)
            return;

        _savingTreatment = true;
        var request = new CompleteDentalTreatmentRequest
        {
            ClinicalResult = _completionResult,
            SkipMaterialConsumption = _consumeLines.Count == 0,
            MaterialConsumption = _consumeLines.Count == 0
                ? null
                : _consumeLines.Select(l => new MaterialConsumptionLineRequest
                {
                    InventoryItemId = l.InventoryItemId,
                    Quantity = l.ActualQuantity,
                    IsIncluded = l.IsIncluded,
                    ProposedQuantity = l.ProposedQuantity
                }).ToList()
        };
        var result = await TreatmentService.CompleteTreatmentAsync(_treatmentToComplete.Id, request);
        _savingTreatment = false;
        if (result.Success)
        {
            _treatmentToComplete = null;
            _consumeLines = [];
        }
        await FinishTreatmentOperationAsync(result, "Tratamiento completado.", true);
    }

    private async Task FinishTreatmentOperationAsync(
        (bool Success, string? Error) result, string message, bool includeChart)
    {
        if (!result.Success)
        {
            ShowNotice(error: result.Error);
            return;
        }

        ShowNotice(success: message);
        await RefreshClinicalDataAsync(includeChart);
    }

