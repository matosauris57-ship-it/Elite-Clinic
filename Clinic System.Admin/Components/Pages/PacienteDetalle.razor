@page "/pacientes/{PatientId:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "pacientes.view")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Clinic_System.Core.Validation
@using Clinic_System.Core.Finance
@using ProcedureTarget = Clinic_System.Core.Enums.TreatmentProcedureTarget
@using ProcedureToothFilter = Clinic_System.Core.Enums.TreatmentToothKindFilter
@using System.Globalization
@inject PatientMaintenanceService PatientService
@inject MedicalConditionMaintenanceService ConditionService
@inject ToothChartService ToothChartService
@inject ClinicalTreatmentMaintenanceService TreatmentService
@inject InventoryMaintenanceService InventoryService
@inject TreatmentPlanMaintenanceService PlanService
@inject TreatmentProcedureMaintenanceService ProcedureService
@inject AuthService AuthService
@inject PermissionService PermissionService
@inject BillingMaintenanceService BillingService
@inject AgendaMaintenanceService AgendaService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(_profile?.FullName ?? "Paciente") — DentalCare Admin</PageTitle>

@if (_loading)
{
    <AnimatedLoader Message="Cargando ficha..." />
}
else if (!string.IsNullOrEmpty(_loadError))
{
    <div class="wizard-error">@_loadError</div>
}
else if (_profile != null)
{
    <div class="maintenance-page patient-detail-page">
        <header class="patient-record-hero">
            <a href="/pacientes" class="patient-record-back">
                <Icon Name="chevron-left" Class="patient-record-back-icon" StrokeWidth="2" />
                Pacientes
            </a>
            <div class="patient-record-identity">
                <div class="patient-identity-avatar avatar-@(_profile.Id % 4)" aria-hidden="true">@GetInitials(_profile.FullName)</div>
                <div class="patient-record-copy">
                    <h1>@_profile.FullName</h1>
                    <div class="patient-record-meta">
                        <span class="patient-chip">P-@_profile.Id.ToString("D4")</span>
                        <span class="status-badge @(_profile.IsActive ? "status-active" : "status-inactive")">
                            @(_profile.IsActive ? "Activo" : "Inactivo")
                        </span>
                        @if (_canViewFacturas && HasOutstandingDebt)
                        {
                            <button type="button"
                                    class="status-badge status-debt"
                                    title="Ver facturas pendientes"
                                    @onclick="OpenFacturasTabAsync">
                                Deuda pendiente · @Money.Format(_pendingBalance)
                            </button>
                        }
                        @if (TryGetBirthDate(out var headerBirth) && GetAgeYears(headerBirth) != null)
                        {
                            <span class="patient-chip">@GetAgeYears(headerBirth) años</span>
                        }
                    </div>
                </div>
            </div>
            <nav class="patient-record-tabs" role="tablist" aria-label="Secciones de la ficha clínica">
                @foreach (var tab in Tabs)
                {
                    if (tab.Key == "odontograma" && !_canViewOdontogram)
                        continue;
                    if (tab.Key == "recetas" && !_canViewRecetas)
                        continue;
                    if (tab.Key == "certificados" && !_canViewCertificados)
                        continue;
                    if (tab.Key == "consentimientos" && !_canViewConsentimientos)
                        continue;
                    if (tab.Key == "facturas" && !_canViewFacturas)
                        continue;
                    if (tab.Key == "planes" && !_canViewPlans)
                        continue;
                    <button type="button"
                            role="tab"
                            aria-selected="@(_tab == tab.Key)"
                            class="patient-record-tab @(_tab == tab.Key ? "is-active" : "")"
                            @onclick="() => SetTab(tab.Key)">
                        <Icon Name="@tab.Icon" Class="patient-record-tab-icon" StrokeWidth="1.8" />
                        <span>@tab.Label</span>
                        @if (tab.Key == "facturas" && _canViewFacturas && _pendingInvoiceCount > 0)
                        {
                            <span class="patient-tab-badge" title="@_pendingInvoiceCount factura(s) con saldo">@_pendingInvoiceCount</span>
                        }
                    </button>
                }
            </nav>
        </header>

        <div class="app-toast-host" aria-live="polite" aria-atomic="true">
            @if (!string.IsNullOrEmpty(_saveMessage))
            {
                <div class="app-toast is-success" role="status">@_saveMessage</div>
            }
            @if (!string.IsNullOrEmpty(_saveError))
            {
                <div class="app-toast is-error" role="alert">@_saveError</div>
            }
        </div>
        <DuplicateCedulaBanner PatientId="_duplicatePatientId" />

        @if (_careAppointmentId is > 0)
        {
            <div class="wizard-success care-visit-banner">
                <p>
                    Consulta de la cita #@_careAppointmentId@(string.IsNullOrWhiteSpace(_careMotive) ? "" : $" · {_careMotive}").
                    Complete hallazgos y presupuesto aquí; al terminar la visita se crea la factura y puede cobrar.
                </p>
                <div class="care-visit-actions">
                    <a class="clinical-patient-link" href="/agenda">Volver a la agenda</a>
                    <button type="button" class="btn-primary" disabled="@_saving" @onclick="OpenCompleteVisitModal">
                        Completar ficha y cobrar
                    </button>
                </div>
            </div>
        }

        @if (_tab == "datos")
        {
            <div class="new-patient-form patient-detail-form">
                <div class="patient-identity-card">
                    <div class="patient-identity-avatar avatar-@(_profile.Id % 4)" aria-hidden="true">@GetInitials(_profile.FullName)</div>
                    <div class="patient-identity-copy">
                        <strong>@_profile.FullName</strong>
                        <div class="patient-identity-chips">
                            @if (TryGetBirthDate(out var birthDate) && GetAgeYears(birthDate) != null)
                            {
                                <span class="patient-chip">@GetAgeYears(birthDate) años</span>
                                <span class="patient-chip">Nac. @FormatBirthLong(birthDate)</span>
                                <span class="patient-chip patient-chip-birthday">@NextBirthdayLabel(birthDate)</span>
                            }
                            else
                            {
                                <span class="patient-chip">Sin fecha de nacimiento</span>
                            }
                            <span class="patient-chip">@GenderLabel(_profile.Gender)</span>
                            @if (_canViewFacturas && HasOutstandingDebt)
                            {
                                <button type="button"
                                        class="patient-chip patient-chip-debt"
                                        title="Ver facturas pendientes"
                                        @onclick="OpenFacturasTabAsync">
                                    Deuda pendiente · @Money.Format(_pendingBalance)
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label>Nombre</label><input class="form-input" maxlength="@PatientFieldLimits.FullName" value="@_profile.FullName" disabled="@(!_canEditPatient)" @oninput="OnNameInput" /></div>
                    <div class="form-group"><label>Cédula</label><input class="form-input" maxlength="@PatientFieldLimits.NationalId" value="@_profile.NationalId" disabled="@(!_canEditPatient)" @oninput="OnCedulaInput" /></div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Fecha de nacimiento</label>
                        <input class="form-input" type="date"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")"
                               value="@BirthIsoValue"
                               disabled="@(!_canEditPatient)"
                               @onchange="OnBirthDateChanged" />
                        @if (TryGetBirthDate(out var dobHint) && GetAgeYears(dobHint) != null)
                        {
                            <span class="form-hint">@GetAgeYears(dobHint) años · @dobHint.ToString("dd/MM/yyyy")</span>
                        }
                    </div>
                    <div class="form-group">
                        <label>Género</label>
                        <select class="form-input" @bind="_profile.Gender" disabled="@(!_canEditPatient)">
                            <option value="Male">Masculino</option>
                            <option value="Female">Femenino</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label>Teléfono</label><input class="form-input" maxlength="@PatientFieldLimits.Phone" inputmode="tel" value="@_profile.Phone" disabled="@(!_canEditPatient)" @oninput="OnPhoneInput" /></div>
                    <div class="form-group"><label>Correo (opcional)</label><input class="form-input" type="email" maxlength="@PatientFieldLimits.Email" value="@_profile.Email" disabled="@(!_canEditPatient)" placeholder="paciente@correo.com" @oninput="OnEmailInput" /></div>
                </div>
                <div class="form-group"><label>Dirección</label><input class="form-input" maxlength="@PatientFieldLimits.Address" value="@_profile.Address" disabled="@(!_canEditPatient)" @oninput="OnAddressInput" /></div>
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="_profile.OptOutEmailCampaigns" disabled="@(!_canEditPatient)" />
                        No enviar campañas de correo
                    </label>
                    <span class="form-hint">Los recordatorios de cita se siguen pudiendo enviar. Las campañas del módulo Campañas no incluirán a este paciente.</span>
                </div>
                @if (_canEditPatient)
                {
                    <div class="patient-detail-actions">
                        <button class="btn-primary" disabled="@_saving" @onclick="SavePersonalDataAsync">@(_saving ? "Guardando..." : "Guardar datos")</button>
                    </div>
                }

                <div class="ec-section">
                    <button type="button" class="ec-toggle" @onclick="ToggleEmergencyContacts">
                        <Icon Name="alert-triangle" Class="ec-toggle-icon" />
                        <span>Contactos de emergencia (@_emergencyContacts.Count)</span>
                        <span class="ec-chevron @(_ecExpanded ? "is-open" : "")">
                            <Icon Name="chevron-right" Class="ec-chevron-svg" StrokeWidth="2" />
                        </span>
                    </button>

                    @if (_ecExpanded)
                    {
                        @if (!string.IsNullOrEmpty(_ecError))
                        {
                            <div class="wizard-error">@_ecError</div>
                        }
                        @if (_ecLoading)
                        {
                            <AnimatedLoader Compact="true" Message="Cargando contactos..." />
                        }
                        else
                        {
                            @if (_emergencyContacts.Count > 0)
                            {
                                <div class="ec-list">
                                    @foreach (var contact in _emergencyContacts)
                                    {
                                        <div class="ec-card">
                                            <div class="ec-card-main">
                                                <strong>@contact.FullName</strong>
                                                <span class="ec-badge">@contact.Relationship</span>
                                            </div>
                                            <div class="ec-card-detail">
                                                <span>@contact.Phone</span>
                                                @if (!string.IsNullOrWhiteSpace(contact.Notes))
                                                {
                                                    <span class="ec-notes">@contact.Notes</span>
                                                }
                                            </div>
                                            @if (_canEditPatient)
                                            {
                                                <div class="ec-card-actions">
                                                    <button class="btn-outline btn-sm" @onclick="() => EditEmergencyContact(contact)">Editar</button>
                                                    <button class="btn-outline btn-sm btn-table-danger" disabled="@_ecSaving" @onclick="() => DeleteEmergencyContactAsync(contact)">Eliminar</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="ec-empty">No hay contactos de emergencia registrados.</p>
                            }

                            @if (_canEditPatient)
                            {
                                @if (_ecFormVisible)
                                {
                                    <div class="ec-form">
                                        <div class="form-row">
                                            <div class="form-group">
                                                <label>Nombre completo <span class="np-req">*</span></label>
                                                <input class="form-input" maxlength="@PatientFieldLimits.FullName" value="@_ecForm.FullName" placeholder="Nombre del contacto" @oninput="OnEmergencyNameInput" />
                                            </div>
                                            <div class="form-group">
                                                <label>Parentesco <span class="np-req">*</span></label>
                                                <select class="form-input" @bind="_ecForm.Relationship">
                                                    <option value="">Seleccionar...</option>
                                                    <option value="Padre">Padre</option>
                                                    <option value="Madre">Madre</option>
                                                    <option value="Cónyuge">Cónyuge</option>
                                                    <option value="Hijo/a">Hijo/a</option>
                                                    <option value="Hermano/a">Hermano/a</option>
                                                    <option value="Abuelo/a">Abuelo/a</option>
                                                    <option value="Tío/a">Tío/a</option>
                                                    <option value="Amigo/a">Amigo/a</option>
                                                    <option value="Tutor legal">Tutor legal</option>
                                                    <option value="Otro">Otro</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-row">
                                            <div class="form-group">
                                                <label>Teléfono <span class="np-req">*</span></label>
                                                <input class="form-input" maxlength="@PatientFieldLimits.Phone" value="@_ecForm.Phone" placeholder="809 555 1234" inputmode="tel" @oninput="OnEmergencyPhoneInput" />
                                            </div>
                                            <div class="form-group">
                                                <label>Notas (opcional)</label>
                                                <input class="form-input" @bind="_ecForm.Notes" placeholder="Horario de contacto, etc." />
                                            </div>
                                        </div>
                                        <div class="ec-form-actions">
                                            <button class="btn-primary btn-sm" disabled="@_ecSaving" @onclick="SaveEmergencyContactAsync">
                                                @(_ecSaving ? "Guardando..." : (_ecEditingId.HasValue ? "Actualizar" : "Agregar"))
                                            </button>
                                            <button class="btn-outline btn-sm" @onclick="CancelEmergencyContactForm">Cancelar</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <button class="btn-outline btn-sm ec-add-btn" @onclick="ShowEmergencyContactForm">
                                        <Icon Name="plus" Class="btn-svg" /> Agregar contacto
                                    </button>
                                }
                            }
                        }
                    }
                </div>
            </div>
        }
        else if (_tab == "antecedentes" && _history != null)
        {
            <div class="history-form patient-detail-form">
                <section class="history-card">
                    <header class="history-card-head">
                        <span class="history-card-icon" aria-hidden="true"><Icon Name="activity" Class="history-card-svg" /></span>
                        <div>
                            <h3>Evaluación inicial</h3>
                            <p>Signos vitales, alergias y medicación vigente.</p>
                        </div>
                    </header>
                    <div class="history-vital-grid">
                        <div class="form-group">
                            <label>Presión sanguínea</label>
                            <input class="form-input" @bind="_history.BloodPressure" disabled="@(!_canEditPatient)" placeholder="120/80" />
                        </div>
                        <div class="form-group @(string.IsNullOrWhiteSpace(_history.Allergies) ? "" : "is-alert")">
                            <label>Alergias</label>
                            <input class="form-input" @bind="_history.Allergies" disabled="@(!_canEditPatient)" placeholder="Medicamentos, látex, alimentos…" />
                        </div>
                        <div class="form-group history-vital-span">
                            <label>Medicación actual</label>
                            <input class="form-input" @bind="_history.CurrentMedication" disabled="@(!_canEditPatient)" placeholder="Fármacos y dosis" />
                        </div>
                    </div>
                </section>

                <section class="history-card">
                    <header class="history-card-head">
                        <span class="history-card-icon" aria-hidden="true"><Icon Name="clipboard-list" Class="history-card-svg" /></span>
                        <div>
                            <h3>Enfermedades</h3>
                            <p>
                                @if (_conditions.Count == 0)
                                {
                                    <text>No hay condiciones en el catálogo.</text>
                                }
                                else if (_history.SelectedConditionIds.Count == 0)
                                {
                                    <text>Seleccione las condiciones que apliquen.</text>
                                }
                                else
                                {
                                    <text>@_history.SelectedConditionIds.Count seleccionada(s) del catálogo.</text>
                                }
                            </p>
                        </div>
                    </header>
                    @if (_conditions.Count == 0)
                    {
                        <p class="history-empty">Configure enfermedades en el catálogo para marcarlas aquí.</p>
                    }
                    else
                    {
                        <div class="history-chip-grid" role="group" aria-label="Enfermedades del catálogo">
                            @foreach (var condition in _conditions)
                            {
                                var selected = _history.SelectedConditionIds.Contains(condition.Id);
                                <label class="history-chip @(selected ? "is-on" : "")">
                                    <input type="checkbox"
                                           checked="@selected"
                                           disabled="@(!_canEditPatient)"
                                           @onchange="e => ToggleCondition(condition.Id, (bool)(e.Value ?? false))" />
                                    <span class="history-chip-mark" aria-hidden="true"><Icon Name="check" Class="history-chip-check" /></span>
                                    <span>@condition.Name</span>
                                </label>
                            }
                        </div>
                    }
                    <div class="history-notes-grid history-notes-compact">
                        <div class="form-group">
                            <label>Otras enfermedades</label>
                            <textarea class="form-input" rows="3" @bind="_history.OtherDiseases" disabled="@(!_canEditPatient)" placeholder="Condiciones que no están en el catálogo"></textarea>
                        </div>
                        <div class="form-group">
                            <label>Enfermedades sistémicas</label>
                            <textarea class="form-input" rows="3" @bind="_history.SystemicDiseases" disabled="@(!_canEditPatient)" placeholder="Hallazgos sistémicos relevantes"></textarea>
                        </div>
                    </div>
                </section>

                <section class="history-card">
                    <header class="history-card-head">
                        <span class="history-card-icon" aria-hidden="true"><Icon Name="stethoscope" Class="history-card-svg" /></span>
                        <div>
                            <h3>Historia clínica</h3>
                            <p>Motivo de consulta, diagnóstico y notas del tratamiento.</p>
                        </div>
                    </header>
                    <div class="history-notes-grid">
                        <div class="form-group">
                            <label>Motivo de consulta</label>
                            <textarea class="form-input" rows="3" @bind="_history.ReasonForConsultation" disabled="@(!_canEditPatient)" placeholder="Qué trae al paciente hoy"></textarea>
                        </div>
                        <div class="form-group">
                            <label>Diagnóstico</label>
                            <textarea class="form-input" rows="3" @bind="_history.Diagnosis" disabled="@(!_canEditPatient)"></textarea>
                        </div>
                        <div class="form-group history-notes-span">
                            <label>Tratamientos dentales previos</label>
                            <textarea class="form-input" rows="3" @bind="_history.PreviousDentalTreatments" disabled="@(!_canEditPatient)"></textarea>
                        </div>
                        <div class="form-group">
                            <label>Observaciones clínicas</label>
                            <textarea class="form-input" rows="4" @bind="_history.ClinicalObservations" disabled="@(!_canEditPatient)"></textarea>
                        </div>
                        <div class="form-group">
                            <label>Notas adicionales</label>
                            <textarea class="form-input" rows="4" @bind="_history.AdditionalNotes" disabled="@(!_canEditPatient)"></textarea>
                        </div>
                    </div>
                </section>

                <section class="history-card">
                    <header class="history-card-head">
                        <span class="history-card-icon" aria-hidden="true"><Icon Name="tooth" Class="history-card-svg" /></span>
                        <div>
                            <h3>Hábitos y signos orales</h3>
                            <p>Marque lo que esté presente en la evaluación.</p>
                        </div>
                    </header>
                    <div class="history-habit-grid" role="group" aria-label="Hábitos y signos orales">
                        <label class="history-habit @(_history.HasBleedingGums ? "is-on" : "")">
                            <input type="checkbox" @bind="_history.HasBleedingGums" disabled="@(!_canEditPatient)" />
                            <span class="history-habit-title">Sangrado de encías</span>
                            <span class="history-habit-hint">Gingival</span>
                        </label>
                        <label class="history-habit @(_history.HasSensitiveTeeth ? "is-on" : "")">
                            <input type="checkbox" @bind="_history.HasSensitiveTeeth" disabled="@(!_canEditPatient)" />
                            <span class="history-habit-title">Sensibilidad dental</span>
                            <span class="history-habit-hint">Térmica o al tacto</span>
                        </label>
                        <label class="history-habit @(_history.HasBruxism ? "is-on" : "")">
                            <input type="checkbox" @bind="_history.HasBruxism" disabled="@(!_canEditPatient)" />
                            <span class="history-habit-title">Bruxismo</span>
                            <span class="history-habit-hint">Rechinamiento</span>
                        </label>
                        <label class="history-habit @(_history.IsSmoker ? "is-on" : "")">
                            <input type="checkbox" @bind="_history.IsSmoker" disabled="@(!_canEditPatient)" />
                            <span class="history-habit-title">Fumador</span>
                            <span class="history-habit-hint">Tabaco u otros</span>
                        </label>
                    </div>
                </section>

                @if (_canEditPatient)
                {
                    <div class="history-form-actions">
                        <p class="history-form-hint">Los cambios no se publican hasta guardar.</p>
                        <button class="btn-primary" disabled="@_saving" @onclick="SaveHistoryAsync">@(_saving ? "Guardando..." : "Guardar antecedentes")</button>
                    </div>
                }
            </div>
        }
        else if (_tab == "odontograma" && _canViewOdontogram)
        {
            @if (!string.IsNullOrWhiteSpace(_chartError))
            {
                <ErrorBanner Message="@_chartError" OnRetry="LoadToothChartAsync" />
            }

            <OdontogramChart Entries="_chartEntries"
                              SelectedTooth="_selectedTooth"
                              SelectedTeeth="_selectedTeeth"
                              SelectedSurface="_selectedSurface"
                              SelectedSurfaces="_selectedSurfaces"
                              SelectedToothChanged="SelectToothAsync"
                              ToothSelectionChanged="OnToothSelection"
                              SelectedSurfaceChanged="SelectSurface"
                              PatientId="PatientId"
                              PatientName="@(_profile?.FullName ?? "Paciente")"
                              CanEditPeriodontogram="_canEditPeriodontogram"
                              ShowingPeriodontogram="_showingPeriodontogram"
                              ShowingPeriodontogramChanged="OnPeriodontogramVisible" />

            @if (_careAppointmentId is > 0 && !_showingPeriodontogram)
            {
                <div class="odontogram-complete-visit">
                    <button type="button" class="btn-primary" disabled="@_saving" @onclick="OpenCompleteVisitModal">
                        Completar ficha y cobrar
                    </button>
                </div>
            }

            @if (!_showingPeriodontogram && _canViewPlans)
            {
                <div class="odontogram-work-switch" role="tablist" aria-label="Trabajo sobre el odontograma">
                    <button type="button" role="tab"
                            class="odontogram-work-card @(_odontogramWork == "hallazgo" ? "is-active" : "")"
                            aria-selected="@(_odontogramWork == "hallazgo")"
                            @onclick="@(() => SetOdontogramWork("hallazgo"))">
                        <span class="odontogram-work-icon" aria-hidden="true"><Icon Name="activity" /></span>
                        <span class="odontogram-work-copy">
                            <strong>Hallazgo</strong>
                            <span>Registrar diagnóstico en el historial</span>
                        </span>
                    </button>
                    <button type="button" role="tab"
                            class="odontogram-work-card is-quote @(_odontogramWork == "presupuesto" ? "is-active" : "")"
                            aria-selected="@(_odontogramWork == "presupuesto")"
                            @onclick="@(() => SetOdontogramWork("presupuesto"))">
                        <span class="odontogram-work-icon" aria-hidden="true"><Icon Name="clipboard-list" /></span>
                        <span class="odontogram-work-copy">
                            <strong>Presupuesto</strong>
                            <span>Armar cotización con las piezas seleccionadas</span>
                        </span>
                        <span class="odontogram-work-badge">Cotizar</span>
                    </button>
                </div>
            }

            @if (!_showingPeriodontogram && _odontogramWork == "hallazgo")
            {
            <div class="odontogram-clinical-grid">
                <section class="clinical-entry-panel" aria-labelledby="entry-heading">
                    <div class="clinical-section-heading">
                        <div>
                            <p class="clinical-kicker">Odontograma</p>
                            <h3 id="entry-heading">@(_editingEntryId.HasValue ? "Editar hallazgo" : "Registrar hallazgo")</h3>
                            <p>@(_editingEntryId.HasValue
                                ? "Corrija el diagnóstico, la fase, el material o las observaciones de esta entrada del historial."
                                : "Los hallazgos nuevos se agregan al historial. Puede editar una entrada desde la línea de tiempo.")</p>
                        </div>
                    </div>

                    @if (!_canEditOdontogram)
                    {
                        <div class="clinical-readonly-note">Tiene permiso de lectura. La edición requiere <code>odontograma.edit</code>.</div>
                    }

                    <div class="new-patient-form compact-clinical-form">
                        <div class="form-row">
                            <div class="form-group">
                                <label>Piezas</label>
                                <div class="tooth-selection-chips">
                                    @if (_selectedTeeth.Count == 0)
                                    {
                                        <span class="tooth-empty-hint">Seleccione en el odontograma</span>
                                    }
                                    else
                                    {
                                        @foreach (var tooth in _selectedTeeth.OrderBy(x => x))
                                        {
                                            <button type="button" class="tooth-chip @(_selectedTooth == tooth ? "is-primary" : "")"
                                                    disabled="@(!_canEditOdontogram || _editingEntryId.HasValue)"
                                                    @onclick="() => RemoveSelectedTooth(tooth)">
                                                @tooth ×
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Tipo</label>
                                <input class="form-input" value="@SelectedTeethDescription" disabled />
                            </div>
                        </div>
                        <fieldset class="finding-scope">
                            <legend>Alcance</legend>
                            <div class="finding-scope-options" role="radiogroup" aria-label="Alcance del hallazgo">
                                <button type="button" role="radio"
                                        class="finding-scope-btn @(_findingScope == ToothFindingScope.WholeTooth ? "is-active" : "")"
                                        aria-checked="@(_findingScope == ToothFindingScope.WholeTooth)"
                                        disabled="@(!_canEditOdontogram)"
                                        @onclick="() => SetFindingScope(ToothFindingScope.WholeTooth)">
                                    Pieza completa
                                </button>
                                <button type="button" role="radio"
                                        class="finding-scope-btn @(_findingScope == ToothFindingScope.Surface ? "is-active" : "")"
                                        aria-checked="@(_findingScope == ToothFindingScope.Surface)"
                                        disabled="@(!_canEditOdontogram)"
                                        @onclick="() => SetFindingScope(ToothFindingScope.Surface)">
                                    @(_selectedSurfaces.Count(IsChartFace) > 1 ? "Superficies" : "Superficie")
                                </button>
                            </div>
                        </fieldset>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Superficie</label>
                                <input class="form-input" value="@(_findingScope == ToothFindingScope.WholeTooth ? "Pieza completa" : SurfaceLabelForSelected())" disabled />
                            </div>
                            <div class="form-group">
                                <label for="tooth-condition">Condición clínica</label>
                                <select id="tooth-condition" class="form-input" value="@_entryForm.Condition"
                                        disabled="@(!_canEditOdontogram)" @onchange="OnConditionSelected">
                                    @foreach (var value in VisibleConditions())
                                    {
                                        <option value="@value">@ConditionLabel(value)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        @if (_entryForm.Condition == ToothCondition.Bridge && !_editingEntryId.HasValue)
                        {
                            <div class="bridge-draft">
                                <p class="rx-hint">El tramo se marcará con un círculo en cada unidad y una línea que las une. Los pónticos se ven ausentes (X).</p>
                                @if (!string.IsNullOrWhiteSpace(BridgeDraftError))
                                {
                                    <p class="clinical-readonly-note">@BridgeDraftError</p>
                                }
                                @if (_bridgeUnits.Count > 0)
                                {
                                    <div class="data-table-wrap">
                                        <table class="data-table">
                                            <thead>
                                                <tr>
                                                    <th>FDI</th>
                                                    <th>Rol</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var unit in _bridgeUnits)
                                                {
                                                    <tr>
                                                        <td>@unit.ToothNumber</td>
                                                        <td>
                                                            <select class="form-input" disabled="@(!_canEditOdontogram)"
                                                                    value="@unit.Role"
                                                                    @onchange="e => SetBridgeRole(unit.ToothNumber, e)">
                                                                <option value="@BridgeRole.Abutment">Pilar</option>
                                                                <option value="@BridgeRole.Pontic">Póntico</option>
                                                            </select>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        }
                        @if (_entryForm.Condition != ToothCondition.Healthy)
                        {
                            <div class="form-group">
                                <label for="tooth-phase">Fase</label>
                                <select id="tooth-phase" class="form-input" @bind="_entryForm.Phase" disabled="@(!_canEditOdontogram)">
                                    @foreach (var value in Enum.GetValues<ToothChartPhase>())
                                    {
                                        <option value="@value">@PhaseLabel(value)</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (ToothClinicalLabels.ShowsCariesDetails(_entryForm.Condition))
                        {
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="caries-type">Tipo de caries</label>
                                    <select id="caries-type" class="form-input" @bind="_entryForm.CariesType" disabled="@(!_canEditOdontogram)">
                                        <option value="">Seleccione</option>
                                        @foreach (var value in Enum.GetValues<CariesType>())
                                        {
                                            <option value="@value">@ToothClinicalLabels.CariesKind(value)</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="caries-icdas">Clasificación ICDAS</label>
                                    <select id="caries-icdas" class="form-input" @bind="_entryForm.Icdas" disabled="@(!_canEditOdontogram)">
                                        <option value="">Seleccione</option>
                                        @foreach (var value in Enum.GetValues<IcdasCode>())
                                        {
                                            <option value="@value">@ToothClinicalLabels.Icdas(value)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="tooth-severity">Profundidad</label>
                                <select id="tooth-severity" class="form-input" @bind="_entryForm.Severity" disabled="@(!_canEditOdontogram)">
                                    <option value="">Sin especificar</option>
                                    @foreach (var value in Enum.GetValues<ToothSeverity>())
                                    {
                                        <option value="@value">@SeverityLabel(value)</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (ToothClinicalLabels.ShowsMaterial(_entryForm.Condition))
                        {
                            <div class="form-group">
                                <label for="tooth-material">Material</label>
                                <select id="tooth-material" class="form-input" @bind="_entryForm.RestorationMaterial" disabled="@(!_canEditOdontogram)">
                                    <option value="">Sin especificar</option>
                                    @foreach (var value in AllowedMaterials())
                                    {
                                        <option value="@value">@ToothClinicalLabels.Material(value)</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (_entryForm.Condition != ToothCondition.Healthy)
                        {
                            <div class="form-group">
                                <label for="tooth-dx">Diagnóstico odontológico</label>
                                <input id="tooth-dx" class="form-input" @bind="_entryForm.ClinicalDiagnosis" disabled="@(!_canEditOdontogram)"
                                       placeholder="Ej. Caries dental" />
                            </div>
                            <div class="form-group">
                                <label for="tooth-tx">Tratamiento propuesto</label>
                                <input id="tooth-tx" class="form-input" @bind="_entryForm.ProposedTreatment" disabled="@(!_canEditOdontogram)"
                                       placeholder="Ej. Restauración con resina" />
                            </div>
                            <div class="form-group">
                                <label for="tooth-notes">Observaciones</label>
                                <textarea id="tooth-notes" class="form-input" rows="3" maxlength="1000"
                                          @bind="_entryForm.Notes" disabled="@(!_canEditOdontogram)"></textarea>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_saveMessage))
                        {
                            <div class="wizard-success">@_saveMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(_saveError))
                        {
                            <div class="wizard-error">@_saveError</div>
                        }
                        <div class="clinical-entry-footer">
                            <p class="rx-hint">El color se aplica a la pieza completa o a las caras marcadas. Puede seleccionar varias caras (MO, MOD, etc.).</p>
                            @if (_canEditOdontogram)
                            {
                                <div class="clinical-entry-actions">
                                    <button type="button" class="btn-primary" disabled="@(_savingEntry || _selectedTeeth.Count == 0)" @onclick="SaveToothEntryAsync">
                                        @(_savingEntry
                                            ? (_editingEntryId.HasValue ? "Guardando..." : "Registrando...")
                                            : _editingEntryId.HasValue
                                                ? "Guardar cambios"
                                                : FindingSaveLabel)
                                    </button>
                                    @if (_editingEntryId.HasValue)
                                    {
                                        <button type="button" class="btn-outline" disabled="@_savingEntry" @onclick="CancelEditToothEntry">Cancelar edición</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <DentalTimeline Title="@OdontogramHistoryTitle"
                                Subtitle="@OdontogramHistorySubtitle"
                                Events="@OdontogramHistoryEvents"
                                Loading="_fullTimelineLoading"
                                Error="@_fullTimelineError"
                                EnableDateFilter="true"
                                CanEdit="_canEditOdontogram"
                                OnEdit="BeginEditToothEntryAsync"
                                OnVoid="VoidToothEntryAsync">
                    <HeaderActions>
                        <div class="maintenance-tabs odontogram-history-tabs" role="tablist" aria-label="Alcance del historial">
                            <button type="button" role="tab" aria-selected="@_odontogramHistoryAll"
                                    class="toggle-btn @(_odontogramHistoryAll ? "active" : "")"
                                    @onclick="() => ShowAllTeethHistory()">Todas las piezas</button>
                            <button type="button" role="tab" aria-selected="@(!_odontogramHistoryAll)"
                                    class="toggle-btn @(!_odontogramHistoryAll ? "active" : "")"
                                    disabled="@(_selectedTeeth.Count == 0)"
                                    @onclick="ShowSelectedTeethHistoryAsync">
                                @(_selectedTeeth.Count == 0
                                    ? "Pieza seleccionada"
                                    : _selectedTeeth.Count == 1
                                        ? $"Pieza {_selectedTooth}"
                                        : $"{_selectedTeeth.Count} piezas")
                            </button>
                        </div>
                    </HeaderActions>
                </DentalTimeline>
            </div>
            }
        }
        else if (_tab == "planes")
        {
            @* El listado y el compositor viven en PatientQuotesPanel, más abajo, para no perder el borrador. *@
        }
        else if (_tab == "tratamientos")
        {
            <section class="record-section-card">
                <div class="clinical-section-heading"><div><h3>Tratamientos</h3><p>Indique el procedimiento, seleccione las piezas en el odontograma y agregue el detalle clínico.</p></div></div>
                @if (_canCreateTreatments)
                {
                    @if (_canViewOdontogram)
                    {
                        <OdontogramChart Entries="_chartEntries"
                                          SelectedTooth="_selectedTooth"
                                          SelectedTeeth="_selectedTeeth"
                                          SelectedSurface="_selectedSurface"
                                          SelectedSurfaces="_selectedSurfaces"
                                          SelectedToothChanged="SelectToothAsync"
                                          ToothSelectionChanged="OnToothSelection"
                                          SelectedSurfaceChanged="SelectSurface"
                                          PatientId="PatientId"
                                          PatientName="@(_profile?.FullName ?? "Paciente")"
                                          AllowPeriodontogram="false"
                                          Heading="Piezas del tratamiento"
                                          Hint="Clic selecciona una pieza. Use Ctrl o «Varias piezas» para extraer o restaurar varias. Los procedimientos de boca completa no usan esta selección." />
                    }
                    <div class="new-patient-form compact-clinical-form">
                        <div class="form-row">
                            <div class="form-group">
                                <label>Procedimiento activo</label>
                                <select class="form-input" value="@_treatmentProcedureId" @onchange="OnTreatmentProcedureSelected">
                                    <option value="0">Seleccione...</option>
                                    @foreach (var procedure in _activeProcedures)
                                    {
                                        <option value="@procedure.Id">@procedure.Name — @TreatmentProcedureRules.TargetLabel(procedure.Target)</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>@(SelectedTreatmentProcedure?.Target == ProcedureTarget.WholeMouth ? "Costo" : "Costo por pieza")</label>
                                <input type="number" min="0" step="0.01" class="form-input" @bind="_treatmentCost" />
                            </div>
                        </div>
                        @if (SelectedTreatmentProcedure != null)
                        {
                            <p class="rx-hint">@TreatmentScopeHint</p>
                        }
                        <div class="form-row">
                            <div class="form-group">
                                <label>Piezas</label>
                                <div class="tooth-selection-chips">
                                    @if (SelectedTreatmentProcedure?.Target == ProcedureTarget.WholeMouth)
                                    {
                                        <span class="rx-hint">Boca completa — no se asocia a piezas</span>
                                    }
                                    else if (_selectedTeeth.Count == 0)
                                    {
                                        <span class="rx-hint">Seleccione en el odontograma</span>
                                    }
                                    else
                                    {
                                        @foreach (var tooth in _selectedTeeth.OrderBy(x => x))
                                        {
                                            <span class="tooth-chip @(_selectedTooth == tooth ? "is-primary" : "")">@tooth</span>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Superficie</label>
                                <input class="form-input" value="@SurfaceLabelForSelected()" disabled />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Detalle del tratamiento</label>
                            <textarea class="form-input" rows="2" maxlength="2000" @bind="_treatmentDetails"
                                      placeholder="Técnica, material, anestesia, indicaciones específicas..."></textarea>
                        </div>
                        <div class="form-group">
                            <label>Notas médicas</label>
                            <textarea class="form-input" rows="3" maxlength="4000" @bind="_treatmentMedicalNotes"
                                      placeholder="Observaciones clínicas, indicaciones o evolución del tratamiento..."></textarea>
                        </div>
                        <button class="btn-primary" disabled="@(_savingTreatment || _treatmentProcedureId == 0)" @onclick="CreateTreatmentAsync">
                            @TreatmentSaveLabel
                        </button>
                    </div>
                }
                @if (_canEditTreatments) { <div class="form-group"><label>Motivo de cancelación (opcional)</label><input class="form-input" @bind="_treatmentCancellationReason" /></div> }
                @if (!string.IsNullOrWhiteSpace(_treatmentsError))
                {
                    <div class="wizard-error">@_treatmentsError</div>
                }
                else if (_patientTreatments.Count == 0)
                {
                    <div class="maintenance-empty"><p>No hay tratamientos registrados para este paciente.</p></div>
                }
                else
                {
                    <div class="data-table-wrap">
                        <table class="data-table">
                            <thead><tr><th>Procedimiento</th><th>Pieza</th><th>Estado</th><th>Costo</th><th>Registro</th><th>Acciones</th></tr></thead>
                            <tbody>
                                @foreach (var treatment in _patientTreatments)
                                {
                                    <tr>
                                        <td>
                                            <strong>@treatment.ProcedureName</strong>
                                            @if (!string.IsNullOrWhiteSpace(treatment.ProcedureDetails))
                                            {
                                                <div class="billing-muted">@treatment.ProcedureDetails</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(treatment.MedicalNotes))
                                            {
                                                <div class="tx-medical-note">Notas médicas: @treatment.MedicalNotes</div>
                                            }
                                        </td>
                                        <td>@(treatment.ToothNumber?.ToString() ?? "—")</td>
                                        <td><span class="status-badge @TreatmentStatusClass(treatment.Status)">@TreatmentStatusLabel(treatment.Status)</span></td>
                                        <td>$@treatment.Cost.ToString("N0")</td>
                                        <td>@treatment.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (_canEditTreatments && treatment.Status == "Planned")
                                            {
                                                <button class="btn-primary" @onclick="() => StartTreatmentAsync(treatment.Id)">Iniciar</button>
                                                <button class="btn-outline" @onclick="() => CancelTreatmentAsync(treatment.Id)">Cancelar</button>
                                            }
                                            else if (_canEditTreatments && treatment.Status == "InProgress")
                                            {
                                                <button class="btn-primary" @onclick="() => OpenCompleteTreatment(treatment)">Completar</button>
                                                <button class="btn-outline" @onclick="() => CancelTreatmentAsync(treatment.Id)">Cancelar</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
            @if (_treatmentToComplete != null)
            {
                <div class="modal-overlay">
                    <div class="modal-panel">
                        <h3>Completar tratamiento</h3>
                        <p>@_treatmentToComplete.ProcedureName · pieza @(_treatmentToComplete.ToothNumber?.ToString() ?? "sin pieza")</p>
                        <h4>Resultado clínico</h4>
                        <div class="form-group"><label>Superficie</label><select class="form-input" @bind="_completionResult.Surface">@foreach (var value in Enum.GetValues<ToothSurface>()) { <option value="@value">@SurfaceLabel(value)</option> }</select></div>
                        <div class="form-group"><label>Condición resultante</label><select class="form-input" @bind="_completionResult.Condition">@foreach (var value in Enum.GetValues<ToothCondition>()) { <option value="@value">@ConditionLabel(value)</option> }</select></div>
                        <div class="form-group"><label>Severidad</label><select class="form-input" @bind="_completionResult.Severity"><option value="">Sin especificar</option>@foreach (var value in Enum.GetValues<ToothSeverity>()) { <option value="@value">@SeverityLabel(value)</option> }</select></div>
                        <div class="form-group"><label>Notas</label><textarea class="form-input" rows="3" @bind="_completionResult.Notes"></textarea></div>

                        <h4>Material utilizado</h4>
                        @if (_consumeLoading)
                        {
                            <p class="billing-muted">Cargando materiales del BOM...</p>
                        }
                        else if (!_consumeLines.Any())
                        {
                            <p class="billing-muted">Sin BOM de inventario para este procedimiento (la factura no se ve afectada).</p>
                        }
                        else
                        {
                            <div class="data-table-wrap">
                                <table class="data-table">
                                    <thead><tr><th></th><th>Material</th><th>Cantidad</th><th>Stock</th></tr></thead>
                                    <tbody>
                                        @for (var i = 0; i < _consumeLines.Count; i++)
                                        {
                                            var idx = i;
                                            <tr>
                                                <td><input type="checkbox" @bind="_consumeLines[idx].IsIncluded" /></td>
                                                <td>@_consumeLines[idx].Name <small>(@_consumeLines[idx].Unit)</small></td>
                                                <td><input class="form-input" type="number" step="0.001" min="0" @bind="_consumeLines[idx].ActualQuantity" disabled="@(!_consumeLines[idx].IsIncluded)" /></td>
                                                <td>@_consumeLines[idx].QuantityOnHand.ToString("0.###")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <p class="billing-muted">Puedes modificar el consumo antes de confirmar.</p>
                        }

                        <div class="modal-actions">
                            <button class="btn-outline" @onclick="CloseCompleteTreatment">Cancelar</button>
                            <button class="btn-primary" disabled="@_savingTreatment" @onclick="CompleteTreatmentAsync">Confirmar y completar</button>
                        </div>
                    </div>
                </div>
            }
        }
        else if (_tab == "historial")
        {
            <DentalTimeline Title="Historial clínico completo"
                            Subtitle="Eventos reales del odontograma, planes, tratamientos, recetas, consentimientos, adjuntos y notas clínicas. Puede editar o anular un hallazgo del odontograma."
                            Events="_fullTimeline"
                            Loading="_fullTimelineLoading"
                            Error="@_fullTimelineError"
                            CanEdit="_canEditOdontogram"
                            OnEdit="BeginEditToothEntryAsync"
                            OnVoid="VoidToothEntryAsync" />
        }
        else if (_tab == "recetas" && _canViewRecetas)
        {
            <PatientPrescriptionsPanel PatientId="PatientId" CanEdit="_canEditRecetas" />
        }
        else if (_tab == "certificados" && _canViewCertificados)
        {
            <PatientMedicalCertificatesPanel PatientId="PatientId" CanEdit="_canEditCertificados" PatientDiagnosis="@_history?.Diagnosis" />
        }
        else if (_tab == "consentimientos" && _canViewConsentimientos)
        {
            <PatientInformedConsentsPanel PatientId="PatientId"
                                         PatientName="@(_profile?.FullName ?? "Paciente")"
                                         CanEdit="_canEditConsentimientos"
                                         OnChanged="OnAttachmentsChangedAsync" />
        }
        else if (_tab == "facturas" && _canViewFacturas)
        {
            <PatientInvoicesPanel PatientId="PatientId" />
        }
        else if (_tab == "adjuntos")
        {
            <PatientClinicalAttachmentsPanel PatientId="PatientId" CanEdit="_canEditAttachments" OnChanged="OnAttachmentsChangedAsync" />
        }

        @if (_canViewPlans)
        {
            <div class="patient-quotes-host @(QuotesPanelVisible ? "" : "is-hidden") @(_tab == "odontograma" && _odontogramWork == "presupuesto" ? "is-odontogram-quote" : "")"
                 aria-hidden="@(!QuotesPanelVisible)">
                <PatientQuotesPanel PatientId="PatientId"
                                    PatientName="@(_profile?.FullName ?? "Paciente")"
                                    Mode="CurrentQuotesMode"
                                    CanViewOdontogram="_canViewOdontogram"
                                    SelectedTooth="_selectedTooth"
                                    SelectedTeeth="_selectedTeeth"
                                    SelectedSurface="_selectedSurface"
                                    OnRequestCompose="BeginQuoteComposeAsync"
                                    OnRequestList="ShowQuoteListAsync"
                                    OnQuoteSaved="OnQuoteSavedAsync" />
            </div>
        }

        @if (_showCompleteVisitModal && _careAppointmentId is > 0)
        {
            <div class="modal-overlay" @onclick="CloseCompleteVisitModal">
                <div class="modal-panel" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <h2>Completar ficha y cobrar</h2>
                        <button type="button" class="modal-close" @onclick="CloseCompleteVisitModal">×</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_completeVisitError))
                    {
                        <div class="wizard-error">@_completeVisitError</div>
                    }
                    <p class="modal-confirm-text">Se marcará la cita #@_careAppointmentId como completada, se creará la factura de esta visita y se abrirá el cobro.</p>
                    <div class="new-patient-form">
                        <div class="form-group">
                            <label>Diagnóstico *</label>
                            <input class="form-input" @bind="_completeVisitForm.Diagnosis" />
                        </div>
                        <div class="form-group">
                            <label>Descripción *</label>
                            <textarea class="form-input" rows="3" @bind="_completeVisitForm.Description"></textarea>
                        </div>
                        <div class="form-group">
                            <label>Notas adicionales</label>
                            <textarea class="form-input" rows="2" @bind="_completeVisitForm.AdditionalNotes"></textarea>
                        </div>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="btn-outline" @onclick="CloseCompleteVisitModal">Cancelar</button>
                        <button type="button" class="btn-primary" disabled="@_saving" @onclick="CompleteVisitAndBillAsync">
                            @(_saving ? "Completando..." : "Completar y cobrar")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int PatientId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? QueryTab { get; set; }
    [SupplyParameterFromQuery(Name = "cita")] public int? QueryAppointmentId { get; set; }
    [SupplyParameterFromQuery(Name = "motivo")] public string? QueryMotive { get; set; }

    private static readonly (string Key, string Label, string Icon)[] Tabs =
    [
        ("datos", "Datos personales", "user"),
        ("antecedentes", "Antecedentes", "stethoscope"),
        ("odontograma", "Odontograma", "tooth"),
        ("planes", "Presupuesto", "clipboard-list"),
        ("recetas", "Recetas", "pill"),
        ("certificados", "Certificados", "file-text"),
        ("consentimientos", "Consentimientos", "check-circle-2"),
        ("facturas", "Facturas", "credit-card"),
        ("adjuntos", "Adjuntos", "paperclip"),
        ("historial", "Historial", "clock")
    ];

    private PatientClinicalProfile? _profile;
    private DentalHistoryForm? _history;
    private List<EmergencyContactItem> _emergencyContacts = [];
    private EmergencyContactForm _ecForm = new();
    private int? _ecEditingId;
    private bool _ecExpanded;
    private bool _ecLoading;
    private bool _ecSaving;
    private bool _ecFormVisible;
    private string? _ecError;
    private List<MedicalConditionListItem> _conditions = [];
    private List<ToothChartEntry> _chartEntries = [];
    private List<DentalClinicalEvent> _fullTimeline = [];
    private List<DentalTreatmentListItem> _patientTreatments = [];
    private List<TreatmentProcedureListItem> _activeProcedures = [];
    private CreateToothChartEntryRequest _entryForm = new();
    private long? _editingEntryId;
    private DentalTreatmentClinicalResultRequest _completionResult = new();
    private DentalTreatmentListItem? _treatmentToComplete;
    private List<MaterialConsumptionLineItem> _consumeLines = [];
    private bool _consumeLoading;
    private int? _selectedTooth;
    private readonly List<int> _selectedTeeth = [];
    private List<BridgeUnitInput> _bridgeUnits = [];
    private ToothSurface _selectedSurface = ToothSurface.WholeTooth;
    private readonly List<ToothSurface> _selectedSurfaces = [ToothSurface.WholeTooth];
    private ToothFindingScope _findingScope = ToothFindingScope.WholeTooth;
    private bool _odontogramHistoryAll = true;
    private bool _showingPeriodontogram;
    private string _tab = "datos";
    private bool _loading = true;
    private bool _saving;
