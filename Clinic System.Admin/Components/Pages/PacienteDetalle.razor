    private CancellationTokenSource? _noticeCts;

    private void ClearNotice()
    {
        _saveError = null;
        _saveMessage = null;
        _noticeCts?.Cancel();
        _noticeCts?.Dispose();
        _noticeCts = null;
    }

    private void ShowNotice(string? success = null, string? error = null)
    {
        _saveMessage = success;
        _saveError = error;
        _noticeCts?.Cancel();
        _noticeCts?.Dispose();
        _noticeCts = new CancellationTokenSource();
        var token = _noticeCts.Token;
        _ = DismissNoticeLaterAsync(token);
    }

    private async Task DismissNoticeLaterAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(string.IsNullOrEmpty(_saveError) ? 4500 : 7000, token);
            if (token.IsCancellationRequested)
                return;
            _saveMessage = null;
            _saveError = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private static readonly CultureInfo EsCulture = CultureInfo.GetCultureInfo("es-DO");

    private string BirthIsoValue =>
        !string.IsNullOrWhiteSpace(_profile?.DateOfBirthIso)
            ? _profile.DateOfBirthIso
            : TryGetBirthDate(out var dob)
                ? dob.ToString("yyyy-MM-dd")
                : string.Empty;

    private void OnBirthDateChanged(ChangeEventArgs e)
    {
        if (_profile == null || !TryParseBirth(e.Value?.ToString(), out var date))
            return;

        _profile.DateOfBirthIso = date.ToString("yyyy-MM-dd");
        _profile.DateOfBirth = date.ToString("dd/MM/yyyy");
    }

    private bool TryGetBirthDate(out DateTime date) =>
        TryParseBirth(_profile?.DateOfBirthIso, out date) || TryParseBirth(_profile?.DateOfBirth, out date);

    private static bool TryParseBirth(string? value, out DateTime date)
    {
        date = default;
        if (string.IsNullOrWhiteSpace(value))
            return false;

        string[] formats = ["yyyy-MM-dd", "dd/MM/yyyy", "d/M/yyyy", "dd-MM-yyyy"];
        if (DateTime.TryParseExact(value.Trim(), formats, CultureInfo.InvariantCulture, DateTimeStyles.None, out date))
            return true;

        return DateTime.TryParse(value, EsCulture, DateTimeStyles.None, out date);
    }

    private static string FormatBirthLong(DateTime birthDate) =>
        birthDate.ToString("d 'de' MMMM 'de' yyyy", EsCulture);

    private static int? GetAgeYears(DateTime birthDate)
    {
        var today = DateTime.Today;
        var age = today.Year - birthDate.Year;
        if (birthDate.Date > today.AddYears(-age))
            age--;
        return age >= 0 ? age : null;
    }

    private static string NextBirthdayLabel(DateTime birthDate)
    {
        var today = DateTime.Today;
        var day = Math.Min(birthDate.Day, DateTime.DaysInMonth(today.Year, birthDate.Month));
        var next = new DateTime(today.Year, birthDate.Month, day);
        if (next < today)
        {
            var nextYear = today.Year + 1;
            day = Math.Min(birthDate.Day, DateTime.DaysInMonth(nextYear, birthDate.Month));
            next = new DateTime(nextYear, birthDate.Month, day);
        }

        if (next == today)
            return "Hoy es su cumpleaños";

        var days = (next - today).Days;
        if (days == 1)
            return "Cumpleaños mañana";

        return $"Cumpleaños en {days} días · {next.ToString("d MMM", EsCulture)}";
    }

    private static string GenderLabel(string gender) => gender switch
    {
        "Male" => "Masculino",
        "Female" => "Femenino",
        _ => string.IsNullOrWhiteSpace(gender) ? "Género no indicado" : gender
    };

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        return name.Length > 0 ? char.ToUpper(name[0]).ToString() : "?";
    }

    public void Dispose()
    {
        _noticeCts?.Cancel();
        _noticeCts?.Dispose();
    }
