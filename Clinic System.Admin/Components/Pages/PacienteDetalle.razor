    private string Limit(ChangeEventArgs e, int max, string label)
    {
        var value = PatientSaveErrors.Clamp(e.Value?.ToString(), max, out var truncated);
        if (truncated)
            ShowNotice(error: $"{label} admite máximo {max} caracteres.");
        return value;
    }

    private void ShowNotice(string? success = null, string? error = null)
    {
        _saveMessage = success;
        _saveError = error;
        _noticeCts?.Cancel();
        _noticeCts?.Dispose();
        _noticeCts = new CancellationTokenSource();
        var token = _noticeCts.Token;
        _ = DismissNoticeLaterAsync(token);
    }

    private async Task DismissNoticeLaterAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(string.IsNullOrEmpty(_saveError) ? 4500 : 7000, token);
            if (token.IsCancellationRequested)
                return;
            _saveMessage = null;
            _saveError = null;
            if (_duplicatePatientId is null)
                await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private static readonly CultureInfo EsCulture = CultureInfo.GetCultureInfo("es-DO");

    private string BirthIsoValue =>
