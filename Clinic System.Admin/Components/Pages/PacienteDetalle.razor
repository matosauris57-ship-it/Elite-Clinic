            ClinicalDiagnosis = entry.ClinicalDiagnosis,
            ProposedTreatment = entry.ProposedTreatment,
            Notes = entry.Notes,
            BridgeSpanId = entry.BridgeSpanId
        };
        if (entry.Condition == ToothCondition.Bridge && entry.BridgeRole.HasValue)
        {
            _bridgeUnits =
            [
                new BridgeUnitInput { ToothNumber = entry.ToothNumber, Role = entry.BridgeRole.Value }
            ];
        }
        else
        {
            _bridgeUnits = [];
        }

        ApplySurfaceSelection([entry.Surface]);
        _odontogramHistoryAll = false;
        if (_fullTimeline.Count == 0)
            await LoadFullTimelineAsync();
