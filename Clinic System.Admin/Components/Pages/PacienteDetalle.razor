    private void OpenCompleteTreatment(DentalTreatmentListItem treatment)
    {
        _treatmentToComplete = treatment;
        _completionResult = new DentalTreatmentClinicalResultRequest
        {
            Surface = treatment.ToothSurface ?? _selectedSurface,
            Condition = ToothCondition.Healthy
        };
    }

    private void CloseCompleteTreatment() => _treatmentToComplete = null;

    private async Task CompleteTreatmentAsync()
    {
        if (_treatmentToComplete == null)
            return;

        _savingTreatment = true;
        var result = await TreatmentService.CompleteTreatmentAsync(
            _treatmentToComplete.Id,
            new CompleteDentalTreatmentRequest { ClinicalResult = _completionResult });
        _savingTreatment = false;
        if (result.Success)
            _treatmentToComplete = null;
        await FinishTreatmentOperationAsync(result, "Tratamiento completado.", true);
    }

    private async Task FinishTreatmentOperationAsync(
        (bool Success, string? Error) result, string message, bool includeChart)
    {
        if (!result.Success)
        {
            ShowNotice(error: result.Error);
            return;
        }

        ShowNotice(success: message);
        await RefreshClinicalDataAsync(includeChart);
    }

    private async Task RefreshClinicalDataAsync(bool includeChart)
