    private async Task SelectToothAsync(int tooth) => await OnToothSelection((tooth, false));

    private async Task OnToothSelection((int Tooth, bool Additive) click)
    {
        if (_editingEntryId.HasValue)
            CancelEditToothEntry();
        if (click.Additive)
        {
            if (_selectedTeeth.Contains(click.Tooth))
            {
                if (_selectedTeeth.Count > 1)
                    _selectedTeeth.Remove(click.Tooth);
            }
            else
                _selectedTeeth.Add(click.Tooth);
        }
        else
        {
            _selectedTeeth.Clear();
            _selectedTeeth.Add(click.Tooth);
        }

        _selectedTooth = _selectedTeeth.Count == 0
            ? null
            : _selectedTeeth.Contains(click.Tooth) ? click.Tooth : _selectedTeeth[^1];

        _entryForm.ToothNumber = _selectedTooth ?? 0;
        if (!_selectedTooth.HasValue)
        {
            _odontogramHistoryAll = true;
            return;
        }

        _odontogramHistoryAll = false;
        if (_fullTimeline.Count == 0)
            await LoadFullTimelineAsync();
        RefreshBridgeDraft();
    }

    private async Task RemoveSelectedTooth(int tooth)
    {
        if (_selectedTeeth.Count <= 1)
            return;

        _selectedTeeth.Remove(tooth);
        _selectedTooth = _selectedTeeth[^1];
        _entryForm.ToothNumber = _selectedTooth.Value;
        RefreshBridgeDraft();
        if (!_odontogramHistoryAll && _fullTimeline.Count == 0)
            await LoadFullTimelineAsync();
    }

    private void SelectSurface(ToothSurface surface)
    {
        if (_editingEntryId.HasValue || surface == ToothSurface.WholeTooth)
        {
            ApplySurfaceSelection([surface]);
            return;
        }

        var faces = _selectedSurfaces.Where(IsChartFace).ToList();
        if (faces.Contains(surface))
            faces.Remove(surface);
        else
            faces.Add(surface);

        ApplySurfaceSelection(faces.Count == 0 ? [ToothSurface.WholeTooth] : faces);
    }

    private static bool IsChartFace(ToothSurface surface) =>
        surface is ToothSurface.Mesial or ToothSurface.Distal or ToothSurface.BuccalFacial
            or ToothSurface.LingualPalatal or ToothSurface.OcclusalIncisal;

    private void ApplySurfaceSelection(IReadOnlyList<ToothSurface> surfaces)
    {
        _selectedSurfaces.Clear();
        if (surfaces.Count == 0 || surfaces.Contains(ToothSurface.WholeTooth) && surfaces.Count == 1)
        {
            _selectedSurfaces.Add(ToothSurface.WholeTooth);
            _selectedSurface = ToothSurface.WholeTooth;
            _findingScope = ToothFindingScope.WholeTooth;
        }
        else
        {
            foreach (var surface in surfaces.Where(IsChartFace).Distinct())
                _selectedSurfaces.Add(surface);
            if (_selectedSurfaces.Count == 0)
            {
                _selectedSurfaces.Add(ToothSurface.WholeTooth);
                _selectedSurface = ToothSurface.WholeTooth;
                _findingScope = ToothFindingScope.WholeTooth;
            }
            else
            {
                _selectedSurface = _selectedSurfaces[0];
                _findingScope = ToothFindingScope.Surface;
            }
        }

        _entryForm.Surface = _selectedSurface;
        _entryForm.Surfaces = _findingScope == ToothFindingScope.WholeTooth
            ? []
            : [.. _selectedSurfaces];

        if (!VisibleConditions().Contains(_entryForm.Condition))
        {
            _entryForm.Condition = VisibleConditions().First();
            OnConditionChanged();
        }
    }

    private void SetFindingScope(ToothFindingScope scope)
    {
        _findingScope = scope;
        if (scope == ToothFindingScope.WholeTooth)
            ApplySurfaceSelection([ToothSurface.WholeTooth]);
        else if (!_selectedSurfaces.Any(IsChartFace))
            ApplySurfaceSelection([ToothSurface.OcclusalIncisal]);
        else
            ApplySurfaceSelection(_selectedSurfaces.Where(IsChartFace).ToList());
    }

    private void OnConditionSelected(ChangeEventArgs e)
    {
        if (Enum.TryParse<ToothCondition>(e.Value?.ToString(), out var condition))
            _entryForm.Condition = condition;
        OnConditionChanged();
    }

    private void OnConditionChanged()
    {
        if (!ToothClinicalLabels.ShowsMaterial(_entryForm.Condition))
            _entryForm.RestorationMaterial = null;
        if (!ToothClinicalLabels.ShowsCariesDetails(_entryForm.Condition))
        {
            _entryForm.CariesType = null;
            _entryForm.Icdas = null;
            _entryForm.Severity = null;
        }
        if (_entryForm.Condition == ToothCondition.Healthy)
        {
            _entryForm.Phase = ToothChartPhase.Diagnosis;
            _entryForm.ClinicalDiagnosis = null;
            _entryForm.ProposedTreatment = null;
            _entryForm.Notes = null;
        }

        var coreCondition = (Clinic_System.Core.Enums.ToothCondition)(int)_entryForm.Condition;
        if (Clinic_System.Core.Validation.ToothFindingRules.IsWholeToothOnly(coreCondition)
            && _findingScope != ToothFindingScope.WholeTooth)
        {
            ApplySurfaceSelection([ToothSurface.WholeTooth]);
        }

        if (_entryForm.Condition == ToothCondition.Bridge)
        {
            if (_findingScope != ToothFindingScope.WholeTooth)
                SetFindingScope(ToothFindingScope.WholeTooth);
            var suggested = Clinic_System.Core.Validation.ToothFindingRules.SuggestedDiagnosis(
                Clinic_System.Core.Enums.ToothCondition.Bridge);
            if (string.IsNullOrWhiteSpace(_entryForm.ClinicalDiagnosis))
                _entryForm.ClinicalDiagnosis = suggested;
            RefreshBridgeDraft();
        }
        else
        {
            _bridgeUnits = [];
            _entryForm.BridgeUnits = [];
            _entryForm.BridgeSpanId = null;
        }
    }

    private string? BridgeDraftError =>
        _entryForm.Condition != ToothCondition.Bridge || _bridgeUnits.Count == 0
            ? null
            : ToothBridgeRules.Validate(_bridgeUnits
                .Select(u => new BridgeUnit(u.ToothNumber, (Clinic_System.Core.Enums.BridgeRole)(int)u.Role))
                .ToList());

    private bool IsChartAbsent(int tooth)
    {
        var entry = _chartEntries
            .Where(x => x.ToothNumber == tooth && x.Surface == ToothSurface.WholeTooth)
            .OrderByDescending(x => x.RecordedAt)
            .ThenByDescending(x => x.Id)
            .FirstOrDefault();
        if (entry == null)
            return false;
        return ToothBridgeRules.IsAbsentCondition(
            (Clinic_System.Core.Enums.ToothCondition)(int)entry.Condition,
            entry.BridgeRole.HasValue ? (Clinic_System.Core.Enums.BridgeRole)(int)entry.BridgeRole.Value : null);
    }

    private void RefreshBridgeDraft()
    {
        if (_entryForm.Condition != ToothCondition.Bridge)
        {
            _bridgeUnits = [];
            _entryForm.BridgeUnits = [];
            _entryForm.BridgeSpanId = null;
            return;
        }

        var inferred = ToothBridgeRules.InferRoles(_selectedTeeth, IsChartAbsent);
        _bridgeUnits = inferred.Select(u => new BridgeUnitInput
        {
            ToothNumber = u.ToothNumber,
            Role = (BridgeRole)(int)u.Role
        }).ToList();
        foreach (var tooth in inferred.Select(u => u.ToothNumber))
        {
            if (!_selectedTeeth.Contains(tooth))
                _selectedTeeth.Add(tooth);
        }
    }

    private void SetBridgeRole(int tooth, ChangeEventArgs e)
    {
        if (!Enum.TryParse<BridgeRole>(e.Value?.ToString(), out var role))
            return;
        var unit = _bridgeUnits.FirstOrDefault(u => u.ToothNumber == tooth);
        if (unit != null)
            unit.Role = role;
    }

    private IEnumerable<ToothCondition> VisibleConditions()
    {
        var whole = _findingScope == ToothFindingScope.WholeTooth;
        return Enum.GetValues<ToothCondition>()
            .Where(c =>
            {
                var core = (Clinic_System.Core.Enums.ToothCondition)(int)c;
                return whole
                    ? Clinic_System.Core.Validation.ToothFindingRules.AllowedOnWholeTooth(core)
                    : Clinic_System.Core.Validation.ToothFindingRules.AllowedOnSurface(core);
            });
    }

    private async Task SaveToothEntryAsync()
    {
        if (_selectedTeeth.Count == 0)
        {
            ShowNotice(error: "Seleccione una o más piezas antes de guardar.");
            return;
        }

        if (_editingEntryId.HasValue && _selectedTeeth.Count != 1)
        {
            ShowNotice(error: "Al editar un hallazgo del historial, trabaje sobre una sola pieza.");
            return;
        }

        _savingEntry = true;
        ClearNotice();
        _entryForm.PatientId = PatientId;
        var selectedTeeth = _selectedTeeth.Distinct().ToList();
        if (selectedTeeth.Count == 0 && _selectedTooth is int onlyTooth)
            selectedTeeth.Add(onlyTooth);
        _entryForm.ToothNumber = selectedTeeth.ElementAtOrDefault(0);
        _entryForm.ToothNumbers = selectedTeeth;
        _entryForm.Surface = _selectedSurface;
        _entryForm.Surfaces = _findingScope == ToothFindingScope.WholeTooth
            ? []
            : [.. _selectedSurfaces.Where(IsChartFace)];
        if (_findingScope == ToothFindingScope.WholeTooth)
            _entryForm.Surface = ToothSurface.WholeTooth;
        if (_findingScope == ToothFindingScope.Surface && _entryForm.Surfaces.Count == 0)
        {
            _savingEntry = false;
            ShowNotice(error: "Marque una o más caras en el mapa del diente.");
            return;
        }
        if (_entryForm.Condition == ToothCondition.Bridge && !_editingEntryId.HasValue)
        {
            var error = BridgeDraftError;
            if (!string.IsNullOrWhiteSpace(error))
            {
                _savingEntry = false;
                ShowNotice(error: error);
                return;
            }

            _entryForm.Surface = ToothSurface.WholeTooth;
            _entryForm.BridgeSpanId = Guid.NewGuid();
            _entryForm.BridgeUnits = _bridgeUnits;
            selectedTeeth = _bridgeUnits.Select(u => u.ToothNumber).Distinct().ToList();
            _entryForm.ToothNumbers = selectedTeeth;
        }
        else if (!_editingEntryId.HasValue)
        {
            _entryForm.BridgeSpanId = null;
            _entryForm.BridgeUnits = [];
        }
        if (!ToothClinicalLabels.ShowsMaterial(_entryForm.Condition))
            _entryForm.RestorationMaterial = null;
        if (!ToothClinicalLabels.ShowsCariesDetails(_entryForm.Condition))
        {
            _entryForm.CariesType = null;
            _entryForm.Icdas = null;
        }
        if (_entryForm.Condition == ToothCondition.Healthy)
        {
            _entryForm.ClinicalDiagnosis = null;
            _entryForm.ProposedTreatment = null;
            _entryForm.Phase = ToothChartPhase.Diagnosis;
        }

        if (_editingEntryId is long entryId)
        {
            var updated = await AuthService.WithTokenRetryAsync(
                () => ToothChartService.UpdateEntryAsync(entryId, _entryForm),
                AuthService.IsTokenError);
            _savingEntry = false;
            if (updated.Error != null)
            {
                ShowNotice(error: updated.Error);
                return;
            }

            ShowNotice(success: "Hallazgo del historial actualizado.");
            CancelEditToothEntry();
            await LoadToothChartAsync();
            await LoadFullTimelineAsync();
            return;
        }

        var result = await AuthService.WithTokenRetryAsync(
            () => ToothChartService.SaveForTeethAsync(_entryForm, selectedTeeth),
            AuthService.IsTokenError);
        _savingEntry = false;
        if (result.Error != null)
        {
            ShowNotice(error: result.Error);
            return;
        }

        ShowNotice(success: result.Data > 1
            ? Clinic_System.Core.Validation.ToothSurfaceSelection.CreatedCountMessage(
                selectedTeeth.Count,
                Math.Max(1, _entryForm.Surfaces.Count))
            : "Entrada clínica registrada.");
        _entryForm = new CreateToothChartEntryRequest
        {
            PatientId = PatientId,
            ToothNumber = _selectedTooth ?? _selectedTeeth[0],
            Surface = _selectedSurface,
            Surfaces = _findingScope == ToothFindingScope.WholeTooth
                ? []
                : [.. _selectedSurfaces.Where(IsChartFace)]
        };

        await LoadToothChartAsync();
        await LoadFullTimelineAsync();
    }

    private async Task BeginEditToothEntryAsync(DentalClinicalEvent item)
    {
        if (!_canEditOdontogram)
            return;

        var entryId = item.ToothChartEntryId
            ?? (long.TryParse(item.ReferenceId, out var parsed) ? parsed : (long?)null);
        if (entryId is null or <= 0)
        {
            ShowNotice(error: "Este evento no se puede editar porque no está vinculado a un hallazgo del odontograma.");
            return;
        }

        _showingPeriodontogram = false;
        await SetTab("odontograma");
        ClearNotice();

        var loaded = await AuthService.WithTokenRetryAsync(
            () => ToothChartService.GetEntryAsync(entryId.Value),
            AuthService.IsTokenError);
        if (loaded.Error != null || loaded.Data == null)
        {
            ShowNotice(error: loaded.Error ?? "No se pudo cargar el hallazgo para editar.");
            return;
        }

        var entry = loaded.Data;
        if (entry.IsVoided)
        {
            ShowNotice(error: "Este hallazgo está anulado y no se puede editar.");
            return;
        }

        _editingEntryId = entry.Id;
        _selectedTeeth.Clear();
        _selectedTeeth.Add(entry.ToothNumber);
        _selectedTooth = entry.ToothNumber;
        _entryForm = new CreateToothChartEntryRequest
        {
            PatientId = PatientId,
            ToothNumber = entry.ToothNumber,
            Surface = entry.Surface,
            Phase = entry.Phase,
