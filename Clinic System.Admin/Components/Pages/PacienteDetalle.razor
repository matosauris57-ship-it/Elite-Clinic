    {
        _ecSaving = true;
        _ecError = null;
        var (ok, err) = await PatientService.DeleteEmergencyContactAsync(PatientId, contact.Id);
        _ecSaving = false;
        if (!ok) { _ecError = err; return; }
        _emergencyContacts.RemoveAll(c => c.Id == contact.Id);
    }

    private async Task SavePersonalDataAsync()
    {
        if (_profile == null)
            return;

        _saving = true;
        ClearNotice();
        if (!ContactEmail.TryValidate(_profile.Email, out var email, out var emailError))
        {
            ShowNotice(error: emailError);
            _saving = false;
            return;
        }
        _profile.Email = email;
        DateTime? dateOfBirth = TryGetBirthDate(out var parsedBirth) ? parsedBirth : null;
        var (success, error) = await PatientService.UpdatePatientAsync(PatientId, new UpdatePatientRequest
        {
            Id = PatientId,
            FullName = _profile.FullName,
            Phone = _profile.Phone,
            MobilePhone = _profile.MobilePhone,
            NationalId = _profile.NationalId,
            Email = _profile.Email,
            Address = _profile.Address,
            DateOfBirth = dateOfBirth,
            Gender = _profile.Gender,
            OptOutEmailCampaigns = _profile.OptOutEmailCampaigns
        });
        _saving = false;
        if (!success)
            ShowNotice(error: error);
        else
            ShowNotice(success: "Datos actualizados.");
    }

