    private Task ApprovePlanAsync(int id) => ChangePlanStatusAsync(id, "approve");
    private Task RejectPlanAsync(int id) => ChangePlanStatusAsync(id, "reject");
    private Task CompletePlanAsync(int id) => ChangePlanStatusAsync(id, "complete");

    private async Task ChangePlanStatusAsync(int id, string action)
    {
        _savingPlan = true;
        ClearNotice();
        (bool Success, string? Error) result = action switch
        {
            "approve" => await PlanService.ApproveAsync(id),
            "reject" => await PlanService.RejectAsync(id, _planRejectionReason),
            "complete" => await PlanService.CompleteAsync(id),
            _ => (false, "Acción no válida.")
        };
        _savingPlan = false;
        if (!result.Success)
        {
            ShowNotice(error: result.Error);
            return;
        }

        ShowNotice(success: "Estado del plan actualizado.");
        _planRejectionReason = null;
        await RefreshClinicalDataAsync(includeChart: false);
    }

    private async Task CreateTreatmentAsync()
    {
        var procedure = _activeProcedures.FirstOrDefault(x => x.Id == _treatmentProcedureId);
        if (procedure == null)
        {
            ShowNotice(error: "Seleccione un procedimiento activo.");
            return;
        }

        _savingTreatment = true;
        ClearNotice();
        var result = await TreatmentService.CreateTreatmentAsync(new CreateDentalTreatmentRequest
        {
            PatientId = PatientId,
            ProcedureName = procedure.Name,
            TreatmentProcedureId = procedure.Id,
            Cost = _treatmentCost,
            ToothNumber = _selectedTooth,
            ToothSurface = _selectedTooth.HasValue ? _selectedSurface : null,
            ProcedureDetails = _treatmentDetails,
            MedicalNotes = _treatmentMedicalNotes
        });
        _savingTreatment = false;
        if (!result.Success)
        {
            ShowNotice(error: result.Error);
            return;
        }

        ShowNotice(success: "Tratamiento creado.");
        _treatmentProcedureId = 0;
        _treatmentCost = 0;
        _treatmentDetails = null;
        _treatmentMedicalNotes = null;
        await RefreshClinicalDataAsync(includeChart: false);
    }

    private async Task StartTreatmentAsync(int id)
    {
        _savingTreatment = true;
        var result = await TreatmentService.StartTreatmentAsync(id);
        _savingTreatment = false;
        await FinishTreatmentOperationAsync(result, "Tratamiento iniciado.", false);
