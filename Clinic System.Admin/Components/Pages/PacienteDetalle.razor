    private async Task SaveEmergencyContactAsync()
    {
        if (string.IsNullOrWhiteSpace(_ecForm.FullName) || string.IsNullOrWhiteSpace(_ecForm.Phone) || string.IsNullOrWhiteSpace(_ecForm.Relationship))
        {
            _ecError = "Nombre, teléfono y parentesco son obligatorios.";
            return;
        }

        var nameError = PersonNameRules.Validate(_ecForm.FullName);
        if (nameError != null)
        {
            _ecError = nameError;
            return;
        }

        if (!PatientFieldLimits.IsValidPhone(_ecForm.Phone, required: true))
        {
            _ecError = $"El teléfono debe tener entre {PatientFieldLimits.PhoneMinDigits} y {PatientFieldLimits.PhoneMaxDigits} dígitos.";
            return;
        }

        _ecSaving = true;
        _ecError = null;

        if (_ecEditingId.HasValue)
        {
            var (ok, err) = await PatientService.UpdateEmergencyContactAsync(PatientId, _ecEditingId.Value, _ecForm);
            if (!ok) { _ecError = err; _ecSaving = false; return; }
        }
        else
        {
            var (ok, err, _) = await PatientService.CreateEmergencyContactAsync(PatientId, _ecForm);
            if (!ok) { _ecError = err; _ecSaving = false; return; }
        }

        CancelEmergencyContactForm();
        _ecSaving = false;
        await LoadEmergencyContactsAsync();
    }

