        _sendingEmail = false;
        _emailError = null;
        _emailTo = null;
        _emailSubject = null;
        _emailPreview = null;
    }

    private async Task SendEmailAsync()
    {
        if (string.IsNullOrEmpty(_emailTo) || string.IsNullOrEmpty(_emailSubject) || string.IsNullOrEmpty(_emailPreview))
            return;

        _sendingEmail = true;
        var (ok, error) = await BookingService.SendPatientEmailAsync(_emailTo, _emailSubject, _emailPreview);
        _sendingEmail = false;
        if (!ok)
        {
            _emailError = error ?? "No se pudo enviar el correo.";
            return;
        }

        CloseEmailModal();
    }

    private void OpenConfirmationDispatch()
    {
        if (_state.NotifyViaWhatsApp)
            OpenWhatsAppConfirmation();
        if (_state.NotifyViaEmail)
            OpenEmailConfirmation();
    }

    private async Task OpenAttendanceWhatsAppAsync()
    {
        if (_state.BookedAppointment == null)
            return;

        var (link, _, error) = await AttendanceService.CreatePublicLinkAsync(_state.BookedAppointment.Id, Navigation.BaseUri);
        if (string.IsNullOrWhiteSpace(link))
        {
            _whatsAppError = error ?? "No se pudo generar el enlace de asistencia.";
            _whatsAppUrl = null;
            _whatsAppPreview = null;
            _showWhatsAppModal = true;
            return;
        }

        var phone = !string.IsNullOrWhiteSpace(_state.SelectedPatient?.Phone)
            ? _state.SelectedPatient.Phone
            : _state.SelectedPatient?.MobilePhone;
        if (!WhatsAppMessageSettingsService.TryNormalizePhone(
                phone,
                WhatsAppSettings.Get().DefaultCountryCode,
                out var digits,
                out var phoneError))
        {
            _whatsAppError = phoneError;
            _whatsAppUrl = null;
            _whatsAppPreview = null;
        }
        else
        {
            _whatsAppError = null;
            _whatsAppPreview = BuildAttendanceConfirmationMessage(link);
            _whatsAppUrl = $"https://wa.me/{digits}?text={Uri.EscapeDataString(_whatsAppPreview)}";
        }

        _showWhatsAppModal = true;
    }

    private async Task OpenAttendanceEmailAsync()
    {
        if (_state.BookedAppointment == null)
            return;

        var (link, _, linkError) = await AttendanceService.CreatePublicLinkAsync(_state.BookedAppointment.Id, Navigation.BaseUri);
        if (string.IsNullOrWhiteSpace(link))
        {
            _emailError = linkError ?? "No se pudo generar el enlace de asistencia.";
            _emailTo = null;
            _emailSubject = null;
            _emailPreview = null;
            _showEmailModal = true;
            return;
        }

        var email = _state.SelectedPatient?.Email;
        if (!ContactEmail.TryValidate(email, out var normalizedEmail, out var emailError) || string.IsNullOrWhiteSpace(normalizedEmail))
        {
            _emailError = emailError ?? "El paciente no tiene correo válido.";
            _emailTo = null;
            _emailSubject = null;
            _emailPreview = null;
        }
        else
        {
            _emailError = null;
            _emailTo = normalizedEmail;
            _emailSubject = "Confirme su asistencia a la cita";
            _emailPreview = BuildAttendanceConfirmationMessage(link);
        }

        _showEmailModal = true;
    }

    private string BuildAttendanceConfirmationMessage(string link)
    {
        var when = _state.SelectedDate.HasValue && _state.SelectedTime.HasValue
            ? _state.SelectedDate.Value.Date.Add(_state.SelectedTime.Value)
            : (DateTime?)null;

        return $"""
            Hola {_state.SelectedPatient?.FullName}, confirme si asistirá a su cita en {WhatsAppSettings.Get().ClinicName}:

            Médico: {_state.SelectedDoctor?.FullName}
            Fecha: {(when.HasValue ? when.Value.ToString("dd/MM/yyyy") : "Pendiente")}
            Hora: {(when.HasValue ? when.Value.ToString("hh:mm tt") : "Pendiente")}

            Confirme aquí:
            {link}
            """;
    }

    private void ResetWizard()
    {
        _state.CurrentStep = 1;
        _state.SelectedPatient = null;
        _state.SelectedTreatment = null;
        _state.QuotedPriceInput = string.Empty;
        _state.SelectedDoctor = null;
        _state.SelectedDate = DateTime.Today;
        _state.SelectedTime = null;
        _state.Notes = string.Empty;
        _state.IsSuccess = false;
        _state.BookedAppointment = null;
        _error = null;
        CloseWhatsAppModal();
        CloseEmailModal();
    }

    private void PrevMonth() => _calendarMonth = _calendarMonth.AddMonths(-1);
    private void NextMonth() => _calendarMonth = _calendarMonth.AddMonths(1);

    private IEnumerable<DateTime?> GetCalendarDays()
    {
        var first = new DateTime(_calendarMonth.Year, _calendarMonth.Month, 1);
        var offset = ((int)first.DayOfWeek + 6) % 7;
        for (var i = 0; i < offset; i++) yield return null;
        for (var d = 1; d <= DateTime.DaysInMonth(_calendarMonth.Year, _calendarMonth.Month); d++)
            yield return new DateTime(_calendarMonth.Year, _calendarMonth.Month, d);
    }

    private string GetStepClass(int step) =>
        step < _state.CurrentStep ? "completed" : step == _state.CurrentStep ? "active" : "pending";

    private string GetDayClass(DateTime day)
    {
        if (_state.SelectedDate?.Date == day.Date)
            return "selected";
        if (!IsWorkingDay(day))
            return "closed";
        return "";
    }

    private static bool MatchesPatientSearch(PatientListItem patient, string search)
    {
        if (patient.FullName.Contains(search, StringComparison.OrdinalIgnoreCase))
            return true;

        if (patient.Id.ToString().Contains(search, StringComparison.OrdinalIgnoreCase)
            || $"P-{patient.Id:D4}".Contains(search, StringComparison.OrdinalIgnoreCase))
            return true;

        if (string.IsNullOrWhiteSpace(patient.NationalId))
            return false;

        if (patient.NationalId.Contains(search, StringComparison.OrdinalIgnoreCase))
            return true;

        var normalizedSearch = NormalizeId(search);
        return normalizedSearch.Length > 0
            && NormalizeId(patient.NationalId).Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeId(string value) =>
        string.Concat(value.Where(char.IsLetterOrDigit));

    private static string FormatPatientMeta(PatientListItem patient)
    {
        var cedula = string.IsNullOrWhiteSpace(patient.NationalId) ? "Sin cédula" : $"Céd. {patient.NationalId}";
        var age = GetAgeLabel(patient.DateOfBirth);
        return string.IsNullOrEmpty(age) ? cedula : $"{cedula} · {age}";
    }

    private static string GetAgeLabel(string? dateOfBirth)
    {
        if (string.IsNullOrWhiteSpace(dateOfBirth) || !DateTime.TryParse(dateOfBirth, out var birth))
            return string.Empty;

        var today = DateTime.Today;
        var years = today.Year - birth.Year;
        if (birth.Date > today.AddYears(-years))
            years--;

        if (years < 0)
            return string.Empty;

        return years == 1 ? "1 año" : $"{years} años";
    }

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));

    private static string GetAvatarClass(int index) => $"avatar-{index % 4}";

    private string FormatDate(DateTime? date) =>
        date?.ToString("d 'de' MMMM yyyy", _culture) ?? "—";

    private static string FormatTime(TimeSpan? time) =>
        time?.ToString(@"hh\:mm") ?? "—";

    private void OnNewPatientBirthChanged(ChangeEventArgs e)
    {
        if (!DateTime.TryParse(e.Value?.ToString(), out var birth))
            return;

        _newPatient.DateOfBirth = birth.Date;
        _newPatient.Age = GetAgeFromBirth(birth);
    }

    private string GetNewPatientAgeLabel()
    {
        var years = GetAgeFromBirth(_newPatient.DateOfBirth);
        if (years < 0)
            return "—";
        return years == 1 ? "1 año" : $"{years} años";
    }

    private static int GetAgeFromBirth(DateTime birth)
    {
        if (birth == default)
            return 0;

        var today = DateTime.Today;
        var years = today.Year - birth.Year;
        if (birth.Date > today.AddYears(-years))
            years--;
        return years;
    }

    private string GetAgendaLink()
    {
        if (_state.BookedAppointment == null || !_state.SelectedDate.HasValue)
            return "/agenda";

        var fecha = _state.SelectedDate.Value.ToString("yyyy-MM-dd");
        var id = _state.BookedAppointment.Id;
        return $"/agenda?fecha={fecha}&id={id}";
    }
}
