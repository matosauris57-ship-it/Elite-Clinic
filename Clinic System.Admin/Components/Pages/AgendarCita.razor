        else
            _patients.Insert(0, patient);
    }

    private bool CanGoNext() => _state.CurrentStep switch
    {
        1 => _state.SelectedPatient != null,
        2 => _state.SelectedTreatment != null && TryGetQuotedAmount(out _),
        3 => _state.SelectedDoctor != null,
        4 => _state.SelectedDate.HasValue && _state.SelectedTime.HasValue,
        5 => _state.SelectedPatient != null && _state.SelectedTreatment != null &&
             _state.SelectedDoctor != null && _state.SelectedDate.HasValue && _state.SelectedTime.HasValue &&
             TryGetQuotedAmount(out _),
        _ => false
    };

    private async Task NextStep()
    {
        _error = null;
        if (_state.CurrentStep == 3 && _state.SelectedDoctor != null)
            await LoadSlotsAsync();
        if (_state.CurrentStep < 5)
            _state.CurrentStep++;
    }

    private void PrevStep()
    {
        _error = null;
        if (_state.CurrentStep > 1)
            _state.CurrentStep--;
    }

    private async Task ConfirmBookingAsync()
    {
        if (_state.SelectedPatient == null || _state.SelectedDoctor == null ||
            !_state.SelectedDate.HasValue || !_state.SelectedTime.HasValue)
        {
            _error = "Faltan datos de la cita. Vuelva a los pasos anteriores y complete paciente, médico, fecha y hora.";
            await ShowBookingErrorAsync();
            return;
        }

        if (!TryGetQuotedAmount(out _))
        {
            _error = "Indique el precio del tratamiento en el paso 2.";
            await ShowBookingErrorAsync();
            return;
        }

        var appointmentDateTime = _state.SelectedDate.Value.Date.Add(_state.SelectedTime.Value);
        if (appointmentDateTime <= DateTime.Now)
        {
            _state.SelectedTime = null;
            _error = "Ese horario ya pasó. Vuelva al paso Fecha y Hora y seleccione un horario futuro.";
            await ShowBookingErrorAsync();
            return;
        }

        _booking = true;
        _error = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            var request = new BookAppointmentRequest
            {
                PatientId = _state.SelectedPatient.Id,
                DoctorId = _state.SelectedDoctor.Id,
                AppointmentDate = _state.SelectedDate.Value.Date,
                AppointmentTime = _state.SelectedTime.Value,
                TreatmentProcedureId = _state.SelectedTreatment?.Id,
                QuotedAmount = TryGetQuotedAmount(out var quoted) ? quoted : null
            };

            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            var (attempt, error) = await AuthService.WithTokenRetryAsync(
                async () =>
                {
                    var booked = await BookingService.BookAsync(request, timeout.Token);
                    return (booked, booked.Success ? null : booked.Error);
                },
                err => AuthService.IsTokenError(err));

            if (!attempt.Success || attempt.Result == null)
            {
                _error = error ?? "No se pudo agendar la cita.";

                if (attempt.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    Navigation.NavigateTo("/auth/logout", forceLoad: true);
                    return;
                }

                await ShowBookingErrorAsync();
                return;
            }

            _state.BookedAppointment = attempt.Result;
            _state.IsSuccess = true;
        }
        catch (Exception ex)
        {
            _error = $"No se pudo agendar la cita: {ex.Message}";
            await ShowBookingErrorAsync();
        }
        finally
        {
            _booking = false;
        }
    }

    private async Task ShowBookingErrorAsync()
