    protected override async Task OnInitializedAsync()
    {
        await AuthService.EnsureSessionLoadedAsync();
        await ApplyScheduleAsync();
        await ReloadPatientsAsync();
        await ReloadCatalogAsync();
        _doctors = await BookingService.GetDoctorsAsync();
        _loadingDoctors = false;

        ApplyBookingQuery();

        if (!_state.SelectedDate.HasValue)
            _state.SelectedDate = DateTime.Today;

        if (!IsWorkingDay(_state.SelectedDate.Value))
            _state.SelectedDate = NextOpenDay(_state.SelectedDate.Value);

        _calendarMonth = new DateTime(_state.SelectedDate.Value.Year, _state.SelectedDate.Value.Month, 1);

        if (_state.SelectedDoctor != null && _state.SelectedDate.HasValue)
            await LoadSlotsAsync();
