    private void ApplyBookingQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("fecha", out var fechaVal) &&
            DateTime.TryParseExact(fechaVal.ToString(), "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var fecha))
        {
            _state.SelectedDate = fecha.Date;
        }

        if (query.TryGetValue("hora", out var horaVal) && TimeSpan.TryParse(horaVal.ToString(), out var hora))
            _state.SelectedTime = hora;

        if (query.TryGetValue("medico", out var medicoVal) && int.TryParse(medicoVal.ToString(), out var doctorId))
            _state.SelectedDoctor = _doctors.FirstOrDefault(d => d.Id == doctorId);
    }

    private async Task ReloadCatalogAsync()
    {
        _loadingCatalog = true;
        _catalogLoadError = null;

        var (items, error) = await AuthService.WithTokenRetryAsync(
            async () =>
            {
                var result = await ProcedureService.GetActiveProceduresAsync();
                return (result.Items, result.Error);
            },
            AuthService.IsTokenError);

        _catalogItems = items.Select(p => new TreatmentCatalogItem
        {
            Id = p.Id,
            Category = p.Category,
            Name = p.Name,
            DurationMinutes = p.DurationMinutes
        }).ToList();

        _catalogLoadError = error;
        _loadingCatalog = false;
    }

    private void SelectPatient(PatientListItem patient) => _state.SelectedPatient = patient;

    private void SelectTreatment(TreatmentCatalogItem treatment)
    {
        var changed = _state.SelectedTreatment?.Id != treatment.Id;
        _state.SelectedTreatment = treatment;
        if (changed)
            _state.QuotedPriceInput = string.Empty;
    }

    private void SelectDoctor(DoctorListItem doctor) => _state.SelectedDoctor = doctor;

    private static string FormatCategory(string category) =>
        string.IsNullOrWhiteSpace(category) ? "General" : category.Replace('_', ' ');

    private bool TryGetQuotedAmount(out decimal amount)
    {
        amount = 0;
        return Money.TryParse(_state.QuotedPriceInput, out amount) && amount > 0;
    }

    private string FormatSelectedTreatmentPrice() =>
        TryGetQuotedAmount(out var amount) ? Money.Format(amount) : "Pendiente";

    private async Task ApplyScheduleAsync()
    {
        var (schedule, _) = await BookingService.GetClinicScheduleAsync();
        if (schedule != null)
            _schedule = schedule;

        _allSlots = AppointmentBookingService.GenerateAllSlots(
            _schedule.OpenTime,
            _schedule.CloseTime,
            _schedule.SlotDurationMinutes);
    }

    private bool IsWorkingDay(DateTime day) => _schedule.IsOpenOn(day);

    private DateTime NextOpenDay(DateTime from)
    {
        for (var i = 0; i < 14; i++)
        {
            var candidate = from.Date.AddDays(i);
            if (candidate >= DateTime.Today && IsWorkingDay(candidate))
                return candidate;
        }

        return from.Date;
    }

    private async Task SelectDate(DateTime date)
    {
        _state.SelectedDate = date;
        _state.SelectedTime = null;
        await LoadSlotsAsync();
    }

    private void SelectTime(TimeSpan time) => _state.SelectedTime = time;

    private async Task LoadSlotsAsync()
    {
        if (_state.SelectedDoctor == null || !_state.SelectedDate.HasValue) return;
        _loadingSlots = true;
        _availableSlots = await BookingService.GetAvailableSlotsAsync(_state.SelectedDoctor.Id, _state.SelectedDate.Value);
        if (_state.SelectedDate.Value.Date == DateTime.Today)
        {
            _availableSlots = _availableSlots
                .Where(slot => DateTime.Today.Add(slot) > DateTime.Now)
                .ToList();
        }
        _loadingSlots = false;
    }

    private async Task CreatePatientAsync()
    {
        _error = null;
        _successMessage = null;
        if (string.IsNullOrWhiteSpace(_newPatient.FullName) || string.IsNullOrWhiteSpace(_newPatient.Phone))
        {
            _error = "Nombre y teléfono son obligatorios.";
            return;
        }

        var nationalId = _newPatient.NationalId?.Trim();
        if (string.IsNullOrWhiteSpace(nationalId))
        {
            _error = "La cédula es obligatoria.";
            return;
        }

        if (_newPatient.DateOfBirth == default || _newPatient.DateOfBirth.Date >= DateTime.Today)
        {
            _error = "Indique una fecha de nacimiento válida.";
            return;
        }

        var age = GetAgeFromBirth(_newPatient.DateOfBirth);
        if (age is < 1 or > 120)
        {
            _error = "La edad debe estar entre 1 y 120 años.";
            return;
        }

        var phoneDigits = new string(_newPatient.Phone.Where(char.IsDigit).ToArray());
        if (phoneDigits.Length is < 10 or > 15)
        {
            _error = "El teléfono debe tener entre 10 y 15 dígitos.";
            return;
        }

        if (!ContactEmail.TryValidate(_newPatient.Email, out var email, out var emailError))
        {
            _error = emailError;
            return;
        }
        _newPatient.Email = email;

        _creatingPatient = true;
        _newPatient.NationalId = nationalId;
        _newPatient.Phone = phoneDigits;
        _newPatient.Age = age;
        _newPatient.MobilePhone = string.IsNullOrWhiteSpace(_newPatient.MobilePhone) ? null : _newPatient.MobilePhone.Trim();
        if (string.IsNullOrWhiteSpace(_newPatient.Address)) _newPatient.Address = "Sin dirección";

        var (success, error, patient) = await BookingService.CreatePatientAsync(_newPatient);
        _creatingPatient = false;

        if (!success || patient == null)
        {
            _error = error ?? "Error al crear paciente.";
            return;
