@page "/agendar-cita"
@using Clinic_System.Core.Finance
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "agendar-cita.view")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AppointmentBookingService BookingService
@inject TreatmentProcedureMaintenanceService ProcedureService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject WhatsAppMessageSettingsService WhatsAppSettings
@inject EmailMessageSettingsService EmailMessageSettings
@inject AttendanceConfirmationService AttendanceService
@inject IJSRuntime JS

<PageTitle>Agendar Cita — DentalCare Admin</PageTitle>

@if (_state.IsSuccess && _state.BookedAppointment != null)
{
    <div class="appointment-success">
        <div class="success-card">
            <div class="success-icon-wrap">
                <Icon Name="check-circle-2" Class="success-icon" StrokeWidth="1.5" />
            </div>
            <h1>¡Cita Agendada con Éxito!</h1>
            <p>La cita ha sido registrada en el sistema. Se enviará una confirmación al paciente.</p>

            <div class="success-summary">
                <div class="summary-row"><span>ID de cita</span><strong>#@_state.BookedAppointment.Id</strong></div>
                <div class="summary-row"><span>Paciente</span><strong>@_state.SelectedPatient?.FullName</strong></div>
                <div class="summary-row"><span>Tratamiento</span><strong>@_state.SelectedTreatment?.Name</strong></div>
                <div class="summary-row"><span>Precio</span><strong>@FormatSelectedTreatmentPrice()</strong></div>
                <div class="summary-row"><span>Médico</span><strong>@_state.SelectedDoctor?.FullName</strong></div>
                <div class="summary-row"><span>Fecha</span><strong>@FormatDate(_state.SelectedDate)</strong></div>
                <div class="summary-row"><span>Hora</span><strong>@FormatTime(_state.SelectedTime)</strong></div>
                <div class="summary-row"><span>Sala</span><strong>@_state.Room</strong></div>
            </div>

            <div class="success-actions">
                @if (_state.ReminderEnabled && (_state.NotifyViaWhatsApp || _state.NotifyViaEmail))
                {
                    <button class="btn-primary" @onclick="OpenConfirmationDispatch">
                        <Icon Name="bell" Class="btn-svg" />
                        Enviar confirmación
                    </button>
                }
                <button class="btn-outline" @onclick="OpenAttendanceWhatsAppAsync">
                    <Icon Name="message-circle" Class="btn-svg" />
                    Enlace asistencia WhatsApp
                </button>
                <button class="btn-outline" @onclick="OpenAttendanceEmailAsync">
                    <Icon Name="mail" Class="btn-svg" />
                    Enlace asistencia correo
                </button>
                <button class="btn-outline" @onclick="ResetWizard">
                    <Icon Name="calendar-plus" Class="btn-svg" />
                    Agendar otra
                </button>
                <a href="@GetAgendaLink()" class="btn-outline">
                    <Icon Name="calendar" Class="btn-svg" />
                    Ver agenda
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="appointment-page">
        <div class="appointment-header">
            <h1>Agendar Nueva Cita</h1>
            <p>Completa los pasos para registrar la cita en el sistema</p>
        </div>

        <div class="appointment-wizard">
            <aside class="wizard-stepper">
                @foreach (var step in _steps)
                {
                    <div class="wizard-step @GetStepClass(step.Number)">
                        <div class="step-icon-wrap">
                            @if (step.Number < _state.CurrentStep)
                            {
                                <Icon Name="check" Class="step-icon" StrokeWidth="2.5" />
                            }
                            else
                            {
                                <Icon Name="@step.Icon" Class="step-icon" />
                            }
                        </div>
                        <div class="step-text">
                            <span class="step-label">PASO @step.Number</span>
                            <span class="step-name">@step.Name</span>
                        </div>
                    </div>
                }

                @if (_state.SelectedTreatment != null)
                {
                    <div class="wizard-mini-summary">
                        <span class="mini-label">RESUMEN</span>
                        <div>@_state.SelectedTreatment.Name</div>
                        <div>@FormatSelectedTreatmentPrice()</div>
                        <div class="mini-muted">@_state.SelectedTreatment.DurationMinutes min</div>
                        @if (_state.SelectedDoctor != null)
                        {
                            <div>@_state.SelectedDoctor.FullName</div>
                        }
                        @if (_state.SelectedDate.HasValue)
                        {
                            <div>@FormatDate(_state.SelectedDate)</div>
                        }
                        @if (_state.SelectedTime.HasValue)
                        {
                            <div>@FormatTime(_state.SelectedTime)</div>
                        }
                    </div>
                }
            </aside>

            <div class="wizard-main">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="wizard-error">@_error</div>
                }
                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="wizard-success">@_successMessage</div>
                }

                @switch (_state.CurrentStep)
                {
                    case 1:
                        <div class="step-content">
                            <div class="step-head">
                                <h2>Seleccionar Paciente</h2>
                                <p>Elige un paciente existente o registra uno nuevo</p>
                            </div>
                            <div class="tab-toggle">
                                <button class="tab-btn @(_patientTab == "existing" ? "active" : "")" @onclick="ShowExistingPatientsAsync">Paciente existente</button>
                                <button class="tab-btn @(_patientTab == "new" ? "active" : "")" @onclick='() => _patientTab = "new"'>Nuevo paciente</button>
                            </div>

                            @if (_patientTab == "existing")
                            {
                                <div class="search-field">
                                    <Icon Name="search" Class="field-icon" />
                                    <input type="text" placeholder="Buscar paciente por nombre, cédula o ID..." @bind="_patientSearch" @bind:event="oninput" />
                                </div>
                                <div class="patient-list">
                                    @if (_loadingPatients)
                                    {
                                        <AnimatedLoader Compact="true" Message="Cargando pacientes..." />
                                    }
                                    else if (!string.IsNullOrEmpty(_patientsLoadError))
                                    {
                                        <div class="wizard-empty wizard-error-text">@_patientsLoadError</div>
                                    }
                                    else if (!FilteredPatients.Any())
                                    {
                                        <div class="wizard-empty">No hay pacientes. Registra uno nuevo.</div>
                                    }
                                    else
                                    {
                                        @foreach (var (patient, index) in FilteredPatients.Select((p, i) => (p, i)))
                                        {
                                            <button class="patient-card @(_state.SelectedPatient?.Id == patient.Id ? "selected" : "")"
                                                    @onclick="() => SelectPatient(patient)">
                                                <span class="avatar @GetAvatarClass(index)">@GetInitials(patient.FullName)</span>
                                                <span class="patient-info">
                                                    <span class="patient-name">@patient.FullName</span>
                                                    <span class="patient-id">@FormatPatientMeta(patient)</span>
                                                </span>
                                            </button>
                                        }
                                    }
                                </div>
                                @if (_state.SelectedPatient != null)
                                {
                                    <PatientClinicalHistoryPanel PatientId="_state.SelectedPatient.Id"
                                                                 PatientName="@_state.SelectedPatient.FullName"
                                                                 Collapsible="true" />
                                }
                            }
                            else
                            {
                                <form class="new-patient-card" @onsubmit="CreatePatientAsync" @onsubmit:preventDefault>
                                    <div class="np-banner">
                                        <span class="np-banner-icon">
                                            <Icon Name="user-plus" Class="np-banner-svg" />
                                        </span>
                                        <div>
                                            <strong>Ficha del paciente</strong>
                                            <p>Registra identidad y contacto. La cédula es obligatoria para facturas y recetas.</p>
                                        </div>
                                    </div>

                                    <section class="np-section">
                                        <h3 class="np-section-title">Identidad</h3>
                                        <div class="np-grid">
                                            <div class="form-group np-span-2">
                                                <label>Nombre completo <span class="np-req">*</span></label>
                                                <input class="form-input" @bind="_newPatient.FullName" placeholder="Nombre y apellidos" autocomplete="name" />
                                            </div>
                                            <div class="form-group">
                                                <label>Cédula <span class="np-req">*</span></label>
                                                <input class="form-input" @bind="_newPatient.NationalId" placeholder="000-0000000-0" maxlength="20" autocomplete="off" />
                                            </div>
                                            <div class="form-group">
                                                <label>Fecha de nacimiento <span class="np-req">*</span></label>
                                                <input class="form-input" type="date"
                                                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                                       value="@_newPatient.DateOfBirth.ToString("yyyy-MM-dd")"
                                                       @onchange="OnNewPatientBirthChanged" />
                                            </div>
                                            <div class="form-group">
                                                <label>Edad</label>
                                                <input class="form-input" readonly value="@GetNewPatientAgeLabel()" />
                                            </div>
                                            <div class="form-group np-span-2">
                                                <label>Género</label>
                                                <div class="np-segment" role="group" aria-label="Género">
                                                    <button type="button"
                                                            class="np-segment-btn @(_newPatient.Gender == "Male" ? "active" : "")"
                                                            @onclick='() => _newPatient.Gender = "Male"'>Masculino</button>
                                                    <button type="button"
                                                            class="np-segment-btn @(_newPatient.Gender == "Female" ? "active" : "")"
                                                            @onclick='() => _newPatient.Gender = "Female"'>Femenino</button>
                                                </div>
                                            </div>
                                        </div>
                                    </section>

                                    <section class="np-section">
                                        <h3 class="np-section-title">Contacto</h3>
                                        <div class="np-grid">
                                            <div class="form-group">
                                                <label>Teléfono <span class="np-req">*</span></label>
                                                <input class="form-input" @bind="_newPatient.Phone" placeholder="809 555 1234" inputmode="tel" autocomplete="tel" />
                                            </div>
                                            <div class="form-group">
                                                <label>Celular</label>
                                                <input class="form-input" @bind="_newPatient.MobilePhone" placeholder="Opcional" inputmode="tel" />
                                            </div>
                                            <div class="form-group np-span-2">
                                                <label>Correo</label>
                                                <input class="form-input" type="email" @bind="_newPatient.Email" placeholder="Opcional — paciente@correo.com" autocomplete="email" />
                                            </div>
                                            <div class="form-group np-span-2">
                                                <label>Dirección</label>
                                                <input class="form-input" @bind="_newPatient.Address" placeholder="Calle, sector, ciudad" autocomplete="street-address" />
                                            </div>
                                        </div>
                                    </section>

                                    <div class="np-actions">
                                        <p class="np-hint">Después de registrar, continúa con el tratamiento.</p>
                                        <button type="submit" class="btn-primary np-submit" disabled="@_creatingPatient">
                                            <Icon Name="user-plus" Class="btn-svg" />
                                            @(_creatingPatient ? "Registrando..." : "Registrar paciente")
                                        </button>
                                    </div>
                                </form>
                            }
                        </div>
                        break;

                    case 2:
                        <div class="step-content">
                            <div class="step-head">
                                <h2>Tipo de tratamiento</h2>
                                <p>Elige el procedimiento. El precio se indica aquí, para esta cita.</p>
                            </div>
                            <div class="treatment-toolbar">
                                <div class="search-field treatment-search">
                                    <Icon Name="search" Class="field-icon" />
                                    <input type="text" placeholder="Buscar por nombre o categoría..." @bind="_treatmentSearch" @bind:event="oninput" />
                                </div>
                                <div class="treatment-chips">
                                    <button type="button" class="treatment-chip @(string.IsNullOrEmpty(_treatmentCategoryFilter) ? "active" : "")"
                                            @onclick='() => _treatmentCategoryFilter = string.Empty'>Todos</button>
                                    @foreach (var category in TreatmentCategories)
                                    {
                                        <button type="button" class="treatment-chip @(_treatmentCategoryFilter == category ? "active" : "")"
                                                @onclick="() => _treatmentCategoryFilter = category">@FormatCategory(category)</button>
                                    }
                                </div>
                            </div>
                            <div class="treatment-grid">
                                @if (_loadingCatalog)
                                {
                                    <AnimatedLoader Compact="true" Message="Cargando tratamientos..." />
                                }
                                else if (!string.IsNullOrEmpty(_catalogLoadError))
                                {
                                    <div class="wizard-error">@_catalogLoadError</div>
                                }
                                else if (!FilteredTreatments.Any())
                                {
                                    <div class="wizard-empty">No hay tratamientos activos en el catálogo.</div>
                                }
                                else
                                {
                                    @foreach (var treatment in FilteredTreatments)
                                    {
                                        var selected = _state.SelectedTreatment?.Id == treatment.Id;
                                        <button type="button" class="treatment-card @(selected ? "selected" : "")"
                                                @onclick="() => SelectTreatment(treatment)">
                                            <span class="treatment-cat">@FormatCategory(treatment.Category)</span>
                                            <span class="treatment-name">@treatment.Name</span>
                                            <div class="treatment-meta">
                                                <span class="treatment-duration">
                                                    <Icon Name="clock" Class="treatment-duration-icon" />
                                                    @treatment.DurationMinutes min
                                                </span>
                                                @if (selected)
                                                {
                                                    <span class="treatment-selected-mark">Seleccionado</span>
                                                }
                                            </div>
                                        </button>
                                    }
                                }
                            </div>
                            @if (_state.SelectedTreatment != null)
                            {
                                <div class="treatment-quote">
                                    <div class="treatment-quote-copy">
                                        <span class="treatment-quote-kicker">Precio de esta cita</span>
                                        <strong>@_state.SelectedTreatment.Name</strong>
                                        <p>Ingresa el monto a cobrar. No está predefinido en el catálogo.</p>
                                    </div>
                                    <label class="treatment-quote-field">
                                        <span>RD$</span>
                                        <input class="form-input" type="text" inputmode="decimal" autocomplete="off"
                                               placeholder="0.00" @bind="_state.QuotedPriceInput" @bind:event="oninput" />
                                    </label>
                                </div>
                            }
                        </div>
                        break;

                    case 3:
                        <div class="step-content">
                            <div class="step-head">
                                <h2>Seleccionar Médico</h2>
                                <p>Elige el profesional que atenderá la cita</p>
                            </div>
                            <div class="doctor-list-wizard">
                                @if (_loadingDoctors)
                                {
                                    <AnimatedLoader Compact="true" Message="Cargando médicos..." />
                                }
                                else if (!_doctors.Any())
                                {
                                    <div class="wizard-empty">No hay médicos registrados en el sistema.</div>
                                }
                                else
                                {
                                    @foreach (var (doctor, index) in _doctors.Select((d, i) => (d, i)))
                                    {
                                        <button class="doctor-card @(_state.SelectedDoctor?.Id == doctor.Id ? "selected" : "")"
                                                @onclick="() => SelectDoctor(doctor)">
                                            <span class="avatar @GetAvatarClass(index)">@GetInitials(doctor.FullName)</span>
                                            <span class="doctor-info">
                                                <span class="doctor-name">@doctor.FullName</span>
                                                <span class="doctor-spec">@doctor.Specialization</span>
                                            </span>
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                        break;

                    case 4:
                        <div class="step-content">
                            <div class="step-head">
                                <h2>Fecha y Hora</h2>
                                <p>Selecciona el día y horario disponible</p>
                            </div>
                            <div class="datetime-layout">
                                <div class="mini-calendar">
                                    <div class="cal-header">
                                        <button class="cal-nav" @onclick="PrevMonth">‹</button>
                                        <span>@_calendarMonth.ToString("MMMM yyyy", _culture)</span>
                                        <button class="cal-nav" @onclick="NextMonth">›</button>
                                    </div>
                                    <div class="cal-weekdays">
                                        @foreach (var d in _weekDays)
                                        {
                                            <span>@d</span>
                                        }
                                    </div>
                                    <div class="cal-days">
                                        @foreach (var day in GetCalendarDays())
                                        {
                                            if (day == null)
                                            {
                                                <span class="cal-day empty"></span>
                                            }
                                            else
                                            {
                                                <button class="cal-day @GetDayClass(day.Value)"
                                                        disabled="@(day.Value < DateTime.Today || !IsWorkingDay(day.Value))"
                                                        @onclick="() => SelectDate(day.Value)">
                                                    @day.Value.Day
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="slots-panel">
                                    <h3>HORARIOS DISPONIBLES — @FormatDate(_state.SelectedDate)</h3>
                                    @if (!_state.SelectedDate.HasValue)
                                    {
                                        <p class="slots-hint">Selecciona una fecha en el calendario</p>
                                    }
                                    else if (_loadingSlots)
                                    {
                                        <AnimatedLoader Compact="true" Message="Cargando horarios..." />
                                    }
                                    else
                                    {
                                        @if (_state.SelectedDate.HasValue && !IsWorkingDay(_state.SelectedDate.Value))
                                        {
                                            <p class="slots-hint">La clínica no abre este día. Elija un día laboral.</p>
                                        }
                                        else if (!VisibleSlots.Any())
                                        {
                                            <p class="slots-hint">No hay horarios disponibles en este día. Pruebe otra fecha.</p>
                                        }
                                        else
                                        {
                                            <div class="slots-grid">
                                                @foreach (var slot in VisibleSlots)
                                                {
                                                    var available = _availableSlots.Contains(slot);
                                                    var selected = _state.SelectedTime == slot;
                                                    <button type="button" class="slot-btn @(available ? "available" : "occupied") @(selected ? "selected" : "")"
                                                            disabled="@(!available)"
                                                            @onclick="() => SelectTime(slot)">
                                                        @if (!available) { <span class="slot-dot occupied"></span> }
                                                        else if (selected) { <span class="slot-dot available"></span> }
                                                        <span class="@(!available ? "struck" : "")">@slot.ToString(@"hh\:mm")</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                        <div class="slots-legend">
                                            <span><i class="slot-dot available"></i> Disponible</span>
                                            <span><i class="slot-dot occupied"></i> Ocupado</span>
                                        </div>
                                    }
                                    <label class="notes-label">NOTAS ADICIONALES (OPCIONAL)</label>
                                    <textarea class="notes-input" placeholder="Indicaciones especiales, preparación previa, alertas..."
                                              @bind="_state.Notes"></textarea>
                                </div>
                            </div>
                        </div>
                        break;

                    case 5:
                        <div class="step-content">
                            <div class="step-head">
                                <h2>Confirmar Cita</h2>
                                <p>Revisa los detalles antes de agendar</p>
                            </div>
                            <div class="confirm-box">
                                <span class="confirm-label">RESUMEN DE LA CITA</span>
                                <div class="confirm-grid">
                                    <div><span>PACIENTE</span><strong>@_state.SelectedPatient?.FullName</strong></div>
                                    <div><span>TRATAMIENTO</span><strong>@_state.SelectedTreatment?.Name</strong></div>
                                    <div><span>MÉDICO</span><strong>@_state.SelectedDoctor?.FullName</strong></div>
                                    <div><span>SALA</span><strong>@_state.Room</strong></div>
                                    <div><span>FECHA</span><strong class="accent-purple">@FormatDate(_state.SelectedDate)</strong></div>
                                    <div><span>HORA</span><strong class="accent-purple">@FormatTime(_state.SelectedTime)</strong></div>
                                    <div><span>DURACIÓN</span><strong class="accent-yellow">@(_state.SelectedTreatment?.DurationMinutes ?? 0) min</strong></div>
                                    <div><span>PRECIO</span><strong class="accent-green">@FormatSelectedTreatmentPrice()</strong></div>
                                </div>
                            </div>
                            @if (_state.SelectedPatient != null)
                            {
                                <PatientClinicalHistoryPanel PatientId="_state.SelectedPatient.Id"
                                                             PatientName="@_state.SelectedPatient.FullName"
                                                             Collapsible="true" />
                            }
                            <div class="reminder-section">
                                <div class="reminder-head">
                                    <Icon Name="bell" Class="reminder-icon" />
                                    <span>Enviar confirmación al paciente</span>
                                    <label class="ai-toggle small">
                                        <input type="checkbox" @bind="_state.ReminderEnabled" />
                                        <span class="ai-slider"></span>
                                    </label>
                                </div>
                                <p class="reminder-hint">Puede elegir WhatsApp, correo, o ambos.</p>
                                <div class="reminder-channels">
                                    <button type="button"
                                            class="channel-btn @(_state.NotifyViaWhatsApp ? "active" : "")"
                                            disabled="@(!_state.ReminderEnabled)"
                                            @onclick="() => _state.NotifyViaWhatsApp = !_state.NotifyViaWhatsApp">
                                        WhatsApp
                                    </button>
                                    <button type="button"
                                            class="channel-btn @(_state.NotifyViaEmail ? "active" : "")"
                                            disabled="@(!_state.ReminderEnabled)"
                                            @onclick="() => _state.NotifyViaEmail = !_state.NotifyViaEmail">
                                        Correo
                                    </button>
                                </div>
                                @if (_state.ReminderEnabled && !_state.NotifyViaWhatsApp && !_state.NotifyViaEmail)
                                {
                                    <p class="reminder-hint reminder-hint-warn">Seleccione al menos un canal.</p>
                                }
                            </div>
                        </div>
                        break;
                }

                <div class="wizard-footer">
                    <button type="button" class="btn-ghost" disabled="@(_state.CurrentStep == 1)" @onclick="PrevStep">
                        <Icon Name="chevron-left" Class="btn-svg" />
                        Anterior
                    </button>
                    <div class="wizard-dots">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <span class="dot @(i == _state.CurrentStep ? "active" : i < _state.CurrentStep ? "done" : "")"></span>
                        }
                    </div>
                    @if (_state.CurrentStep < 5)
                    {
                        <button type="button" class="btn-primary" disabled="@(!CanGoNext())" @onclick="NextStep">
                            Siguiente
                            <Icon Name="chevron-right" Class="btn-svg" StrokeWidth="2" />
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn-primary" disabled="@(_booking || !CanGoNext())" @onclick="ConfirmBookingAsync">
                            <Icon Name="check" Class="btn-svg" StrokeWidth="2.5" />
                            @(_booking ? "Agendando..." : "Confirmar Cita")
                        </button>
                    }
                </div>
                @if (_state.CurrentStep == 5 && !string.IsNullOrEmpty(_error))
                {
                    <div id="booking-error" class="wizard-error" role="alert">@_error</div>
                }
            </div>
        </div>
    </div>
}

@if (_showWhatsAppModal)
{
    <div class="modal-overlay" @onclick="CloseWhatsAppModal">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Confirmación WhatsApp</h2>
                <button class="modal-close" @onclick="CloseWhatsAppModal">×</button>
            </div>
            @if (!string.IsNullOrEmpty(_whatsAppError))
            {
                <div class="wizard-error">@_whatsAppError</div>
            }
            else
            {
                <p class="modal-confirm-text">Revise el mensaje y pulse Enviar en WhatsApp. El sistema no lo envía solo.</p>
                <div class="whatsapp-message-box">@_whatsAppPreview</div>
            }
            <div class="modal-actions">
                <button class="btn-outline" @onclick="CloseWhatsAppModal">Cancelar</button>
                <button class="btn-primary" disabled="@(string.IsNullOrEmpty(_whatsAppUrl))" @onclick="OpenWhatsAppAsync">Abrir WhatsApp</button>
            </div>
        </div>
    </div>
}

@if (_showEmailModal)
{
    <div class="modal-overlay" @onclick="CloseEmailModal">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Confirmación por correo</h2>
                <button class="modal-close" @onclick="CloseEmailModal">×</button>
            </div>
            @if (!string.IsNullOrEmpty(_emailError))
            {
                <div class="wizard-error">@_emailError</div>
            }
            else
            {
                <p class="modal-confirm-text">Se enviará a <strong>@_emailTo</strong>. Revise el mensaje antes de enviarlo.</p>
                <div class="whatsapp-message-box">@_emailPreview</div>
            }
            <div class="modal-actions">
                <button class="btn-outline" @onclick="CloseEmailModal">Cancelar</button>
                <button class="btn-primary" disabled="@(_sendingEmail || string.IsNullOrEmpty(_emailTo) || !string.IsNullOrEmpty(_emailError))" @onclick="SendEmailAsync">
                    @(_sendingEmail ? "Enviando..." : "Enviar correo")
                </button>
            </div>
            @if (_sendingEmail)
            {
                <AnimatedLoader Overlay="true" Message="Enviando correo..." />
            }
        </div>
    </div>
}

