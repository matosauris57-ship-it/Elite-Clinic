@page "/pacientes"
@using Microsoft.AspNetCore.Components.Forms
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "pacientes.view")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Clinic_System.Core.Finance
@inject PatientMaintenanceService PatientService
@inject AuthService AuthService
@inject PermissionService PermissionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Pacientes — DentalCare Admin</PageTitle>

<div class="maintenance-page">
    <div class="maintenance-header command-header">
        <div class="command-titles">
            <h1>Pacientes</h1>
            <p>Gestión de pacientes y fichas clínicas</p>
        </div>
        @if (_canCreate)
        {
            <div class="command-actions">
                <button class="btn-outline" @onclick="OpenImportModal">
                    <Icon Name="upload" Class="btn-svg" /> Importar CSV
                </button>
                <button class="btn-primary" @onclick="OpenCreateModal">
                    <Icon Name="plus" Class="btn-svg" /> Nuevo paciente
                </button>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_loadError))
    {
        <ErrorBanner Message="@_loadError" OnRetry="ReloadAsync" />
    }

    <div class="maintenance-toolbar">
        <div class="maintenance-toolbar-left">
            <div class="search-field maintenance-search">
                <Icon Name="search" Class="field-icon" />
                <input type="text"
                       placeholder="Buscar por nombre, cédula, teléfono o correo..."
                       disabled="@_loading"
                       value="@_search"
                       @oninput="OnSearchInput" />
            </div>
            <div class="maintenance-status-toggles">
                <button class="toggle-btn @(_statusFilter == "all" ? "active" : "")" disabled="@_loading" @onclick='() => SetStatusFilterAsync("all")'>Todos</button>
                <button class="toggle-btn @(_statusFilter == "active" ? "active" : "")" disabled="@_loading" @onclick='() => SetStatusFilterAsync("active")'>Activos</button>
                <button class="toggle-btn @(_statusFilter == "inactive" ? "active" : "")" disabled="@_loading" @onclick='() => SetStatusFilterAsync("inactive")'>Inactivos</button>
            </div>
            <div class="form-group" style="margin:0; min-width:7rem;">
                <select class="form-input" disabled="@_loading" @bind="_pageSize" @bind:after="OnPageSizeChangedAsync">
                    <option value="10">10 / pág.</option>
                    <option value="20">20 / pág.</option>
                    <option value="50">50 / pág.</option>
                </select>
            </div>
        </div>
        <span class="maintenance-count">@_totalCount paciente(s) · pág. @_pageNumber/@TotalPages</span>
    </div>

    @if (_loading) { <AnimatedLoader Message="Cargando pacientes..." /> }
    else if (!_patients.Any() && string.IsNullOrEmpty(_loadError))
    {
        <div class="maintenance-empty"><p>No hay pacientes con los filtros actuales.</p></div>
    }
    else
    {
        <div class="data-table-wrap">
            <table class="data-table patients-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Cédula</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th class="col-age">Edad</th>
                        <th>Estado</th>
                        @if (_canViewFacturas)
                        {
                            <th class="col-debt">Deuda</th>
                        }
                        <th class="col-actions">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _patients)
                    {
                        var email = DisplayEmail(p);
                        <tr class="@(p.IsActive ? null : "table-row-inactive")">
                            <td>
                                <button type="button" class="table-patient-link" @onclick="() => GoToPatient(p.Id)">
                                    <span class="avatar avatar-sm avatar-@((p.Id % 4))">@GetInitials(p.FullName)</span>
                                    <span class="table-patient-copy">
                                        <strong>@p.FullName</strong>
                                        <span class="table-patient-sub">Abrir ficha clínica</span>
                                    </span>
                                </button>
                            </td>
                            <td class="table-id-cell">@(string.IsNullOrWhiteSpace(p.NationalId) ? "—" : p.NationalId)</td>
                            <td>@Dash(p.Phone)</td>
                            <td class="col-email">
                                @if (string.IsNullOrWhiteSpace(email))
                                {
                                    <span class="table-muted">—</span>
                                }
                                else
                                {
                                    <a class="table-email" href="mailto:@email" title="@email" @onclick:stopPropagation="true">@email</a>
                                }
                            </td>
                            <td class="col-age">@GetAge(p.DateOfBirth)</td>
                            <td>
                                <span class="status-badge @(p.IsActive ? "status-active" : "status-inactive")">
                                    @(p.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            @if (_canViewFacturas)
                            {
                                <td class="col-debt">
                                    @if (p.OutstandingBalance > 0)
                                    {
                                        <button type="button"
                                                class="status-badge status-debt"
                                                title="Ver facturas pendientes"
                                                @onclick="() => GoToPatientDebt(p.Id)">
                                            Pendiente · @Money.Format(p.OutstandingBalance)
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="table-muted">Sin deuda</span>
                                    }
                                </td>
                            }
                            <td class="col-actions">
                                <div class="table-actions">
                                    <button class="btn-table btn-table-primary" @onclick="() => GoToPatient(p.Id)">Ver ficha</button>
                                    @if (_canEdit && p.IsActive)
                                    {
                                        <button class="btn-table" @onclick="() => OpenEditModal(p)">Editar</button>
                                    }
                                    @if (_canDelete && p.IsActive)
                                    {
                                        <button class="btn-table btn-table-danger" @onclick="() => OpenDisableModal(p)">Deshabilitar</button>
                                    }
                                    @if (_canEdit && !p.IsActive)
                                    {
                                        <button class="btn-table" @onclick="() => OpenEnableModal(p)">Reactivar</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="billing-pagination">
            <button class="btn-outline" disabled="@(_loading || _pageNumber <= 1)" @onclick="PrevPageAsync">Anterior</button>
            <span>Página @_pageNumber de @TotalPages</span>
            <button class="btn-outline" disabled="@(_loading || _pageNumber >= TotalPages)" @onclick="NextPageAsync">Siguiente</button>
        </div>
    }
</div>

@if (_showFormModal)
{
    <div class="modal-overlay" @onclick="CloseFormModal">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(_isEdit ? "Editar paciente" : "Nuevo paciente")</h2>
                <button class="modal-close" @onclick="CloseFormModal">×</button>
            </div>
            @if (!string.IsNullOrEmpty(_formError)) { <div class="wizard-error">@_formError</div> }
            <DuplicateCedulaBanner PatientId="_duplicatePatientId" />
            @if (!string.IsNullOrEmpty(_fieldLimitToast))
            {
                <div class="wizard-error">@_fieldLimitToast</div>
            }
            @if (_isEdit)
            {
                <div class="new-patient-form">
                    <div class="form-row">
                        <div class="form-group"><label>Nombre</label><input class="form-input" maxlength="@PatientFieldLimits.FullName" value="@_editForm.FullName" @oninput="e => _editForm.FullName = LimitName(e)" /></div>
                        <div class="form-group"><label>Cédula</label><input class="form-input" maxlength="@PatientFieldLimits.NationalId" value="@_editForm.NationalId" @oninput="e => _editForm.NationalId = LimitCedula(e)" /></div>
                    </div>
                    <div class="form-group"><label>Teléfono</label><input class="form-input" maxlength="@PatientFieldLimits.Phone" inputmode="tel" value="@_editForm.Phone" @oninput="e => _editForm.Phone = LimitPhone(e)" /></div>
                    <div class="form-group"><label>Correo (opcional)</label><input class="form-input" type="email" maxlength="@PatientFieldLimits.Email" value="@_editForm.Email" placeholder="paciente@correo.com" @oninput="e => _editForm.Email = LimitEmail(e)" /></div>
                    <div class="form-group"><label>Dirección</label><input class="form-input" maxlength="@PatientFieldLimits.Address" value="@_editForm.Address" @oninput="e => _editForm.Address = LimitAddress(e)" /></div>
                </div>
            }
            else
            {
                <div class="new-patient-form">
                    <div class="form-row">
                        <div class="form-group"><label>Nombre completo</label><input class="form-input" maxlength="@PatientFieldLimits.FullName" value="@_createForm.FullName" @oninput="e => _createForm.FullName = LimitName(e)" /></div>
                        <div class="form-group"><label>Cédula</label><input class="form-input" maxlength="@PatientFieldLimits.NationalId" value="@_createForm.NationalId" @oninput="e => _createForm.NationalId = LimitCedula(e)" /></div>
                    </div>
                    <div class="form-group"><label>Teléfono</label><input class="form-input" maxlength="@PatientFieldLimits.Phone" inputmode="tel" value="@_createForm.Phone" @oninput="e => _createForm.Phone = LimitPhone(e)" /></div>
                    <div class="form-group"><label>Correo (opcional)</label><input class="form-input" type="email" maxlength="@PatientFieldLimits.Email" value="@_createForm.Email" placeholder="paciente@correo.com" @oninput="e => _createForm.Email = LimitEmail(e)" /></div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Género</label>
                            <select class="form-input" @bind="_createForm.Gender">
                                <option value="Male">Masculino</option>
                                <option value="Female">Femenino</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Fecha nacimiento</label>
                            <input class="form-input" type="date" value="@_createForm.DateOfBirth.ToString("yyyy-MM-dd")" @onchange="OnBirthChanged" />
                        </div>
                    </div>
                    <div class="form-group"><label>Dirección</label><input class="form-input" maxlength="@PatientFieldLimits.Address" value="@_createForm.Address" @oninput="e => _createForm.Address = LimitAddress(e)" /></div>
                </div>
            }
            <div class="modal-actions">
                <button class="btn-outline" @onclick="CloseFormModal">Cancelar</button>
                <button class="btn-primary" disabled="@_saving" @onclick="SaveAsync">@(_saving ? "Guardando..." : "Guardar")</button>
            </div>
        </div>
    </div>
}

@if (_showDisableModal && _toDisable != null)
{
    <div class="modal-overlay" @onclick="() => _showDisableModal = false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header"><h2>Deshabilitar paciente</h2></div>
            <p class="modal-confirm-text">¿Deshabilitar a <strong>@_toDisable.FullName</strong>?</p>
            @if (!string.IsNullOrEmpty(_disableError)) { <div class="wizard-error">@_disableError</div> }
            <div class="modal-actions">
                <button class="btn-outline" @onclick="() => _showDisableModal = false">Cancelar</button>
                <button class="btn-danger" @onclick="ConfirmDisableAsync">Deshabilitar</button>
            </div>
        </div>
    </div>
}

@if (_showEnableModal && _toEnable != null)
{
    <div class="modal-overlay" @onclick="() => _showEnableModal = false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header"><h2>Reactivar paciente</h2></div>
            <p class="modal-confirm-text">¿Reactivar a <strong>@_toEnable.FullName</strong>?</p>
            @if (!string.IsNullOrEmpty(_enableError)) { <div class="wizard-error">@_enableError</div> }
            <div class="modal-actions">
                <button class="btn-outline" @onclick="() => _showEnableModal = false">Cancelar</button>
                <button class="btn-primary" @onclick="ConfirmEnableAsync">Reactivar</button>
            </div>
        </div>
    </div>
}

@if (_showImportModal)
{
    <div class="modal-overlay" @onclick="CloseImportModal">
        <div class="modal-panel modal-panel-lg" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Importar pacientes (CSV)</h2>
                <button class="modal-close" @onclick="CloseImportModal">×</button>
            </div>

            <div class="patient-import-help">
                <p class="modal-confirm-text" style="margin-top:0;">
                    El archivo debe ser <strong>CSV</strong> (UTF-8). Puede guardar un Excel como “CSV delimitado por comas”.
                    Primero se valida; luego solo se importan las filas válidas.
                </p>
                <p class="patient-import-help-title">Columnas obligatorias</p>
                <ul>
                    <li><code>FullName</code> o <code>Nombre</code> — nombre completo</li>
                    <li><code>Gender</code> o <code>Genero</code> — <code>Male</code>/<code>Female</code> o <code>Masculino</code>/<code>Femenino</code></li>
                    <li><code>DateOfBirth</code> o <code>FechaNacimiento</code> — preferible <code>yyyy-MM-dd</code> (también <code>dd/MM/yyyy</code>)</li>
                    <li><code>Address</code> o <code>Direccion</code></li>
                    <li><code>Phone</code> o <code>Telefono</code> — 10 a 15 dígitos, <code>+</code> opcional (ej. <code>+595981123456</code>)</li>
                </ul>
                <p class="patient-import-help-title">Columnas opcionales</p>
                <ul>
                    <li><code>NationalId</code> o <code>Cedula</code></li>
                    <li><code>Email</code> o <code>Correo</code> — si lo incluye, debe ser un correo real</li>
                    <li><code>MobilePhone</code> o <code>Celular</code></li>
                </ul>
                <p class="billing-muted" style="margin-bottom:0;">
                    Teléfono y cédula no pueden repetirse. Máximo 1000 filas / 2 MB.
                    Use la plantilla para no equivocarse con los encabezados.
                </p>
            </div>

            <div class="patient-import-actions">
                <button class="btn-outline" type="button" disabled="@_importBusy" @onclick="DownloadTemplateAsync">
                    <Icon Name="download" Class="btn-svg" /> Descargar plantilla
                </button>
                <InputFile OnChange="OnImportFileSelected" accept=".csv,text/csv" disabled="@_importBusy" />
            </div>

            @if (!string.IsNullOrEmpty(_importError))
            {
                <div class="wizard-error">@_importError</div>
            }
            @if (!string.IsNullOrEmpty(_importNotice))
            {
                <div class="wizard-success">@_importNotice</div>
            }

            @if (_importPreview != null)
            {
                <div class="billing-kpi-grid" style="margin: 0.75rem 0;">
                    <div class="agenda-kpi"><span class="agenda-kpi-value">@_importPreview.TotalRows</span><span class="agenda-kpi-label">Filas</span></div>
                    <div class="agenda-kpi accent-green"><span class="agenda-kpi-value">@_importPreview.ValidCount</span><span class="agenda-kpi-label">Válidas</span></div>
                    <div class="agenda-kpi accent-yellow"><span class="agenda-kpi-value">@_importPreview.ErrorCount</span><span class="agenda-kpi-label">Con error</span></div>
                </div>

                <div class="data-table-wrap patient-import-table">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nombre</th>
                                <th>Teléfono</th>
                                <th>Cédula</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _importPreview.Rows.Take(100))
                            {
                                <tr class="@(row.IsValid ? null : "table-row-inactive")">
                                    <td>@row.RowNumber</td>
                                    <td>@Dash(row.FullName)</td>
                                    <td>@Dash(row.Phone)</td>
                                    <td>@Dash(row.NationalId)</td>
                                    <td>
                                        @if (row.IsValid)
                                        {
                                            <span class="status-badge status-active">OK</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive" title="@row.Error">@row.Error</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (_importPreview.Rows.Count > 100)
                {
                    <p class="billing-muted">Mostrando las primeras 100 filas de @_importPreview.Rows.Count.</p>
                }
            }

            <div class="modal-actions">
                <button class="btn-outline" disabled="@_importBusy" @onclick="CloseImportModal">Cerrar</button>
                <button class="btn-primary"
                        disabled="@(_importBusy || _importPreview == null || _importPreview.ValidCount == 0)"
                        @onclick="ConfirmImportAsync">
                    @(_importBusy ? "Importando..." : $"Importar {_importPreview?.ValidCount ?? 0} válidos")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<PatientListItem> _patients = [];
    private string _search = "", _statusFilter = "all";
    private int _pageNumber = 1;
    private int _pageSize = 20;
    private int _totalCount;
    private int _totalPages = 1;
    private bool _loading = true;
    private string? _loadError, _formError, _disableError, _enableError, _fieldLimitToast;
    private bool _canCreate, _canEdit, _canDelete, _canViewFacturas, _showFormModal, _isEdit, _saving;
    private bool _showDisableModal, _showEnableModal, _showImportModal, _importBusy;
    private CreatePatientRequest _createForm = new();
    private UpdatePatientRequest _editForm = new();
    private int _editingId;
    private int? _duplicatePatientId;
    private PatientListItem? _toDisable, _toEnable;
    private PatientImportPreview? _importPreview;
    private string? _importError, _importNotice;
    private CancellationTokenSource? _searchCts;

    private int TotalPages => Math.Max(1, _totalPages);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        _canCreate = PermissionService.HasPermission(user, "pacientes.create");
        _canEdit = PermissionService.HasPermission(user, "pacientes.edit");
        _canDelete = PermissionService.HasPermission(user, "pacientes.delete");
        _canViewFacturas = PermissionService.HasPermission(user, "facturacion.view");
        await ReloadAsync();
    }

    private void GoToPatient(int id) => Navigation.NavigateTo($"/pacientes/{id}");
    private void GoToPatientDebt(int id) => Navigation.NavigateTo($"/pacientes/{id}?tab=facturas");

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(350, token);
            _pageNumber = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task SetStatusFilterAsync(string status)
    {
        if (_statusFilter == status) return;
        _statusFilter = status;
        _pageNumber = 1;
        await ReloadAsync();
    }

    private async Task OnPageSizeChangedAsync()
    {
        _pageNumber = 1;
        await ReloadAsync();
    }

    private async Task PrevPageAsync()
    {
        if (_pageNumber <= 1) return;
        _pageNumber--;
        await ReloadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_pageNumber >= TotalPages) return;
        _pageNumber++;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        var (page, error) = await AuthService.WithTokenRetryAsync(
            () => PatientService.GetPatientsPagedAsync(_pageNumber, _pageSize, _statusFilter, _search),
            AuthService.IsTokenError);

        if (page != null)
        {
            _patients = page.Items?.ToList() ?? [];
            _pageNumber = page.CurrentPage > 0 ? page.CurrentPage : _pageNumber;
            _pageSize = page.PageSize > 0 ? page.PageSize : _pageSize;
            _totalCount = page.TotalCount;
            _totalPages = page.TotalPages > 0 ? page.TotalPages : 1;
        }
        else
        {
            _patients = [];
            _totalCount = 0;
            _totalPages = 1;
        }

        _loadError = error;
        _loading = false;
    }

    private void OpenCreateModal() { _isEdit = false; _createForm = new(); _formError = null; _duplicatePatientId = null; _fieldLimitToast = null; _showFormModal = true; }
    private void OpenImportModal()
    {
        _showImportModal = true;
        _importPreview = null;
        _importError = null;
        _importNotice = null;
    }
    private void CloseImportModal()
    {
        if (_importBusy) return;
        _showImportModal = false;
    }

    private async Task DownloadTemplateAsync()
    {
        _importError = null;
        var (bytes, error) = await PatientService.DownloadImportTemplateAsync();
        if (error != null || bytes == null)
        {
            _importError = error ?? "No se pudo descargar la plantilla.";
            return;
        }

        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("dentalCareUi.downloadBytes", "plantilla-pacientes.csv", base64, "text/csv");
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs args)
    {
        _importBusy = true;
        _importError = null;
        _importNotice = null;
        _importPreview = null;

        try
        {
            var file = args.File;
            if (file.Size <= 0)
            {
                _importError = "El archivo está vacío.";
                return;
            }

            if (file.Size > 2 * 1024 * 1024)
            {
                _importError = "El archivo no puede superar 2 MB.";
                return;
            }

            await using var stream = file.OpenReadStream(2 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            memory.Position = 0;

            var (preview, error) = await PatientService.PreviewImportAsync(memory, file.Name);
            if (error != null || preview == null)
            {
                _importError = error ?? "No se pudo validar el archivo.";
                return;
            }

            _importPreview = preview;
            if (preview.ValidCount == 0)
                _importError = "No hay filas válidas para importar. Revise los errores.";
        }
        catch (Exception ex)
        {
            _importError = ex.Message;
        }
        finally
        {
            _importBusy = false;
        }
    }

    private async Task ConfirmImportAsync()
    {
        if (_importPreview == null)
            return;

        var validRows = _importPreview.Rows.Where(r => r.IsValid).ToList();
        if (validRows.Count == 0)
        {
            _importError = "No hay filas válidas para importar.";
            return;
        }

        _importBusy = true;
        _importError = null;
        _importNotice = null;

        var payload = new PatientImportConfirmPayload
        {
            Rows = validRows.Select(r => new PatientImportConfirmRow
            {
                RowNumber = r.RowNumber,
                FullName = r.FullName,
                Gender = r.Gender,
                DateOfBirth = DateTime.TryParse(r.DateOfBirth, out var dob) ? dob : default,
                Address = string.IsNullOrWhiteSpace(r.Address) ? "Sin dirección" : r.Address,
                Phone = r.Phone,
                NationalId = r.NationalId,
                Email = r.Email,
                MobilePhone = r.MobilePhone
            }).ToList()
        };

        var (result, error) = await PatientService.ConfirmImportAsync(payload);
        _importBusy = false;

        if (error != null || result == null)
        {
            _importError = error ?? "No se pudo importar.";
            return;
        }

        _importNotice = $"Importados {result.Imported} de {result.Requested}. Omitidos: {result.Skipped}.";
        _importPreview = new PatientImportPreview
        {
            TotalRows = result.Rows.Count,
            ValidCount = result.Imported,
            ErrorCount = result.Skipped,
            Rows = result.Rows
        };

        await ReloadAsync();
    }

    private void OpenEditModal(PatientListItem p)
    {
        _isEdit = true; _editingId = p.Id;
        _editForm = new UpdatePatientRequest { Id = p.Id, FullName = p.FullName, Phone = p.Phone, NationalId = p.NationalId, Email = p.Email, Address = p.Address };
        _formError = null; _duplicatePatientId = null; _fieldLimitToast = null;
        _showFormModal = true;
    }
    private void CloseFormModal() => _showFormModal = false;
    private void OpenDisableModal(PatientListItem p) { _toDisable = p; _disableError = null; _showDisableModal = true; }
    private void OpenEnableModal(PatientListItem p) { _toEnable = p; _enableError = null; _showEnableModal = true; }
    private void OnBirthChanged(ChangeEventArgs e) { if (DateTime.TryParse(e.Value?.ToString(), out var d)) _createForm.DateOfBirth = d; }

    private async Task SaveAsync()
    {
        _saving = true; _formError = null; _duplicatePatientId = null; _fieldLimitToast = null;
        var name = _isEdit ? _editForm.FullName : _createForm.FullName;
        var nationalId = _isEdit ? _editForm.NationalId : _createForm.NationalId;
        var phone = _isEdit ? _editForm.Phone : _createForm.Phone;
        var emailToCheck = _isEdit ? _editForm.Email : _createForm.Email;
        var address = _isEdit ? _editForm.Address : _createForm.Address;

        var lengthError = PatientFieldLimits.ValidateLengths(name, nationalId, phone, emailToCheck, address);
        if (lengthError != null)
        {
            _formError = lengthError;
            _saving = false;
            return;
        }

        _duplicatePatientId = PatientSaveErrors.FindLocalDuplicate(_patients, nationalId, _isEdit ? _editingId : null);
        if (_duplicatePatientId.HasValue)
        {
            _formError = "Esta cédula ya existe";
            _saving = false;
            return;
        }

        if (!ContactEmail.TryValidate(emailToCheck, out var normalizedEmail, out var emailError))
        {
            _formError = emailError;
            _saving = false;
            return;
        }

        if (_isEdit)
        {
            _editForm.Email = normalizedEmail;
            _editForm.MobilePhone = null;
            var (ok, err, duplicateId) = await PatientService.UpdatePatientAsync(_editingId, _editForm);
            if (!ok) { _formError = err; _duplicatePatientId = duplicateId; _saving = false; return; }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_createForm.FullName) || string.IsNullOrWhiteSpace(_createForm.Phone))
            { _formError = "Nombre y teléfono son obligatorios."; _saving = false; return; }
            if (string.IsNullOrWhiteSpace(_createForm.Address))
                _createForm.Address = "Sin dirección";
            _createForm.Email = normalizedEmail;
            _createForm.MobilePhone = null;
            var (ok, err, id, duplicateId) = await PatientService.CreatePatientAsync(_createForm);
            if (!ok) { _formError = err; _duplicatePatientId = duplicateId; _saving = false; return; }
            if (id is int patientId)
            {
                Navigation.NavigateTo($"/pacientes/{patientId}?tab=antecedentes");
                return;
            }
        }
        _saving = false; _showFormModal = false; await ReloadAsync();
    }

    private string LimitName(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var value = PersonNameRules.Sanitize(raw, PatientFieldLimits.FullName, out var changed);
        if (raw.Any(char.IsDigit))
            _fieldLimitToast = "El nombre no puede contener números.";
        else if (changed && raw.Length > PatientFieldLimits.FullName)
            _fieldLimitToast = $"El nombre admite máximo {PatientFieldLimits.FullName} caracteres.";
        return value;
    }
    private string LimitCedula(ChangeEventArgs e) => Limit(e, PatientFieldLimits.NationalId, "La cédula");
    private string LimitPhone(ChangeEventArgs e) => Limit(e, PatientFieldLimits.Phone, "El teléfono");
    private string LimitEmail(ChangeEventArgs e) => Limit(e, PatientFieldLimits.Email, "El correo");
    private string LimitAddress(ChangeEventArgs e) => Limit(e, PatientFieldLimits.Address, "La dirección");

    private string Limit(ChangeEventArgs e, int max, string label)
    {
        var value = PatientSaveErrors.Clamp(e.Value?.ToString(), max, out var truncated);
        if (truncated)
            _fieldLimitToast = $"{label} admite máximo {max} caracteres.";
        return value;
    }

    private async Task ConfirmDisableAsync()
    {
        if (_toDisable == null) return;
        var (ok, err) = await PatientService.DisablePatientAsync(_toDisable.Id);
        if (!ok) { _disableError = err; return; }
        _showDisableModal = false; await ReloadAsync();
    }

    private async Task ConfirmEnableAsync()
    {
        if (_toEnable == null) return;
        var (ok, err) = await PatientService.EnablePatientAsync(_toEnable.Id);
        if (!ok) { _enableError = err; return; }
        _showEnableModal = false; await ReloadAsync();
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}" : name.Length > 0 ? char.ToUpper(name[0]).ToString() : "?";
    }

    private static string GetAge(string? dob)
    {
        if (string.IsNullOrWhiteSpace(dob)) return "—";
        if (DateTime.TryParse(dob, out var date))
            return $"{(int)((DateTime.Today - date).TotalDays / 365.25)}";
        return "—";
    }

    private static string Dash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    private static bool LooksLikeEmail(string? value) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains('@');

    private static string? DisplayEmail(PatientListItem patient)
    {
        if (!string.IsNullOrWhiteSpace(patient.Email))
            return patient.Email.Trim();
        return LooksLikeEmail(patient.MobilePhone) ? patient.MobilePhone!.Trim() : null;
    }
}
