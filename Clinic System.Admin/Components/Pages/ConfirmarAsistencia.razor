@page "/confirmar-asistencia"
@layout LoginLayout
@rendermode InteractiveServer
@inject AttendanceConfirmationService AttendanceService

<PageTitle>Confirmar asistencia — DentalCare</PageTitle>

<div class="login-card attendance-card">
    <div class="login-brand">
        <div class="login-logo">
            <Icon Name="calendar" Class="login-logo-svg" StrokeWidth="1.6" />
        </div>
        <h1>Confirmar asistencia</h1>
        <p>@(CanChoose ? "Indique si podrá asistir a su cita." : "Esta cita ya tiene una respuesta registrada.")</p>
    </div>

    @if (_loading)
    {
        <AnimatedLoader Compact="true" Message="Validando enlace..." />
    }
    else if (!string.IsNullOrWhiteSpace(_error) && _details == null)
    {
        <div class="login-error">@_error</div>
    }
    else if (_details != null)
    {
        <div class="attendance-summary">
            <div><span>Paciente</span><strong>@_details.PatientName</strong></div>
            <div><span>Médico</span><strong>@_details.DoctorName</strong></div>
            <div><span>Fecha</span><strong>@_details.AppointmentDate.ToString("dd/MM/yyyy")</strong></div>
            <div><span>Hora</span><strong>@_details.AppointmentDate.ToString("hh:mm tt")</strong></div>
            <div><span>Estado</span><strong>@FormatStatus(_details.Status)</strong></div>
        </div>

        @if (CanChoose)
        {
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="login-error">@_error</div>
            }
            <div class="form-group attendance-comment">
                <label>Comentario (opcional)</label>
                <textarea class="form-input" rows="3" maxlength="500" @bind="_comment"
                          placeholder="El personal de la clínica lo verá junto a su respuesta."></textarea>
            </div>

            <div class="attendance-actions">
                <button class="btn-primary" disabled="@_saving" @onclick='() => RespondAsync("confirm")'>
                    @(_saving ? "Guardando..." : "Sí, asistiré")
                </button>
                <button class="btn-outline" disabled="@_saving" @onclick='() => RespondAsync("decline")'>
                    No podré asistir
                </button>
            </div>
        }
        else
        {
            <div class="wizard-success">@SavedAnswerTitle</div>
            <div class="attendance-summary">
                <div><span>Su respuesta</span><strong>@SavedAnswerLabel</strong></div>
                @if (_details.RespondedAt.HasValue)
                {
                    <div><span>Enviada</span><strong>@_details.RespondedAt.Value.ToString("dd/MM/yyyy HH:mm")</strong></div>
                }
                <div><span>Comentario</span><strong>@(string.IsNullOrWhiteSpace(_details.Comment) ? "Sin comentario" : _details.Comment)</strong></div>
            </div>
            <p class="attendance-muted">Puede cerrar esta ventana. El enlace ya no permite cambiar la respuesta.</p>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }

    private AttendanceConfirmationDetails? _details;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string _comment = string.Empty;

    private bool CanChoose =>
        _details is { CanRespond: true, AlreadyResponded: false }
        && _details.Status is "Pending" or "Rescheduled";

    private string SavedAnswerTitle => _details?.Accepted switch
    {
        true => "Asistencia confirmada. ¡Gracias!",
        false => "Hemos registrado que no podrá asistir.",
        _ => "Esta cita ya tiene una respuesta registrada."
    };

    private string SavedAnswerLabel => _details?.Accepted switch
    {
        true => "Sí, asistiré",
        false => "No podré asistir",
        _ => FormatStatus(_details?.Status ?? "")
    };

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _error = "Falta el token de confirmación.";
            _loading = false;
            return;
        }

        var (details, error) = await AttendanceService.GetDetailsAsync(Token);
        _details = details;
        _error = error;
        _loading = false;
    }

    private async Task RespondAsync(string action)
    {
        if (string.IsNullOrWhiteSpace(Token) || !CanChoose)
            return;

        _saving = true;
        _error = null;
        var comment = !string.IsNullOrWhiteSpace(_comment) ? _comment.Trim() : null;
        var (ok, _, details, error) = await AttendanceService.RespondAsync(Token, action, comment);
        _saving = false;

        if (!ok)
        {
            _error = error;
            return;
        }

        if (details != null)
        {
            _details = details;
            _details.CanRespond = false;
        }
        else if (_details != null)
        {
            _details.CanRespond = false;
            _details.AlreadyResponded = true;
            _details.Accepted = action == "confirm";
            _details.Comment = comment;
            _details.RespondedAt ??= DateTime.Now;
            _details.Status = action == "confirm" ? "Confirmed" : "Cancelled";
        }
    }

    private static string FormatStatus(string status) => status switch
    {
        "Pending" => "Pendiente",
        "Confirmed" => "Confirmada",
        "Rescheduled" => "Reagendada",
        "InProgress" => "En atención",
        "Completed" => "Completada",
        "Cancelled" => "Cancelada",
        "NoShow" => "No asistió",
        _ => status
    };
}
