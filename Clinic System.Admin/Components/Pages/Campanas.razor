@page "/campanas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "campanas.view")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject EmailCampaignMaintenanceService Campaigns
@inject PermissionService PermissionService
@inject AuthenticationStateProvider AuthStateProvider
@inject ClinicProfileService ClinicProfile
@inject IJSRuntime JS

<PageTitle>Campañas de correo — DentalCare Admin</PageTitle>

<div class="maintenance-page">
    <div class="maintenance-header command-header">
        <div class="command-titles">
            <h1>Campañas de correo</h1>
            <p>Avisos a pacientes con correo, en lotes de 15 cada 15 minutos. Las citas del enlace llegan como solicitudes para confirmar.</p>
        </div>
        <div class="command-actions">
            <a class="btn-outline" href="/campanas/solicitudes">
                <Icon Name="inbox" Class="btn-svg" /> Solicitudes
            </a>
            @if (_canCreate)
            {
                <button class="btn-primary" @onclick="StartNew">
                    <Icon Name="plus" Class="btn-svg" /> Nueva campaña
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_notice))
    {
        <div class="wizard-success">@_notice</div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="wizard-error">@_error</div>
    }

    @if (_audience != null)
    {
        <div class="campaign-audience">
            <div>
                <strong>@_audience.EligibleCount</strong>
                <span>listos para enviar</span>
            </div>
            <div>
                <strong>@_audience.WithEmailCount</strong>
                <span>con correo</span>
            </div>
            <div>
                <strong>@_audience.OptedOutCount</strong>
                <span>sin campañas</span>
            </div>
            <div>
                <strong>@_audience.InvalidCount</strong>
                <span>correo inválido</span>
            </div>
            <p class="campaign-audience-note">
                Cada lote envía @_audience.BatchSize correos y espera 15 minutos.
                @if (_audience.EligibleCount > 0)
                {
                    <text> Esta audiencia son unos @_audience.EstimatedBatches lote(s).</text>
                }
                @if (!_audience.SmtpConfigured)
                {
                    <text> Configure el SMTP en <a href="/configuracion/clinica">Datos de la clínica</a> antes de iniciar.</text>
                }
                <text> Cada correo incluye un enlace para solicitar cita (configure la URL pública del portal y los destinatarios de aviso en Solicitudes → Destinatarios).</text>
            </p>
        </div>
    }

    @if (_showForm)
    {
        <form class="new-patient-form patient-detail-form campaign-form" @onsubmit="SaveDraftAsync" @onsubmit:preventDefault="true">
            <h2>@(_editingId == null ? "Nueva campaña" : "Editar borrador")</h2>
            <div class="form-group">
                <label>Nombre interno</label>
                <input class="form-input" @bind="_form.Name" maxlength="80" placeholder="Promoción septiembre" />
            </div>
            <p class="modal-confirm-text">
                Variables (pulse una para insertarla en el campo activo):
            </p>
            <div class="whatsapp-placeholder-list" role="group" aria-label="Variables de plantilla">
                @foreach (var token in Placeholders)
                {
                    <button type="button"
                            class="whatsapp-placeholder-chip"
                            title="Insertar @token"
                            @onclick="() => InsertPlaceholderAsync(token)">@token</button>
                }
            </div>
            <p class="whatsapp-placeholder-hint">Se insertará en: <strong>@_activeFieldLabel</strong></p>
            <div class="form-group">
                <label>Asunto</label>
                <input @ref="_subjectEditor"
                       class="form-input"
                       maxlength="120"
                       placeholder="Aviso de @ClinicName"
                       @bind="_form.Subject"
                       @bind:event="oninput"
                       @onfocus="() => _activeField = CampaignField.Subject" />
            </div>
            <div class="form-group">
                <label>Mensaje</label>
                <RichTextEditor @ref="_bodyEditor"
                                AriaLabel="Mensaje de la campaña"
                                Value="_form.Body"
                                ValueChanged="OnBodyChanged"
                                OnFocus="() => _activeField = CampaignField.Body" />
                <span class="form-hint">
                    El sistema añade un pie con los datos de la clínica y, si configuró la URL pública,
                    un enlace para que el paciente agende en cualquier horario ({enlace_cita}).
                </span>
            </div>
            <div class="whatsapp-preview-label">Vista previa</div>
            <MessageHtmlPreview Html="@PreviewBody" />
            <div class="patient-detail-actions campaign-form-actions">
                <button class="btn-outline" type="button" @onclick="CancelForm">Cancelar</button>
                <button class="btn-primary" type="submit" disabled="@_saving">@(_saving ? "Guardando..." : "Guardar borrador")</button>
            </div>
        </form>
    }

    @if (_loading)
    {
        <div class="loading-state">Cargando campañas...</div>
    }
    else if (_items.Count == 0)
    {
        <div class="maintenance-empty"><p>Aún no hay campañas. Cree una para avisar a los pacientes con correo.</p></div>
    }
    else
    {
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Campaña</th>
                        <th>Estado</th>
                        <th>Progreso</th>
                        <th class="col-actions">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr class="@(_selected?.Id == item.Id ? "table-row-selected" : null)">
                            <td>
                                <strong>@item.Name</strong>
                                <div class="form-hint">@item.Subject</div>
                            </td>
                            <td><span class="status-badge @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td>
                            <td>@ProgressLabel(item)</td>
                            <td class="col-actions">
                                <button class="btn-table" @onclick="() => SelectAsync(item.Id)">Ver</button>
                                @if (_canEdit && item.Status == "Draft")
                                {
                                    <button class="btn-table" @onclick="() => EditDraft(item)">Editar</button>
                                    <button class="btn-table" @onclick="() => StartAsync(item.Id)">Iniciar</button>
                                }
                                @if (_canEdit && item.Status == "Completed")
                                {
                                    <button class="btn-table" @onclick="() => AskRestart(item)">Iniciar nuevamente</button>
                                }
                                @if (_canEdit && item.Status == "Running")
                                {
                                    <button class="btn-table" @onclick="() => PauseAsync(item.Id)">Pausar</button>
                                }
                                @if (_canEdit && item.Status == "Paused")
                                {
                                    <button class="btn-table" @onclick="() => ResumeAsync(item.Id)">Reanudar</button>
                                }
                                @if (_canEdit && item.Status is "Draft" or "Running" or "Paused")
                                {
                                    <button class="btn-table btn-table-danger" @onclick="() => CancelAsync(item.Id)">Cancelar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_selected != null)
    {
        <div class="campaign-detail">
            <h2>@_selected.Name</h2>
            <p class="form-hint">Asunto: @_selected.Subject</p>
            <MessageHtmlPreview Html="@_selected.Body" />
            @if (_selected.RecentRecipients.Count > 0)
            {
                <h3>Últimos envíos</h3>
                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Paciente</th>
                                <th>Correo</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _selected.RecentRecipients)
                            {
                                <tr>
                                    <td>@row.PatientName</td>
                                    <td>@row.Email</td>
                                    <td>
                                        <span class="status-badge @StatusClass(row.Status)">@StatusLabel(row.Status)</span>
                                        @if (!string.IsNullOrWhiteSpace(row.Error))
                                        {
                                            <div class="form-hint">@row.Error</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@if (_restartCampaign != null)
{
    <div class="modal-overlay" @onclick="DeclineRestart">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Iniciar nuevamente</h2>
                <button class="modal-close" @onclick="DeclineRestart">×</button>
            </div>
            <p class="modal-confirm-text">
                ¿Está seguro de que quiere iniciar nuevamente la campaña «@_restartCampaign.Name»?
                Se volverá a enviar a la audiencia actual con correo válido.
            </p>
            <div class="modal-actions">
                <button class="btn-outline" disabled="@_saving" @onclick="DeclineRestart">Cancelar</button>
                <button class="btn-primary" disabled="@_saving" @onclick="ConfirmRestartAsync">
                    @(_saving ? "Iniciando..." : "Sí, iniciar nuevamente")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] Placeholders = ["{nombre}", "{clinica}", "{enlace_cita}"];

    private enum CampaignField { Subject, Body }

    private EmailCampaignAudience? _audience;
    private List<EmailCampaignListItem> _items = [];
    private EmailCampaignDetail? _selected;
    private EmailCampaignForm _form = new();
    private ElementReference _subjectEditor;
    private RichTextEditor? _bodyEditor;
    private CampaignField _activeField = CampaignField.Body;
    private int? _editingId;
    private bool _showForm;
    private bool _loading = true;
    private bool _saving;
    private bool _canCreate;
    private bool _canEdit;
    private string? _notice;
    private string? _error;
    private EmailCampaignListItem? _restartCampaign;

    private string _activeFieldLabel =>
        _activeField == CampaignField.Subject ? "Asunto" : "Mensaje";

    private string ClinicName => string.IsNullOrWhiteSpace(ClinicProfile.Get().Name)
        ? "la clínica"
        : ClinicProfile.Get().Name;

    private string PreviewBody
    {
        get
        {
            var sampleLink = "https://tu-portal/agendar-campana?token=…";
            var tokens = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["{nombre}"] = "Aurileidy Matos",
                ["{clinica}"] = ClinicName,
                ["{enlace_cita}"] = sampleLink
            };
            var body = MessageBodyFormatting.ApplyTokens(_form.Body ?? string.Empty, tokens);
            if (MessageBodyFormatting.IsBlank(body))
                return string.Empty;
            return AppendPreviewFooter(body, sampleLink);
        }
    }

    private string AppendPreviewFooter(string body, string sampleLink)
    {
        if (MessageBodyFormatting.LooksLikeHtml(body))
        {
            var extra = body.Contains(sampleLink, StringComparison.OrdinalIgnoreCase)
                ? string.Empty
                : "<br>Para agendar su cita en el horario que más le convenga (cualquier día y hora disponible):<br>"
                    + System.Net.WebUtility.HtmlEncode(sampleLink);
            return body
                + "<p style=\"margin-top:1.2em;color:#666;font-size:13px\">—<br>"
                + System.Net.WebUtility.HtmlEncode(ClinicName)
                + extra
                + "<br>Este aviso se envía solo a pacientes de la clínica.</p>";
        }

        var footer = "\n\n—\n" + ClinicName;
        if (!body.Contains(sampleLink, StringComparison.OrdinalIgnoreCase))
        {
            footer += "\n\nPara agendar su cita en el horario que más le convenga (cualquier día y hora disponible):\n"
                + sampleLink;
        }
        footer += "\nEste aviso se envía solo a pacientes de la clínica.";
        return body + footer;
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        _canCreate = PermissionService.HasPermission(user, "campanas.create");
        _canEdit = PermissionService.HasPermission(user, "campanas.edit");
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        var audienceTask = Campaigns.GetAudienceAsync();
        var listTask = Campaigns.ListAsync();
        await Task.WhenAll(audienceTask, listTask);
        var (audience, audienceError) = audienceTask.Result;
        var (items, listError) = listTask.Result;
        _audience = audience;
        _items = items;
        _error = audienceError ?? listError;
        _loading = false;
        if (_selected != null)
        {
            var (detail, _) = await Campaigns.GetAsync(_selected.Id);
            if (detail != null)
                _selected = detail;
        }
    }

    private void StartNew()
    {
        _editingId = null;
        _form = new EmailCampaignForm();
        _showForm = true;
        _activeField = CampaignField.Body;
        ClearNotice();
    }

    private void EditDraft(EmailCampaignListItem item)
    {
        _editingId = item.Id;
        _form = new EmailCampaignForm
        {
            Name = item.Name,
            Subject = item.Subject,
            Body = _selected?.Id == item.Id ? _selected.Body : string.Empty
        };
        _showForm = true;
        _ = LoadBodyAsync(item.Id);
    }

    private async Task LoadBodyAsync(int id)
    {
        var (detail, _) = await Campaigns.GetAsync(id);
        if (detail == null)
            return;
        _form.Body = detail.Body;
        _selected = detail;
        await InvokeAsync(StateHasChanged);
    }

    private void CancelForm()
    {
        _showForm = false;
        _editingId = null;
        _activeField = CampaignField.Body;
    }

    private void OnBodyChanged(string value) => _form.Body = value;

    private async Task InsertPlaceholderAsync(string token)
    {
        if (_activeField == CampaignField.Body)
        {
            if (_bodyEditor != null)
                await _bodyEditor.InsertTextAsync(token);
            else
                _form.Body += token;
            return;
        }

        try
        {
            var next = await JS.InvokeAsync<string?>("dentalCareUi.insertAtCursor", _subjectEditor, token);
            if (!string.IsNullOrEmpty(next))
                _form.Subject = next;
        }
        catch (JSException)
        {
            _form.Subject += token;
        }
    }

    private async Task SaveDraftAsync()
    {
        _saving = true;
        ClearNotice();
        var (data, error) = _editingId == null
            ? await Campaigns.CreateAsync(_form)
            : await Campaigns.UpdateDraftAsync(_editingId.Value, _form);
        _saving = false;
        if (error != null || data == null)
        {
            _error = error;
            return;
        }
        _notice = "Borrador guardado.";
        _showForm = false;
        _editingId = null;
        _selected = data;
        await ReloadAsync();
    }

    private Task SelectAsync(int id) => RunAsync(() => Campaigns.GetAsync(id), selected => _selected = selected, null);

    private Task StartAsync(int id) => RunAsync(() => Campaigns.StartAsync(id), selected =>
    {
        _selected = selected;
        _notice = "Campaña en curso. El sistema enviará 15 correos cada 15 minutos.";
    }, "iniciar");

    private void AskRestart(EmailCampaignListItem item)
    {
        ClearNotice();
        _restartCampaign = item;
    }

    private void DeclineRestart()
    {
        if (_saving)
            return;
        _restartCampaign = null;
    }

    private async Task ConfirmRestartAsync()
    {
        if (_restartCampaign == null || _saving)
            return;

        var id = _restartCampaign.Id;
        _saving = true;
        await RunAsync(() => Campaigns.StartAsync(id), selected =>
        {
            _selected = selected;
            _notice = "Campaña reiniciada. El sistema enviará 15 correos cada 15 minutos.";
            _restartCampaign = null;
        }, "reiniciar");
        _saving = false;
    }

    private Task PauseAsync(int id) => RunAsync(() => Campaigns.PauseAsync(id), selected =>
    {
        _selected = selected;
        _notice = "Campaña pausada.";
    }, "pausar");

    private Task ResumeAsync(int id) => RunAsync(() => Campaigns.ResumeAsync(id), selected =>
    {
        _selected = selected;
        _notice = "Campaña reanudada.";
    }, "reanudar");

    private Task CancelAsync(int id) => RunAsync(() => Campaigns.CancelAsync(id), selected =>
    {
        _selected = selected;
        _notice = "Campaña cancelada.";
    }, "cancelar");

    private async Task RunAsync(
        Func<Task<(EmailCampaignDetail? Data, string? Error)>> action,
        Action<EmailCampaignDetail> onOk,
        string? verb)
    {
        ClearNotice();
        var (data, error) = await action();
        if (error != null || data == null)
        {
            _error = error ?? (string.IsNullOrEmpty(verb) ? "No se pudo cargar la campaña." : $"No se pudo {verb} la campaña.");
            return;
        }
        onOk(data);
        await ReloadAsync();
    }

    private void ClearNotice()
    {
        _notice = null;
        _error = null;
    }

    private static string ProgressLabel(EmailCampaignListItem item)
    {
        if (item.RecipientCount <= 0)
            return "Sin destinatarios aún";
        return $"{item.SentCount} enviados · {item.PendingCount} pendientes · {item.FailedCount} fallidos";
    }

    private static string StatusLabel(string status) => status switch
    {
        "Draft" => "Borrador",
        "Running" => "En curso",
        "Paused" => "Pausada",
        "Completed" => "Completada",
        "Cancelled" => "Cancelada",
        "Pending" => "Pendiente",
        "Sent" => "Enviado",
        "Failed" => "Falló",
        "Skipped" => "Omitido",
        _ => status
    };

    private static string StatusClass(string status) => status switch
    {
        "Running" or "Sent" or "Completed" => "status-active",
        "Paused" or "Pending" or "Draft" => "status-inactive",
        "Failed" or "Cancelled" => "status-inactive",
        _ => "status-inactive"
    };
}
