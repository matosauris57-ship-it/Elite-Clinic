    private async Task SendEmailAsync()
    {
        if (string.IsNullOrEmpty(_emailTo) || string.IsNullOrEmpty(_emailSubject) || string.IsNullOrEmpty(_emailPreview))
            return;

        _sendingEmail = true;
        var (ok, error) = await BookingService.SendPatientEmailAsync(_emailTo, _emailSubject, _emailPreview);
        _sendingEmail = false;
        if (!ok)
        {
            _emailError = error ?? "No se pudo enviar el correo.";
            return;
        }

        CloseEmailModal();
    }

    private static bool IsWithinOneHour(AppointmentAgendaItem appt)
    {
        var dt = appt.ParsedDate;
        return dt.HasValue && (dt.Value - DateTime.Now).TotalHours < 1 && dt.Value > DateTime.Now;
    }

    private static string FormatSelectedDate(DateTime date) =>
        date.ToString("dddd, d 'de' MMMM yyyy", new System.Globalization.CultureInfo("es-ES"));

    private static string FormatStatus(string status) => status switch
    {
        "Pending" => "Pendiente",
        "Confirmed" => "Confirmada",
        "Rescheduled" => "Reagendada",
        "Completed" => "Completada",
        "Cancelled" => "Cancelada",
        "NoShow" => "No asistió",
        _ => status
    };

    private static string GetStatusClass(string status) => status switch
    {
        "Pending" => "status-planned",
        "Confirmed" => "status-progress",
        "Rescheduled" => "status-progress",
        "Completed" => "status-completed",
        "Cancelled" => "status-cancelled",
        "NoShow" => "status-cancelled",
        _ => ""
    };
