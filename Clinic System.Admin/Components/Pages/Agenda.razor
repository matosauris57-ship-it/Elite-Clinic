@page "/agenda"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "agenda.view")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AgendaMaintenanceService AgendaService
@inject AppointmentBookingService BookingService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject WhatsAppMessageSettingsService WhatsAppSettings
@inject EmailMessageSettingsService EmailMessageSettings
@inject IJSRuntime JS

<PageTitle>Agenda — DentalCare Admin</PageTitle>

<div class="agenda-page maintenance-page">
    <div class="maintenance-header command-header">
        <div class="command-titles">
            <h1>Agenda</h1>
            <p>@HeaderDateText</p>
        </div>
        <div class="command-actions">
            <button class="btn-outline" disabled="@(_loading || IsPeriodNavDisabled)" @onclick="PrevPeriod">
                <Icon Name="chevron-left" Class="btn-svg" />
            </button>
            <button class="btn-outline" disabled="@_loading" @onclick="GoToday">Hoy</button>
            <button class="btn-outline" disabled="@(_loading || IsPeriodNavDisabled)" @onclick="NextPeriod">
                <Icon Name="chevron-right" Class="btn-svg" />
            </button>
            <a href="/agendar-cita" class="btn-primary">
                <Icon Name="calendar-plus" Class="btn-svg" />
                Agendar nueva
            </a>
        </div>
    </div>

    <div class="agenda-kpi-row">
        <div class="agenda-kpi"><span class="agenda-kpi-value">@TotalAppointments</span><span class="agenda-kpi-label">Total</span></div>
        <div class="agenda-kpi accent-purple"><span class="agenda-kpi-value">@PendingAppointments</span><span class="agenda-kpi-label">Pendientes</span></div>
        <div class="agenda-kpi accent-teal"><span class="agenda-kpi-value">@ConfirmedAppointments</span><span class="agenda-kpi-label">Confirmadas</span></div>
        <div class="agenda-kpi accent-green"><span class="agenda-kpi-value">@CompletedAppointments</span><span class="agenda-kpi-label">Completadas</span></div>
    </div>

    <div class="agenda-layout">
        <aside class="agenda-sidebar">
            <div class="mini-calendar">
                <div class="cal-header">
                    <button class="cal-nav" @onclick="PrevMonth">‹</button>
                    <span>@_calendarMonth.ToString("MMMM yyyy", _culture)</span>
                    <button class="cal-nav" @onclick="NextMonth">›</button>
                </div>
                <div class="cal-weekdays">
                    <span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span>
                </div>
                <div class="cal-days">
                    @foreach (var day in GetCalendarDays())
                    {
                        if (day == null)
                        {
                            <span class="cal-day empty"></span>
                        }
                        else
                        {
                            <button class="cal-day @GetDayClass(day.Value)" disabled="@_loading" @onclick="() => SelectDate(day.Value)">@day.Value.Day</button>
                        }
                    }
                </div>
            </div>

            <div class="agenda-filters">
                <div class="form-group">
                    <label>Médico</label>
                    <select class="form-input" disabled="@_loading" @bind="_doctorFilter" @bind:after="OnRemoteFilterChangedAsync">
                        <option value="0">Todos los médicos</option>
                        @foreach (var doc in _doctors)
                        {
                            <option value="@doc.Id">@doc.FullName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Estado</label>
                    <select class="form-input" disabled="@_loading" @bind="_statusFilter" @bind:after="OnRemoteFilterChangedAsync">
                        <option value="">Todos</option>
                        <option value="Pending">Pendiente</option>
                        <option value="Confirmed">Confirmada</option>
                        <option value="Rescheduled">Reagendada</option>
                        <option value="Completed">Completada</option>
                        <option value="Cancelled">Cancelada</option>
                        <option value="NoShow">No asistió</option>
                    </select>
                </div>
                @if (_viewMode == "list")
                {
                    <div class="form-group">
                        <label>Periodo</label>
                        <select class="form-input" disabled="@_loading" @bind="_listDateMode" @bind:after="OnListDateModeChangedAsync">
                            <option value="day">Día</option>
                            <option value="range">Rango de fechas</option>
                            <option value="all">Todas las citas</option>
                        </select>
                    </div>
                    @if (_listDateMode == "range")
                    {
                        <div class="form-group">
                            <label>Desde</label>
                            <input class="form-input" type="date" disabled="@_loading" value="@_rangeFrom.ToString("yyyy-MM-dd")" @onchange="OnRangeFromChanged" />
                        </div>
                        <div class="form-group">
                            <label>Hasta</label>
                            <input class="form-input" type="date" disabled="@_loading" value="@_rangeTo.ToString("yyyy-MM-dd")" @onchange="OnRangeToChanged" />
                        </div>
                    }
                }
            </div>
        </aside>

        <section class="agenda-main">
            @if (!string.IsNullOrEmpty(_loadError))
            {
                <ErrorBanner Message="@_loadError" OnRetry="ReloadAgendaAsync" />
            }

            <div class="agenda-toolbar">
                <div class="agenda-view-tabs">
                    <button class="toggle-btn @(_viewMode == "day" ? "active" : "")" disabled="@_loading" @onclick='() => SetViewModeAsync("day")'>Diaria</button>
                    <button class="toggle-btn @(_viewMode == "week" ? "active" : "")" disabled="@_loading" @onclick='() => SetViewModeAsync("week")'>Semanal</button>
                    <button class="toggle-btn @(_viewMode == "list" ? "active" : "")" disabled="@_loading" @onclick='() => SetViewModeAsync("list")'>Lista</button>
                </div>
                <div class="search-field maintenance-search">
                    <Icon Name="search" Class="field-icon" />
                    <input type="text"
                           placeholder="Buscar paciente o médico..."
                           disabled="@_loading"
                           @bind="_search"
                           @bind:event="oninput"
                           @bind:after="OnSearchChangedAsync" />
                </div>
                @if (_viewMode != "list" || _listDateMode == "day")
                {
                    <label class="agenda-date-jump">
                        Fecha
                        <input type="date"
                               disabled="@_loading"
                               value="@_selectedDate.ToString("yyyy-MM-dd")"
                               @onchange="OnDateInputChanged" />
                    </label>
                }
                else if (_listDateMode == "range")
                {
                    <label class="agenda-date-jump">
                        Desde
                        <input type="date"
                               disabled="@_loading"
                               value="@_rangeFrom.ToString("yyyy-MM-dd")"
                               @onchange="OnRangeFromChanged" />
                    </label>
                    <label class="agenda-date-jump">
                        Hasta
                        <input type="date"
                               disabled="@_loading"
                               value="@_rangeTo.ToString("yyyy-MM-dd")"
                               @onchange="OnRangeToChanged" />
                    </label>
                }
                <span class="maintenance-count">
                    @if (_viewMode == "list")
                    {
                        @($"{_appointments.Count} cita(s) visibles de {_totalCount}")
                    }
                    else
                    {
                        @($"{FilteredAppointments.Count()} cita(s)")
                    }
                </span>
                @if (HasActiveFilters)
                {
                    <button class="btn-outline" disabled="@_loading" @onclick="ClearFiltersAsync">Limpiar filtros</button>
                }
            </div>

            @if (_loading)
            {
                <AnimatedLoader Message="Cargando agenda..." />
            }
            else if (_viewMode is "day" or "week")
            {
                <AgendaCalendarGrid Days="VisibleDays"
                                    Slots="TimeSlots"
                                    SlotDurationMinutes="_schedule.SlotDurationMinutes"
                                    WorkingDays="_schedule.WorkingDays"
                                    Appointments="FilteredAppointments"
                                    SelectedDate="_selectedDate"
                                    HighlightId="_highlightId"
                                    Disabled="_loading"
                                    Saving="_saving"
                                    OnPrev="PrevPeriod"
                                    OnNext="NextPeriod"
                                    OnSelectDay="SelectDate"
                                    OnOpenDetail="OpenDetailModal"
                                    OnBookSlot="BookSlot" />
            }
            else if (!FilteredAppointments.Any() && string.IsNullOrEmpty(_loadError))
            {
                <div class="agenda-empty-state">
                    <h3>No hay citas para mostrar</h3>
                    <p>@(HasActiveFilters ? "No se encontraron citas con los filtros actuales." : EmptyListMessage)</p>
                    <div class="agenda-empty-actions">
                        @if (HasActiveFilters)
                        {
                            <button class="btn-outline" @onclick="ClearFiltersAsync">Limpiar filtros</button>
                        }
                        <a href="/agendar-cita" class="btn-primary">Agendar nueva cita</a>
                    </div>
                </div>
            }
            else
            {
                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@(_viewMode == "list" && _listDateMode != "day" ? "Fecha y hora" : "Hora")</th>
                                <th>Paciente</th>
                                <th>Médico</th>
                                <th>Teléfono</th>
                                <th>Estado</th>
                                <th class="col-actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in FilteredAppointments)
                            {
                                <tr class="@(IsHighlighted(appt) ? "agenda-row-highlight" : "")">
                                    <td>@FormatListDate(appt)</td>
                                    <td><a class="clinical-patient-link" href="/pacientes/@appt.PatientId">@appt.PatientFullName</a></td>
                                    <td>@appt.DoctorName</td>
                                    <td>@appt.PatientPhone</td>
                                    <td><span class="status-badge @GetStatusClass(appt.Status)">@FormatStatus(appt.Status)</span></td>
                                    <td class="col-actions">
                                        <button class="btn-table" disabled="@_saving" @onclick="() => OpenDetailModal(appt)">Detalle</button>
                                        <button class="btn-table" disabled="@_saving" @onclick="() => OpenActionsMenu(appt)">Acciones</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (_viewMode == "list" && _totalCount > 0)
                {
                    <div class="billing-pagination agenda-pagination">
                        <label class="agenda-date-jump">
                            Por página
                            <select class="form-input" disabled="@_loading" @bind="_pageSize" @bind:after="OnPageSizeChangedAsync">
                                <option value="10">10</option>
                                <option value="15">15</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                        </label>
                        <span>Página @_pageNumber de @TotalPages</span>
                        <button class="btn-outline" disabled="@(_loading || _pageNumber <= 1)" @onclick="PrevPageAsync">Anterior</button>
                        <button class="btn-outline" disabled="@(_loading || _pageNumber >= TotalPages)" @onclick="NextPageAsync">Siguiente</button>
                    </div>
                }
            }
        </section>
    </div>
</div>

@if (_showDetailModal && _selectedAppointment != null)
{
    <div class="modal-overlay" @onclick="CloseDetailModal">
        <div class="modal-panel modal-panel-wide" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Detalle de cita</h2>
                <button class="modal-close" @onclick="CloseDetailModal">×</button>
            </div>
            <div class="agenda-detail-grid">
                <div><span>Paciente</span><strong><a class="clinical-patient-link" href="/pacientes/@_selectedAppointment.PatientId">@_selectedAppointment.PatientFullName</a></strong></div>
                <div><span>Teléfono</span><strong>@_selectedAppointment.PatientPhone</strong></div>
                <div><span>Correo</span><strong>@(string.IsNullOrWhiteSpace(_selectedAppointment.PatientEmail) ? "—" : _selectedAppointment.PatientEmail)</strong></div>
                <div><span>Médico</span><strong>@_selectedAppointment.DoctorName</strong></div>
                <div><span>Especialidad</span><strong>@_selectedAppointment.Specialization</strong></div>
                <div><span>Fecha y hora</span><strong>@_selectedAppointment.AppointmentDate</strong></div>
                <div><span>Estado</span><strong><span class="status-badge @GetStatusClass(_selectedAppointment.Status)">@FormatStatus(_selectedAppointment.Status)</span></strong></div>
            </div>
            <PatientClinicalHistoryPanel PatientId="_selectedAppointment.PatientId"
                                         PatientName="@_selectedAppointment.PatientFullName"
                                         Collapsible="true" />
            <div class="modal-actions">
                <button class="btn-outline" @onclick="CloseDetailModal">Cerrar</button>
                @if (_selectedAppointment.Status != "Cancelled")
                {
                    <button class="btn-outline" @onclick="() => OpenWhatsAppReminder(_selectedAppointment)">Recordatorio WhatsApp</button>
                    <button class="btn-outline" @onclick="() => OpenEmailReminder(_selectedAppointment)">Recordatorio correo</button>
                }
                <button class="btn-primary" @onclick="() => { CloseDetailModal(); OpenActionsMenu(_selectedAppointment!); }">Acciones</button>
            </div>
        </div>
    </div>
}

@if (_showActionsModal && _selectedAppointment != null)
{
    <div class="modal-overlay" @onclick="CloseActionsModal">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Acciones — @_selectedAppointment.PatientFullName</h2>
                <button class="modal-close" @onclick="CloseActionsModal">×</button>
            </div>
            @if (!string.IsNullOrEmpty(_actionMessage))
            {
                <div class="wizard-error agenda-action-message">@_actionMessage</div>
            }
            <div class="agenda-actions-grid">
                @if (_selectedAppointment.Status == "Pending")
                {
                    <button class="btn-primary" disabled="@_saving" @onclick="OpenConfirmModal">Confirmar</button>
                }
                @if (_selectedAppointment.Status is "Confirmed" or "Rescheduled" or "Pending")
                {
                    <button class="btn-outline" disabled="@_saving" @onclick="OpenRescheduleModal">Reagendar</button>
                    <button class="btn-outline" disabled="@_saving" @onclick="OpenCompleteModal">Completar</button>
                    <button class="btn-outline" disabled="@_saving" @onclick="OpenNoShowModal">No asistió</button>
                }
                @if (_selectedAppointment.Status is not "Completed" and not "Cancelled" and not "NoShow")
                {
                    <button class="btn-outline btn-table-danger" disabled="@_saving" @onclick="OpenCancelModal">Cancelar</button>
                }
                @if (_selectedAppointment.Status is not "Cancelled" and not "Completed")
                {
                    <button class="btn-outline" disabled="@_saving" @onclick="CallPatientAsync">Llamar paciente</button>
                }
                @if (_selectedAppointment.Status != "Cancelled")
                {
                    <button class="btn-outline" disabled="@_saving" @onclick="() => OpenWhatsAppReminder(_selectedAppointment)">Recordatorio WhatsApp</button>
                    <button class="btn-outline" disabled="@_saving" @onclick="() => OpenEmailReminder(_selectedAppointment)">Recordatorio correo</button>
                }
            </div>
        </div>
    </div>
}

@if (_showConfirmModal && _selectedAppointment != null)
{
    <div class="modal-overlay" @onclick="CloseConfirmModal">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Confirmar cita</h2>
                <button class="modal-close" @onclick="CloseConfirmModal">×</button>
            </div>
            @if (!string.IsNullOrEmpty(_modalError)) { <div class="wizard-error">@_modalError</div> }
            <div class="new-patient-form">
                <div class="form-group">
                    <label>Método de pago</label>
                    <select class="form-input" @bind="_confirmForm.method">
                        <option value="Cash">Efectivo</option>
                        <option value="CreditCard">Tarjeta</option>
                        <option value="InstaPay">InstaPay</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Monto (opcional)</label>
                    <input class="form-input" type="number" step="0.01" @bind="_confirmForm.amount" />
                </div>
                <div class="form-group">
                    <label>Notas</label>
                    <textarea class="form-input" rows="2" @bind="_confirmForm.Notes"></textarea>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-outline" @onclick="CloseConfirmModal">Cancelar</button>
                <button class="btn-primary" disabled="@_saving" @onclick="ConfirmAsync">@(_saving ? "Confirmando..." : "Confirmar")</button>
            </div>
        </div>
    </div>
}

@if (_showCancelModal && _selectedAppointment != null)
{
    <div class="modal-overlay" @onclick="CloseCancelModal">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Cancelar cita</h2>
                <button class="modal-close" @onclick="CloseCancelModal">×</button>
            </div>
            @if (!string.IsNullOrEmpty(_modalError)) { <div class="wizard-error">@_modalError</div> }
            @if (IsWithinOneHour(_selectedAppointment))
            {
                <div class="wizard-error">No se puede cancelar: faltan menos de 1 hora para la cita.</div>
            }
            else
            {
                <p>¿Cancelar la cita de <strong>@_selectedAppointment.PatientFullName</strong> el @_selectedAppointment.AppointmentDate?</p>
            }
            <div class="modal-actions">
                <button class="btn-outline" @onclick="CloseCancelModal">Volver</button>
                <button class="btn-primary btn-table-danger" disabled="@(_saving || IsWithinOneHour(_selectedAppointment))" @onclick="CancelAsync">
                    @(_saving ? "Cancelando..." : "Confirmar cancelación")
                </button>
            </div>
        </div>
    </div>
}

@if (_showRescheduleModal && _selectedAppointment != null)
{
    <div class="modal-overlay" @onclick="CloseRescheduleModal">
        <div class="modal-panel modal-panel-wide" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Reagendar cita</h2>
                <button class="modal-close" @onclick="CloseRescheduleModal">×</button>
            </div>
            @if (!string.IsNullOrEmpty(_modalError)) { <div class="wizard-error">@_modalError</div> }
            <div class="datetime-layout">
                <div class="mini-calendar">
                    <div class="cal-header">
                        <button class="cal-nav" @onclick="PrevRescheduleMonth">‹</button>
                        <span>@_rescheduleMonth.ToString("MMMM yyyy", _culture)</span>
                        <button class="cal-nav" @onclick="NextRescheduleMonth">›</button>
                    </div>
                    <div class="cal-weekdays">
                        <span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span>
                    </div>
                    <div class="cal-days">
                        @foreach (var day in GetRescheduleCalendarDays())
                        {
                            if (day == null) { <span class="cal-day empty"></span>; }
                            else
                            {
                                <button class="cal-day @GetRescheduleDayClass(day.Value)"
                                        disabled="@(day.Value < DateTime.Today || !IsWorkingDay(day.Value))"
                                        @onclick="() => SelectRescheduleDate(day.Value)">@day.Value.Day</button>
                            }
                        }
                    </div>
                </div>
                <div class="slots-panel">
                    <h4>Horarios disponibles</h4>
                    @if (_loadingSlots)
                    {
                        <AnimatedLoader Compact="true" Message="Cargando horarios..." />
                    }
                    else if (!_rescheduleSlots.Any())
                    {
                        <p class="agenda-slot-empty">No hay horarios disponibles.</p>
                    }
                    else
                    {
                        <div class="slots-grid">
                            @foreach (var slot in _rescheduleSlots)
                            {
                                <button class="slot-btn @(_rescheduleTime == slot ? "selected" : "")" @onclick="() => _rescheduleTime = slot">
                                    @slot.ToString(@"hh\:mm")
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-outline" @onclick="CloseRescheduleModal">Cancelar</button>
                <button class="btn-primary" disabled="@(_saving || !_rescheduleDate.HasValue || !_rescheduleTime.HasValue)" @onclick="RescheduleAsync">
                    @(_saving ? "Reagendando..." : "Reagendar")
                </button>
            </div>
        </div>
    </div>
}

@if (_showCompleteModal && _selectedAppointment != null)
{
    <div class="modal-overlay" @onclick="CloseCompleteModal">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Completar cita</h2>
                <button class="modal-close" @onclick="CloseCompleteModal">×</button>
            </div>
            @if (!string.IsNullOrEmpty(_modalError)) { <div class="wizard-error">@_modalError</div> }
            <div class="new-patient-form">
                <div class="form-group">
                    <label>Diagnóstico *</label>
                    <input class="form-input" @bind="_completeForm.Diagnosis" />
                </div>
                <div class="form-group">
                    <label>Descripción *</label>
                    <textarea class="form-input" rows="3" @bind="_completeForm.Description"></textarea>
                </div>
                <div class="form-group">
                    <label>Notas adicionales</label>
                    <textarea class="form-input" rows="2" @bind="_completeForm.AdditionalNotes"></textarea>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-outline" @onclick="CloseCompleteModal">Cancelar</button>
                <button class="btn-primary" disabled="@_saving" @onclick="CompleteAsync">@(_saving ? "Completando..." : "Completar")</button>
            </div>
        </div>
    </div>
}

@if (_showNoShowModal && _selectedAppointment != null)
{
    <div class="modal-overlay" @onclick="CloseNoShowModal">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Marcar no asistió</h2>
                <button class="modal-close" @onclick="CloseNoShowModal">×</button>
            </div>
            @if (!string.IsNullOrEmpty(_modalError)) { <div class="wizard-error">@_modalError</div> }
            <p>¿Marcar que <strong>@_selectedAppointment.PatientFullName</strong> no asistió a la cita?</p>
            <div class="modal-actions">
                <button class="btn-outline" @onclick="CloseNoShowModal">Volver</button>
                <button class="btn-primary" disabled="@_saving" @onclick="NoShowAsync">@(_saving ? "Guardando..." : "Confirmar")</button>
            </div>
        </div>
    </div>
}

@if (_showWhatsAppModal)
{
    <div class="modal-overlay" @onclick="CloseWhatsAppModal">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Recordatorio WhatsApp</h2>
                <button class="modal-close" @onclick="CloseWhatsAppModal">×</button>
            </div>
            @if (!string.IsNullOrEmpty(_whatsAppError))
            {
                <div class="wizard-error">@_whatsAppError</div>
            }
            else
            {
                <p class="modal-confirm-text">Revise el mensaje y pulse Enviar en WhatsApp. El sistema no lo envía solo.</p>
                <div class="whatsapp-message-box">@_whatsAppPreview</div>
            }
            <div class="modal-actions">
                <button class="btn-outline" @onclick="CloseWhatsAppModal">Cancelar</button>
                <button class="btn-primary" disabled="@(string.IsNullOrEmpty(_whatsAppUrl))" @onclick="OpenWhatsAppAsync">Abrir WhatsApp</button>
            </div>
        </div>
    </div>
}

@if (_showEmailModal)
{
    <div class="modal-overlay" @onclick="CloseEmailModal">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Recordatorio por correo</h2>
                <button class="modal-close" @onclick="CloseEmailModal">×</button>
            </div>
            @if (!string.IsNullOrEmpty(_emailError))
            {
                <div class="wizard-error">@_emailError</div>
            }
            else
            {
                <p class="modal-confirm-text">Se enviará a <strong>@_emailTo</strong>. Revise el mensaje antes de enviarlo.</p>
                <div class="whatsapp-message-box">@_emailPreview</div>
            }
            <div class="modal-actions">
                <button class="btn-outline" @onclick="CloseEmailModal">Cancelar</button>
                <button class="btn-primary" disabled="@(_sendingEmail || string.IsNullOrEmpty(_emailTo) || !string.IsNullOrEmpty(_emailError))" @onclick="SendEmailAsync">
                    @(_sendingEmail ? "Enviando..." : "Enviar correo")
                </button>
            </div>
            @if (_sendingEmail)
            {
                <AnimatedLoader Overlay="true" Message="Enviando correo..." />
            }
        </div>
    </div>
}

@code {
    private readonly System.Globalization.CultureInfo _culture = new("es-ES");

    private IReadOnlyList<TimeSpan> TimeSlots => AppointmentBookingService.GenerateAllSlots(
        _schedule.OpenTime,
        _schedule.CloseTime,
        _schedule.SlotDurationMinutes);

