    protected override async Task OnInitializedAsync()
    {
        ParseQueryParams();
        _calendarMonth = new DateTime(_selectedDate.Year, _selectedDate.Month, 1);
        _rescheduleMonth = _calendarMonth;
        _doctors = await BookingService.GetDoctorsAsync();
        var (schedule, _) = await BookingService.GetClinicScheduleAsync();
        if (schedule != null)
            _schedule = schedule;
        await ReloadAgendaAsync();
    }

    private void ParseQueryParams()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("fecha", out var fechaVal) &&
            DateTime.TryParseExact(fechaVal.ToString(), "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var fecha))
        {
            _selectedDate = fecha.Date;
        }

        if (query.TryGetValue("id", out var idVal) && int.TryParse(idVal.ToString(), out var id))
            _highlightId = id;

        if (query.TryGetValue("vista", out var vistaVal))
        {
            var vista = vistaVal.ToString();
            if (vista is "day" or "week" or "list")
                _viewMode = vista;
        }
    }

    private string HeaderDateText
    {
        get
        {
            if (_viewMode == "list")
            {
                return _listDateMode switch
                {
                    "all" => "Todas las citas",
                    "range" => $"{_rangeFrom.ToString("dd 'de' MMMM", _culture)} al {_rangeTo.ToString("dd 'de' MMMM", _culture)}",
                    _ => FormatSelectedDate(_selectedDate)
                };
            }

            if (_viewMode != "week")
                return FormatSelectedDate(_selectedDate);

            var start = GetWeekStart(_selectedDate);
            var end = start.AddDays(6);
            return $"{start.ToString("dd 'de' MMMM", _culture)} al {end.ToString("dd 'de' MMMM", _culture)}";
        }
    }

    private int TotalPages => Math.Max(1, _totalPages);
    private bool IsPeriodNavDisabled => _viewMode == "list" && _listDateMode == "all";
    private string EmptyListMessage => _viewMode == "list" && _listDateMode == "all"
        ? "No hay citas agendadas."
        : "No hay citas agendadas para este día.";

    private IReadOnlyList<DateTime> VisibleDays =>
        _viewMode == "week"
            ? Enumerable.Range(0, 7).Select(i => GetWeekStart(_selectedDate).AddDays(i)).ToArray()
            : [_selectedDate.Date];

    private bool IsHighlighted(AppointmentAgendaItem appt) =>
