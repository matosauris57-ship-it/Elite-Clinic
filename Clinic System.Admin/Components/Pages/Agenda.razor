    private int ConfirmedAppointments => _stats?.Confirmed ?? 0;
    private int CompletedAppointments => _stats?.Completed ?? 0;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search) ||
        _doctorFilter > 0 ||
        !string.IsNullOrWhiteSpace(_statusFilter) ||
        (_viewMode == "list" && _listDateMode != "day");

    private IEnumerable<AppointmentAgendaItem> FilteredAppointments =>
        _viewMode == "list" || string.IsNullOrWhiteSpace(_search)
            ? _appointments
            : _appointments.Where(a =>
                a.PatientFullName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                a.DoctorName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                a.PatientPhone.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                FormatStatus(a.Status).Contains(_search, StringComparison.OrdinalIgnoreCase));

    private async Task ReloadAgendaAsync()
    {
        _loading = true;
        _loadError = null;

        int? doctorId = _doctorFilter > 0 ? _doctorFilter : null;
        string? status = string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter;
        DateTime? rangeStart;
        DateTime? rangeEnd;
        int? pageNumber = null;
        int? pageSize = null;
        string? search = null;

        if (_viewMode == "week")
        {
            rangeStart = GetWeekStart(_selectedDate);
            rangeEnd = rangeStart.Value.AddDays(6);
        }
        else if (_viewMode == "day")
        {
            rangeStart = _selectedDate.Date;
            rangeEnd = null;
        }
        else
        {
            pageNumber = _pageNumber;
            pageSize = _pageSize;
            search = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();

            if (_listDateMode == "all")
            {
                rangeStart = null;
                rangeEnd = null;
            }
            else if (_listDateMode == "range")
            {
                NormalizeRange();
                rangeStart = _rangeFrom.Date;
                rangeEnd = _rangeTo.Date;
            }
            else
            {
                rangeStart = _selectedDate.Date;
                rangeEnd = null;
            }
        }

        var (page, error) = await AuthService.WithTokenRetryAsync(
            async () =>
            {
                var result = await AgendaService.GetAgendaPageAsync(
                    rangeStart, doctorId, status, rangeEnd, pageNumber, pageSize, search);
                return (result.Page, result.Error);
            },
            AuthService.IsTokenError);

        _appointments = page.Items?.ToList() ?? [];
        _totalCount = page.TotalCount;
        _pageNumber = page.CurrentPage > 0 ? page.CurrentPage : (pageNumber ?? 1);
        _totalPages = page.TotalPages > 0 ? page.TotalPages : 1;
        _loadError = error;

        var (stats, _) = await AgendaService.GetDayStatsAsync(rangeStart, rangeEnd ?? rangeStart);
        _stats = stats ?? new AppointmentStats();

        _loading = false;
    }

    private Task OnRemoteFilterChangedAsync()
    {
        _pageNumber = 1;
        return ReloadAgendaAsync();
    }

    private async Task OnSearchChangedAsync()
    {
        if (_viewMode != "list")
            return;

        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(400, token);
            _pageNumber = 1;
            await ReloadAgendaAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private Task OnListDateModeChangedAsync()
    {
        if (_listDateMode == "range")
        {
            _rangeFrom = GetWeekStart(_selectedDate);
            _rangeTo = _rangeFrom.AddDays(6);
        }

        _pageNumber = 1;
        return ReloadAgendaAsync();
    }

    private Task OnRangeFromChanged(ChangeEventArgs e)
    {
        if (!DateTime.TryParse(e.Value?.ToString(), out var date))
            return Task.CompletedTask;

        _rangeFrom = date.Date;
        _pageNumber = 1;
        return ReloadAgendaAsync();
    }

    private Task OnRangeToChanged(ChangeEventArgs e)
    {
        if (!DateTime.TryParse(e.Value?.ToString(), out var date))
            return Task.CompletedTask;

        _rangeTo = date.Date;
        _pageNumber = 1;
        return ReloadAgendaAsync();
    }

    private void NormalizeRange()
    {
        if (_rangeFrom <= _rangeTo)
            return;

        (_rangeFrom, _rangeTo) = (_rangeTo, _rangeFrom);
    }

    private Task OnPageSizeChangedAsync()
    {
        _pageNumber = 1;
        return ReloadAgendaAsync();
    }

    private Task PrevPageAsync()
    {
        if (_pageNumber <= 1)
            return Task.CompletedTask;

        _pageNumber--;
        return ReloadAgendaAsync();
    }

    private Task NextPageAsync()
    {
        if (_pageNumber >= TotalPages)
            return Task.CompletedTask;

        _pageNumber++;
        return ReloadAgendaAsync();
    }

    private string FormatListDate(AppointmentAgendaItem appt)
    {
        if (_viewMode == "list" && _listDateMode != "day")
            return appt.ParsedDate?.ToString("dd/MM/yyyy HH:mm") ?? appt.AppointmentDate;

        return appt.ParsedDate?.ToString("HH:mm") ?? appt.AppointmentDate;
    }

    private async Task SetViewModeAsync(string mode)
    {
        if (_viewMode == mode)
            return;

        _viewMode = mode;
        _pageNumber = 1;
        await ReloadAgendaAsync();
    }

    private async Task SelectDate(DateTime date)
    {
        var sameRange = _viewMode == "week"
            ? GetWeekStart(_selectedDate) == GetWeekStart(date)
            : _selectedDate.Date == date.Date;

        _selectedDate = date.Date;
        _calendarMonth = new DateTime(date.Year, date.Month, 1);
        _highlightId = null;

        if (_viewMode == "list" && _listDateMode == "all")
        {
            _listDateMode = "day";
            _pageNumber = 1;
            await ReloadAgendaAsync();
            return;
        }

        if (_viewMode == "list" && _listDateMode == "range")
        {
            _rangeFrom = date.Date;
            if (_rangeTo < _rangeFrom)
                _rangeTo = _rangeFrom;
            _pageNumber = 1;
            await ReloadAgendaAsync();
            return;
        }

        if (!sameRange)
        {
            _pageNumber = 1;
            await ReloadAgendaAsync();
        }
    }

    private Task OnDateInputChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
            return SelectDate(date.Date);

        return Task.CompletedTask;
    }

    private Task PrevPeriod()
    {
        if (_viewMode == "list" && _listDateMode == "range")
        {
            var span = Math.Max(1, (_rangeTo.Date - _rangeFrom.Date).Days + 1);
            _rangeFrom = _rangeFrom.AddDays(-span);
            _rangeTo = _rangeTo.AddDays(-span);
            _selectedDate = _rangeFrom;
            _pageNumber = 1;
            return ReloadAgendaAsync();
        }

        return SelectDate(_selectedDate.AddDays(_viewMode == "week" ? -7 : -1));
    }

    private Task NextPeriod()
    {
        if (_viewMode == "list" && _listDateMode == "range")
        {
            var span = Math.Max(1, (_rangeTo.Date - _rangeFrom.Date).Days + 1);
            _rangeFrom = _rangeFrom.AddDays(span);
            _rangeTo = _rangeTo.AddDays(span);
            _selectedDate = _rangeFrom;
            _pageNumber = 1;
            return ReloadAgendaAsync();
        }

        return SelectDate(_selectedDate.AddDays(_viewMode == "week" ? 7 : 1));
    }

    private Task GoToday()
    {
        if (_viewMode == "list" && _listDateMode == "all")
            _listDateMode = "day";
        else if (_viewMode == "list" && _listDateMode == "range")
        {
            _rangeFrom = DateTime.Today;
            _rangeTo = DateTime.Today;
        }

        _selectedDate = DateTime.Today.Date;
        _calendarMonth = new DateTime(_selectedDate.Year, _selectedDate.Month, 1);
        _highlightId = null;
        _pageNumber = 1;
        return ReloadAgendaAsync();
    }
    private void PrevMonth() { _calendarMonth = _calendarMonth.AddMonths(-1); }
    private void NextMonth() { _calendarMonth = _calendarMonth.AddMonths(1); }

    private void BookSlot((DateTime Date, TimeSpan Time) slot)
    {
        if (!IsWorkingDay(slot.Date) || !TimeSlots.Contains(slot.Time))
            return;

        var url = $"/agendar-cita?fecha={slot.Date:yyyy-MM-dd}&hora={slot.Time:hh\\:mm}";
        if (_doctorFilter > 0)
            url += $"&medico={_doctorFilter}";
        Navigation.NavigateTo(url);
    }

    private static DateTime GetWeekStart(DateTime date)
    {
        var offset = ((int)date.DayOfWeek + 6) % 7;
        return date.Date.AddDays(-offset);
    }

    private async Task ClearFiltersAsync()
    {
        var needsReload = _viewMode == "list"
            || _doctorFilter > 0
            || !string.IsNullOrWhiteSpace(_statusFilter)
            || !string.IsNullOrWhiteSpace(_search);
        _search = string.Empty;
        _doctorFilter = 0;
        _statusFilter = string.Empty;
        _listDateMode = "day";
        _rangeFrom = DateTime.Today;
        _rangeTo = DateTime.Today;
        _pageNumber = 1;

        if (needsReload)
            await ReloadAgendaAsync();
    }

    private IEnumerable<DateTime?> GetCalendarDays()
    {
        var first = new DateTime(_calendarMonth.Year, _calendarMonth.Month, 1);
        var offset = ((int)first.DayOfWeek + 6) % 7;
        for (var i = 0; i < offset; i++) yield return null;
        for (var d = 1; d <= DateTime.DaysInMonth(_calendarMonth.Year, _calendarMonth.Month); d++)
            yield return new DateTime(_calendarMonth.Year, _calendarMonth.Month, d);
    }

    private string GetDayClass(DateTime day)
    {
        var classes = new List<string>();
        if (day.Date == DateTime.Today) classes.Add("today");
        if (day.Date == _selectedDate.Date) classes.Add("selected");
        else if (_viewMode == "week")
        {
            var start = GetWeekStart(_selectedDate);
            if (day.Date >= start && day.Date < start.AddDays(7))
                classes.Add("in-week");
        }
        else if (_viewMode == "list" && _listDateMode == "range" && day.Date >= _rangeFrom.Date && day.Date <= _rangeTo.Date)
        {
            classes.Add("in-week");
        }

        return string.Join(" ", classes);
    }

