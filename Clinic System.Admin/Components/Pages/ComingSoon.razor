@page "/analitica"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "admin.panel")]
@rendermode InteractiveServer
@inject PermissionService PermissionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Analítica — DentalCare Admin</PageTitle>

<div class="coming-soon">
    <div class="coming-soon-icon">
        <Icon Name="bar-chart-2" Class="coming-soon-svg" />
    </div>
    <h1>Analítica</h1>
    <p>Esta sección estará disponible en la Fase 2 del proyecto. Mientras tanto use <a href="/reportes">Reportes</a>.</p>
    <a href="/" class="back-link">
        <Icon Name="chevron-left" Class="back-link-icon" StrokeWidth="2" />
        Volver al Dashboard
    </a>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!PermissionService.HasPermission(authState.User, "analitica.view"))
            Navigation.NavigateTo("/", forceLoad: false);
    }
}
