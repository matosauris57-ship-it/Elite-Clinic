@page "/configuracion"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "configuracion.view")]
@rendermode InteractiveServer
@inject PermissionService PermissionService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Configuración — DentalCare Admin</PageTitle>

<div class="maintenance-page">
    <div class="maintenance-header command-header">
        <div class="command-titles">
            <h1>Configuración</h1>
            <p>Administración del sistema y accesos</p>
        </div>
    </div>

    <div class="config-hub-grid">
        <NavLink class="config-hub-card" href="/configuracion/clinica">
            <Icon Name="building" Class="config-hub-icon" />
            <h3>Datos de la clínica</h3>
            <p>Nombre, teléfono, dirección, correo SMTP, RNC y logo. Un solo registro para facturas, citas y el panel.</p>
        </NavLink>
        <NavLink class="config-hub-card" href="/configuracion/usuarios">
            <Icon Name="users" Class="config-hub-icon" />
            <h3>Usuarios y roles</h3>
            <p>Gestiona cuentas staff, roles personalizados y permisos por módulo.</p>
        </NavLink>
        @if (_canViewRecovery)
        {
            <NavLink class="config-hub-card" href="/configuracion/recuperacion-contrasena">
                <Icon Name="key" Class="config-hub-icon" />
                <h3>Recuperación de contraseña</h3>
                <p>Quién indicó que olvidó su contraseña. Con el permiso «Cambiar contraseña» puede asignar una clave nueva.</p>
            </NavLink>
        }
        <NavLink class="config-hub-card" href="/configuracion/mensajes-whatsapp">
            <Icon Name="message-circle" Class="config-hub-icon" />
            <h3>Mensajes WhatsApp</h3>
            <p>Plantillas de recordatorio y confirmación, con negrita y formato.</p>
        </NavLink>
        <NavLink class="config-hub-card" href="/campanas">
            <Icon Name="mail" Class="config-hub-icon" />
            <h3>Campañas de correo</h3>
            <p>Avisos a pacientes con correo, en lotes de 15 cada 15 minutos.</p>
        </NavLink>
        <NavLink class="config-hub-card" href="/campanas/solicitudes">
            <Icon Name="inbox" Class="config-hub-icon" />
            <h3>Solicitudes de campaña</h3>
            <p>Confirme o reasigne las citas pedidas desde el enlace del correo de campaña.</p>
        </NavLink>
        <NavLink class="config-hub-card" href="/configuracion/mensajes-correo">
            <Icon Name="mail" Class="config-hub-icon" />
            <h3>Mensajes de correo</h3>
            <p>Recordatorios automáticos, confirmación y cumpleaños, con formato visual.</p>
        </NavLink>
        <NavLink class="config-hub-card" href="/configuracion/consentimientos">
            <Icon Name="check-circle-2" Class="config-hub-icon" />
            <h3>Consentimientos informados</h3>
            <p>Plantillas de texto para cada tipo de consentimiento. Se usan al imprimir y archivar.</p>
        </NavLink>
        <NavLink class="config-hub-card" href="/configuracion/alertas-inventario">
            <Icon Name="package" Class="config-hub-icon" />
            <h3>Alertas de inventario</h3>
            <p>Correos a destinatarios configurados cuando haya materiales con stock bajo.</p>
        </NavLink>
        <NavLink class="config-hub-card" href="/configuracion/dashboard">
            <Icon Name="layout-dashboard" Class="config-hub-icon" />
            <h3>Dashboard</h3>
            <p>Activa o desactiva los widgets que verá el personal de la clínica.</p>
        </NavLink>
        <NavLink class="config-hub-card" href="/configuracion/odontograma">
            <Icon Name="tooth" Class="config-hub-icon" />
            <h3>Odontograma</h3>
            <p>Simbología, colores y formas de las condiciones clínicas de la clínica.</p>
        </NavLink>
    </div>
</div>

@code {
    private bool _canViewRecovery;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        _canViewRecovery = PermissionService.HasPermission(user, "recuperacion-contrasena.view");
    }
}
