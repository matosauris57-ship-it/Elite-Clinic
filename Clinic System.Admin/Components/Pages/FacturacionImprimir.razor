@page "/facturacion/{PaymentId:int}/imprimir"
@layout PrintLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "facturacion.view")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject BillingMaintenanceService BillingService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Factura #@PaymentId</PageTitle>

@if (IsTicket)
{
    <style>
        @@page {
            size: @(PaperWidthMm)mm 297mm;
            margin: 2mm;
        }
    </style>
}

<div class="invoice-print-page">
    <div class="invoice-print-toolbar no-print">
        <a class="btn-outline" href="@BackHref">@BackLabel</a>
        <div class="invoice-print-modes">
            <a class="@(ShowLineDetails ? "btn-primary" : "btn-outline")" href="@ModeUrl(VistaKey, FormatKey)">Con detalle</a>
            <a class="@(ShowLineDetails ? "btn-outline" : "btn-primary")" href="@ModeUrl("resumen", FormatKey)">Solo total</a>
        </div>
        <div class="invoice-print-formats" role="group" aria-label="Formato de impresión">
            <a class="@(FormatKey == "carta" ? "btn-primary" : "btn-outline")" href="@ModeUrl(VistaKey, "carta")">Carta</a>
            <a class="@(FormatKey == "80mm" ? "btn-primary" : "btn-outline")" href="@ModeUrl(VistaKey, "80mm")">Ticket 80 mm</a>
            <a class="@(FormatKey == "58mm" ? "btn-primary" : "btn-outline")" href="@ModeUrl(VistaKey, "58mm")">Ticket 58 mm</a>
        </div>
        <button class="btn-primary" disabled="@_loading" @onclick="PrintAsync">Imprimir</button>
    </div>

    @if (IsTicket)
    {
        <p class="invoice-print-hint no-print">
            Active <strong>Ticket @(PaperWidthMm) mm</strong> aquí arriba. En el diálogo de impresión:
            elija la impresora térmica (no “Print to PDF”), papel de @(PaperWidthMm) mm si aparece,
            escala 100 % y márgenes en Ninguno. Con PDF verá hoja carta, pero el ticket debe salir como una franja estrecha a la izquierda.
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorBanner Message="@_error" OnRetry="LoadAsync" />
    }
    else if (_loading || _payment == null)
    {
        <AnimatedLoader Message="Cargando factura..." />
    }
    else
    {
        <div class="invoice-print-preview @FormatCss">
            <InvoiceDocument Payment="@_payment" Lines="@_lines" ShowLineDetails="@ShowLineDetails" Format="@FormatKey" />
        </div>
    }
</div>

@code {
    [Parameter]
    public int PaymentId { get; set; }

    [SupplyParameterFromQuery(Name = "vista")]
    public string? Vista { get; set; }

    [SupplyParameterFromQuery(Name = "formato")]
    public string? Formato { get; set; }

    [SupplyParameterFromQuery(Name = "volver")]
    public string? Volver { get; set; }

    private PaymentListItem? _payment;
    private List<InvoiceLineItem> _lines = [];
    private bool _loading = true;
    private string? _error;

    private bool ShowLineDetails => !string.Equals(Vista, "resumen", StringComparison.OrdinalIgnoreCase);
    private string VistaKey => ShowLineDetails ? "detalle" : "resumen";
    private string FormatKey => NormalizeFormat(Formato);
    private bool IsTicket => FormatKey is "80mm" or "58mm";
    private int PaperWidthMm => FormatKey == "58mm" ? 58 : 80;
    private string FormatCss => $"format-{FormatKey}";
    private bool HasPatientReturn => IsSafeReturn(Volver);
    private string BackHref => HasPatientReturn ? Volver! : "/facturacion";
    private string BackLabel => HasPatientReturn ? "Volver a la ficha" : "Volver a facturación";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var paymentTask = BillingService.GetPaymentAsync(PaymentId);
        var linesTask = BillingService.GetInvoiceLinesAsync(PaymentId);
        var (payment, paymentError) = await paymentTask;
        var (lines, linesError) = await linesTask;
        _payment = payment;
        _lines = lines;
        _error = paymentError ?? linesError;
        if (_payment == null && string.IsNullOrWhiteSpace(_error))
            _error = "No se encontró el pago.";
        _loading = false;
    }

    private string ModeUrl(string vista, string formato)
    {
        var query = $"vista={vista}&formato={formato}";
        if (HasPatientReturn)
            query += $"&volver={Uri.EscapeDataString(Volver!)}";
        var uri = Navigation.ToAbsoluteUri($"/facturacion/{PaymentId}/imprimir?{query}");
        return uri.PathAndQuery;
    }

    private static string NormalizeFormat(string? formato)
    {
        if (string.Equals(formato, "80mm", StringComparison.OrdinalIgnoreCase)
            || string.Equals(formato, "80", StringComparison.OrdinalIgnoreCase)
            || string.Equals(formato, "ticket", StringComparison.OrdinalIgnoreCase)
            || string.Equals(formato, "ticket80", StringComparison.OrdinalIgnoreCase))
            return "80mm";

        if (string.Equals(formato, "58mm", StringComparison.OrdinalIgnoreCase)
            || string.Equals(formato, "58", StringComparison.OrdinalIgnoreCase)
            || string.Equals(formato, "ticket58", StringComparison.OrdinalIgnoreCase))
            return "58mm";

        return "carta";
    }

    private static bool IsSafeReturn(string? href) =>
        !string.IsNullOrWhiteSpace(href)
        && href.StartsWith('/')
        && !href.StartsWith("//");

    private async Task PrintAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("dentalCareUi.printPage");
        }
        catch
        {
        }
    }
}
