@inject AccessControlMaintenanceService AccessService

@if (Visible && !string.IsNullOrWhiteSpace(UserId))
{
    <div class="modal-overlay" @onclick="CloseAsync">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Cambiar contraseña</h2>
                <button type="button" class="modal-close" @onclick="CloseAsync">×</button>
            </div>
            <p class="modal-confirm-text access-modal-hint">
                Nueva clave para @(string.IsNullOrWhiteSpace(DisplayName) ? "esta cuenta" : DisplayName).
                El usuario deberá usarla en el próximo inicio de sesión.
            </p>
            <div class="form-group">
                <label>Nueva contraseña</label>
                <input class="form-input" type="password" autocomplete="new-password" @bind="_password" maxlength="120" />
            </div>
            <div class="form-group">
                <label>Confirmar contraseña</label>
                <input class="form-input" type="password" autocomplete="new-password" @bind="_confirm" maxlength="120" />
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="wizard-error">@_error</div>
            }
            <div class="modal-actions">
                <button type="button" class="btn-outline" disabled="@_saving" @onclick="CloseAsync">Cancelar</button>
                <button type="button" class="btn-primary" disabled="@_saving" @onclick="SaveAsync">
                    @(_saving ? "Guardando..." : "Guardar contraseña")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string? UserId { get; set; }
    [Parameter] public string DisplayName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private string? _error;
    private bool _saving;

    protected override void OnParametersSet()
    {
        if (!Visible)
        {
            _password = string.Empty;
            _confirm = string.Empty;
            _error = null;
            _saving = false;
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId))
            return;

        _saving = true;
        _error = null;
        var (success, error) = await AccessService.SetUserPasswordAsync(UserId, _password, _confirm);
        _saving = false;
        if (!success)
        {
            _error = error;
            return;
        }

        await OnSaved.InvokeAsync();
    }
}
