@{
    var values = Data is { Count: > 0 } ? Data : null;
    var max = values?.Max() ?? 0;
    var min = values?.Min() ?? 0;
    var range = max - min;
    if (range == 0) range = 1;
    var points = new List<string>();
    if (values != null)
    {
        for (var i = 0; i < values.Count; i++)
        {
            var x = i * (100.0 / Math.Max(values.Count - 1, 1));
            var y = 32 - ((double)(values[i] - min) / (double)range * 26);
            points.Add($"{x:F1},{y:F1}");
        }
    }
    var polyline = string.Join(" ", points);
    var areaPath = $"M0,32 L{polyline} L100,32 Z";
}

@if (values != null)
{
    <svg class="sparkline @AccentClass @(Area ? "area" : "")" viewBox="0 0 100 36" preserveAspectRatio="none">
        @if (Area)
        {
            <path class="spark-area" d="@areaPath" />
        }
        <polyline points="@polyline" fill="none" stroke-width="2" />
    </svg>
}

@code {
    [Parameter] public List<decimal>? Data { get; set; }
    [Parameter] public string AccentClass { get; set; } = "accent-teal";
    [Parameter] public bool Area { get; set; }
}
