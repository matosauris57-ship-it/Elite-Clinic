<div class="kpi-card @AccentClass">
    <div class="kpi-top">
        <div class="kpi-icon-wrap">
            <Icon Name="@IconName" Class="kpi-svg" />
        </div>
        @if (!string.IsNullOrEmpty(Badge))
        {
            <span class="kpi-tag @BadgeClass">@Badge</span>
        }
    </div>
    <div class="kpi-value">@Value</div>
    <div class="kpi-label">@Label</div>
    @if (!string.IsNullOrEmpty(Trend))
    {
        <div class="kpi-trend @TrendClass">@Trend</div>
    }
    @if (ShowProgress && ProgressPercent > 0)
    {
        <div class="kpi-progress">
            <div class="kpi-progress-fill" style="width: @(ProgressPercent)%"></div>
        </div>
    }
    @if (SparklineData?.Count > 0)
    {
        <Sparkline Data="SparklineData" AccentClass="@AccentClass" Area="true" />
    }
</div>

@code {
    [Parameter] public string IconName { get; set; } = "layout-dashboard";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Trend { get; set; }
    [Parameter] public string TrendClass { get; set; } = "up";
    [Parameter] public string AccentClass { get; set; } = "accent-teal";
    [Parameter] public string? Badge { get; set; }
    [Parameter] public string BadgeClass { get; set; } = "";
    [Parameter] public bool ShowProgress { get; set; }
    [Parameter] public int ProgressPercent { get; set; }
    [Parameter] public List<decimal>? SparklineData { get; set; }
}
