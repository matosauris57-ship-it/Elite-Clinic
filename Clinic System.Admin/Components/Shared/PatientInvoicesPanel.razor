@using System.Globalization
@inject BillingMaintenanceService BillingService
@inject AuthService AuthService

<section class="record-section-card patient-invoices-panel">
    <div class="clinical-section-heading">
        <div>
            <h3>Facturas del paciente</h3>
            <p>Pendientes al frente; elija pagadas u otras para consultar e imprimir.</p>
        </div>
        <a class="btn-outline" href="@($"/facturacion?paciente={PatientId}")">Ir a facturación</a>
    </div>

    <div class="billing-kpi-grid patient-invoice-kpis">
        <div class="agenda-kpi accent-yellow">
            <span class="agenda-kpi-value">@_pendingCount</span>
            <span class="agenda-kpi-label">Pendientes / abonadas</span>
        </div>
        <div class="agenda-kpi accent-green">
            <span class="agenda-kpi-value">@FormatMoney(_pendingBalance)</span>
            <span class="agenda-kpi-label">Saldo por cobrar</span>
        </div>
        <div class="agenda-kpi accent-teal">
            <span class="agenda-kpi-value">@_paidCount</span>
            <span class="agenda-kpi-label">Pagadas</span>
        </div>
        <div class="agenda-kpi accent-purple">
            <span class="agenda-kpi-value">@_totalCountAll</span>
            <span class="agenda-kpi-label">Total facturas</span>
        </div>
    </div>

    <div class="maintenance-tabs patient-invoice-filters" role="tablist" aria-label="Estado de facturas">
        @foreach (var filter in Filters)
        {
            <button type="button" role="tab" aria-selected="@(_filter == filter.Key)"
                    class="toggle-btn @(_filter == filter.Key ? "active" : "")"
                    disabled="@_loading"
                    @onclick="() => SetFilterAsync(filter.Key)">@filter.Label</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorBanner Message="@_error" OnRetry="LoadAsync" />
    }
    else if (_loading)
    {
        <AnimatedLoader Message="Cargando facturas..." />
    }
    else if (_invoices.Count == 0)
    {
        <div class="maintenance-empty">
            <p>@EmptyMessage</p>
        </div>
    }
    else
    {
        <div class="data-table-wrap">
            <table class="data-table billing-table">
                <thead>
                    <tr>
                        <th>Factura</th>
                        <th>Fecha</th>
                        <th>Médico</th>
                        <th>Estado</th>
                        <th>Total</th>
                        <th>Abonado</th>
                        <th>Saldo</th>
                        <th class="col-actions">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in _invoices)
                    {
                        var selected = _selectedId == invoice.PaymentId;
                        <tr class="@(selected ? "is-selected" : "")" @onclick="() => Select(invoice.PaymentId)">
                            <td>#@invoice.PaymentId</td>
                            <td>@FormatDate(invoice.PaymentDate)</td>
                            <td>@invoice.DoctorName</td>
                            <td><span class="status-badge @StatusClass(invoice.PaymentStatus)">@invoice.PaymentStatusDisplay</span></td>
                            <td class="billing-amount">@invoice.AmountDisplay</td>
                            <td>@invoice.AmountCollectedDisplay</td>
                            <td>@invoice.BalanceDisplay</td>
                            <td class="col-actions" @onclick:stopPropagation="true">
                                <a class="btn-table" href="@PrintUrl(invoice.PaymentId, "detalle")" target="_blank">Imprimir</a>
                                <a class="btn-table" href="@PrintUrl(invoice.PaymentId, "detalle", "80mm")" target="_blank">Ticket</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="billing-pagination">
            <button class="btn-outline" disabled="@(_loading || _pageNumber <= 1)" @onclick="PrevPageAsync">Anterior</button>
            <span>@_totalCount factura(s) · pág. @_pageNumber/@TotalPages</span>
            <button class="btn-outline" disabled="@(_loading || _pageNumber >= TotalPages)" @onclick="NextPageAsync">Siguiente</button>
        </div>
    }

    @if (SelectedInvoice != null)
    {
        <div class="patient-invoice-selected">
            <div class="clinical-section-heading">
                <div>
                    <h4>Factura #@SelectedInvoice.PaymentId</h4>
                    <p>@SelectedInvoice.PaymentStatusDisplay · @FormatDate(SelectedInvoice.PaymentDate)</p>
                </div>
                <div class="patient-invoice-print-actions">
                    <a class="btn-outline" href="@PrintUrl(SelectedInvoice.PaymentId, "detalle")" target="_blank">Imprimir detalle</a>
                    <a class="btn-outline" href="@PrintUrl(SelectedInvoice.PaymentId, "resumen")" target="_blank">Solo total</a>
                    <a class="btn-outline" href="@PrintUrl(SelectedInvoice.PaymentId, "detalle", "80mm")" target="_blank">Ticket 80 mm</a>
                    <a class="btn-outline" href="@PrintUrl(SelectedInvoice.PaymentId, "resumen", "58mm")" target="_blank">Ticket 58 mm</a>
                </div>
            </div>
            <div class="billing-kpi-grid">
                <div class="agenda-kpi accent-purple">
                    <span class="agenda-kpi-value">@SelectedInvoice.AmountDisplay</span>
                    <span class="agenda-kpi-label">Total</span>
                </div>
                <div class="agenda-kpi accent-teal">
                    <span class="agenda-kpi-value">@SelectedInvoice.AmountCollectedDisplay</span>
                    <span class="agenda-kpi-label">Abonado</span>
                </div>
                <div class="agenda-kpi accent-yellow">
                    <span class="agenda-kpi-value">@SelectedInvoice.BalanceDisplay</span>
                    <span class="agenda-kpi-label">Saldo</span>
                </div>
            </div>
        </div>
    }
</section>

@code {
    [Parameter] public int PatientId { get; set; }

    private static readonly (string Key, string Label)[] Filters =
    [
        ("pendientes", "Pendientes"),
        ("pagadas", "Pagadas"),
        ("todas", "Todas")
    ];

    private List<PaymentListItem> _invoices = [];
    private string _filter = "pendientes";
    private int? _selectedId;
    private bool _loading = true;
    private string? _error;
    private int _loadedPatientId;
    private int _pageNumber = 1;
    private const int PageSize = 10;
    private int _totalCount;
    private int _totalPages = 1;

    private int _pendingCount;
    private int _paidCount;
    private int _totalCountAll;
    private decimal _pendingBalance;

    private int TotalPages => Math.Max(1, _totalPages);

    private PaymentListItem? SelectedInvoice =>
        _selectedId is int id ? _invoices.FirstOrDefault(x => x.PaymentId == id) : null;

    private string EmptyMessage => _filter switch
    {
        "pendientes" => "Este paciente no tiene facturas pendientes ni abonadas.",
        "pagadas" => "Este paciente no tiene facturas pagadas.",
        _ => "Este paciente no tiene facturas registradas."
    };

    protected override async Task OnParametersSetAsync()
    {
        if (PatientId <= 0 || PatientId == _loadedPatientId)
            return;

        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _loadedPatientId = PatientId;

        var filters = BuildListFilters();
        var listTask = AuthService.WithTokenRetryAsync(
            async () =>
            {
                var response = await BillingService.GetPaymentsAsync(filters);
                return (response.Page, response.Error);
            },
            AuthService.IsTokenError);

        var summaryTask = LoadSummaryAsync();
        var result = await listTask;
        await summaryTask;

        _invoices = result.Data?.Items?.ToList() ?? [];
        _error = result.Error;
        _pageNumber = result.Data?.CurrentPage > 0 ? result.Data.CurrentPage : _pageNumber;
        _totalCount = result.Data?.TotalCount ?? 0;
        _totalPages = result.Data?.TotalPages > 0 ? result.Data.TotalPages : 1;

        if (_selectedId is int id && _invoices.All(x => x.PaymentId != id))
            _selectedId = null;

        if (_selectedId is null)
            _selectedId = _invoices.FirstOrDefault()?.PaymentId;

        _loading = false;
    }

    private async Task LoadSummaryAsync()
    {
        var outstandingTask = BillingService.GetPaymentsAsync(new BillingPaymentFilters
        {
            PatientId = PatientId,
            OutstandingOnly = true,
            PageNumber = 1,
            PageSize = 100
        });
        var paidTask = BillingService.GetPaymentsAsync(new BillingPaymentFilters
        {
            PatientId = PatientId,
            Status = "Paid",
            PageNumber = 1,
            PageSize = 1
        });
        var allTask = BillingService.GetPaymentsAsync(new BillingPaymentFilters
        {
            PatientId = PatientId,
            PageNumber = 1,
            PageSize = 1
        });

        await Task.WhenAll(outstandingTask, paidTask, allTask);

        var (outstanding, _) = await outstandingTask;
        var (paid, _) = await paidTask;
        var (all, _) = await allTask;

        var outstandingItems = outstanding?.Items?.ToList() ?? [];
        _pendingCount = outstanding?.TotalCount ?? outstandingItems.Count;
        _pendingBalance = outstandingItems.Sum(x => x.Balance);
        _paidCount = paid?.TotalCount ?? 0;
        _totalCountAll = all?.TotalCount ?? 0;
    }

    private BillingPaymentFilters BuildListFilters()
    {
        var filters = new BillingPaymentFilters
        {
            PatientId = PatientId,
            PageNumber = _pageNumber,
            PageSize = PageSize
        };

        switch (_filter)
        {
            case "pendientes":
                filters.OutstandingOnly = true;
                break;
            case "pagadas":
                filters.Status = "Paid";
                break;
        }

        return filters;
    }

    private async Task SetFilterAsync(string filter)
    {
        if (_filter == filter) return;
        _filter = filter;
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task PrevPageAsync()
    {
        if (_pageNumber <= 1) return;
        _pageNumber--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_pageNumber >= TotalPages) return;
        _pageNumber++;
        await LoadAsync();
    }

    private void Select(int paymentId) => _selectedId = paymentId;

    private string PrintUrl(int paymentId, string vista, string formato = "carta")
    {
        var back = Uri.EscapeDataString($"/pacientes/{PatientId}?tab=facturas");
        return $"/facturacion/{paymentId}/imprimir?vista={vista}&formato={formato}&volver={back}";
    }

    private static string StatusClass(string? status) => status switch
    {
        "Paid" => "status-completed",
        "PartiallyPaid" => "status-planned",
        "Pending" => "status-progress",
        "Failed" => "status-cancelled",
        "Refunded" => "status-planned",
        "Cancelled" => "status-cancelled",
        _ => "status-inactive"
    };

    private static string FormatDate(string? value) =>
        DateTime.TryParse(value, out var date)
            ? date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)
            : string.IsNullOrWhiteSpace(value) ? "Sin fecha" : value;

    private static string FormatMoney(decimal value) => $"${value:N2}";
}
