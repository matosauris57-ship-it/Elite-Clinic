<div class="widget mix-widget">
    <div class="widget-head">
        <h3>Mix de Tratamientos</h3>
    </div>

    <div class="donut-wrap">
        <svg class="donut-chart" viewBox="0 0 120 120">
            @{
                var offset = 0.0;
                var circumference = 2 * Math.PI * 40;
            }
            @foreach (var slice in _slices)
            {
                var dash = slice.Percent / 100.0 * circumference;
                <circle class="donut-slice @slice.Class"
                        cx="60" cy="60" r="40"
                        stroke-dasharray="@($"{dash:F1} {circumference - dash:F1}")"
                        stroke-dashoffset="@($"{-offset:F1}")"
                        fill="none" stroke-width="18"/>
                offset -= dash;
            }
            <text x="60" y="56" text-anchor="middle" class="donut-center-label">Total</text>
            <text x="60" y="72" text-anchor="middle" class="donut-center-value">100%</text>
        </svg>

        <div class="donut-legend">
            @foreach (var slice in _slices)
            {
                <div class="legend-row">
                    <span class="legend-dot @slice.Class"></span>
                    <span class="legend-name">@slice.Name</span>
                    <span class="legend-pct">@slice.Percent%</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly List<Slice> _slices =
    [
        new("Limpieza", 28, "slice-teal"),
        new("Ortodoncia", 22, "slice-purple"),
        new("Implantes", 18, "slice-green"),
        new("Endodoncia", 14, "slice-yellow"),
        new("Blanqueamiento", 11, "slice-blue"),
        new("Otros", 7, "slice-gray")
    ];

    private record Slice(string Name, int Percent, string Class);
}
